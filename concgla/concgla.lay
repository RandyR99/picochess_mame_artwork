	<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />

		

		<!-- leds -->
			<repeat count="8">
			<param name="y" start="8" increment="9.8" />
			<param name="i1" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="1.0" increment="9.93" />
				<param name="i2" start="8" increment="-1" />
				<element name="~i2~.~i1~" ref="led1"><bounds x="~x~" y="~y~" width="1.5" height="1.5" /></element>
			</repeat>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-5" increment="9.8" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="9.8" />


			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_e"><bounds x="-2"  y="~y~" width="14" height="14" /></element>
			<element name="piece_b~i~" ref="piece_e"><bounds x="8" y="~y~" width="14" height="14" /></element>
			<element name="piece_c~i~" ref="piece_e"><bounds x="18" y="~y~" width="14" height="14" /></element>
			<element name="piece_d~i~" ref="piece_e"><bounds x="28" y="~y~" width="14" height="14" /></element>
			<element name="piece_e~i~" ref="piece_e"><bounds x="38" y="~y~" width="14" height="14" /></element>
			<element name="piece_f~i~" ref="piece_e"><bounds x="48" y="~y~" width="14" height="14" /></element>
			<element name="piece_g~i~" ref="piece_e"><bounds x="58" y="~y~" width="14" height="14" /></element>
			<element name="piece_h~i~" ref="piece_e"><bounds x="68" y="~y~" width="14" height="14" /></element>
		</repeat>
	</group>


<group name="sb_board_m">
		<bounds x="0" y="0" width="80" height="80" />

		

		<!-- leds -->
		<repeat count="8">
			<param name="y" start="9" increment="9.91" />
			<param name="i1" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="0.3" increment="10.11" />
				<param name="i2" start="8" increment="-1" />
				<element name="~i2~.~i1~" ref="led1"><bounds x="~x~" y="~y~" width="0.90" height="0.90" /></element>
			</repeat>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-5" increment="10" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="9.8" />


			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_a"><bounds x="-2.30" y="~y~" width="15" height="15" /></element>
			<element name="piece_b~i~" ref="piece_a"><bounds x="7.7"  y="~y~" width="15" height="15" /></element>
			<element name="piece_c~i~" ref="piece_a"><bounds x="17.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_d~i~" ref="piece_a"><bounds x="27.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_e~i~" ref="piece_a"><bounds x="37.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_f~i~" ref="piece_a"><bounds x="47.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_g~i~" ref="piece_a"><bounds x="57.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_h~i~" ref="piece_a"><bounds x="67.5" y="~y~" width="15" height="15" /></element>
		</repeat>
	</group>


<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

		
		

		<!-- leds -->
			<repeat count="8">
			<param name="y" start="8" increment="9.8" />
			<param name="i1" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="1.0" increment="9.93" />
				<param name="i2" start="8" increment="-1" />
				<element name="~i2~.~i1~" ref="led1"><bounds x="~x~" y="~y~" width="1.5" height="1.5" /></element>
			</repeat>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0.50" increment="9.85" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

	<element name="piece_a~i~" ref="piece_2m"><bounds x="1"  y="~y~" width="8.5" height="8.5" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="11" y="~y~" width="8.5" height="8.5" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="21" y="~y~" width="8.5" height="8.5" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="31" y="~y~" width="8.5" height="8.5" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="41" y="~y~" width="8.5" height="8.5" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="51" y="~y~" width="8.5" height="8.5" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="61" y="~y~" width="8.5" height="8.5" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="71" y="~y~" width="8.5" height="8.5" /></element>
		</repeat>	</group>

<group name="sb_board_2ma">
		<bounds x="0" y="0" width="80" height="80" />

		
		

			<!-- leds -->
	<repeat count="8">
			<param name="y" start="9" increment="9.91" />
			<param name="i1" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="0.3" increment="10.11" />
				<param name="i2" start="8" increment="-1" />
				<element name="~i2~.~i1~" ref="led1"><bounds x="~x~" y="~y~" width="0.90" height="0.90" /></element>
			</repeat>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			
			<param name="y" start="0.50" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

	        <element name="piece_a~i~" ref="piece_2m"><bounds x="0.7"  y="~y~" width="9" height="9" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10.7" y="~y~" width="9" height="9" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20.7" y="~y~" width="9" height="9" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30.7" y="~y~" width="9" height="9" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40.7" y="~y~" width="9" height="9" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50.6" y="~y~" width="9" height="9" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60.6" y="~y~" width="9" height="9" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70.6" y="~y~" width="9" height="9" /></element>
		</repeat>	</group>

<!-- sb ui -->

<!-- sb ui -->

<element name="cwhite_m"><rect><color red="0.9" green="0.9" blue="0.9" /></rect></element>
	<element name="cblack_m"><rect><color red="0.4" green="0.4" blue="0.4" /></rect></element>


<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>


	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uit1"><text string="S.BOARD"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uit2"><text string="INTERFACE"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib1"><text string="BOARD:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib2">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="RESET"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uib3">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="CLEAR"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uis1"><text string="SPAWN"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih1"><text string="HAND::"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih2">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="REMOVE"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu1"><text string="UNDO:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu2a">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &lt;&lt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2b">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &lt;  "><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2c">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="   &gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2d">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &gt;&gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
