<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->

<element name="board">
		<image file="royal7.png" />
	</element>


<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

<element name="led" defstate="0">
        <image file="../leds/grey1.png" state="0"/>
		<image file="../leds/red_sel.png" state="1"/>

</element>

	<element name="button1" defstate="0">
        <image file="button3_sel.png" state="1"/>
	<image file="button3.png" state="0"/>	
</element>

	<element name="button2" defstate="0">
        <image file="button4_sel.png" state="1"/>
	<image file="button4.png" state="0"/>	
</element>



<!-- sb board -->

	<element name="cblack"><rect><color red="0.41" green="0.4" blue="0.39" /></rect></element>
	<element name="cwhite"><rect><color red="0.81" green="0.8" blue="0.79" /></rect></element>

	<element name="hlbb" defstate="0">
	
	</element>

	<element name="piece" defstate="0">
		<image file="../pieces/pmephisto2/wp.png" state="1"/>
		<image file="../pieces/pmephisto2/wkn.png" state="2"/>
        <image file="../pieces/pmephisto2/wb.png" state="3"/>
		<image file="../pieces/pmephisto2/wr.png" state="4"/>
