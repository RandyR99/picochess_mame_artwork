<?xml version="1.0"?>
<mamelayout version="2">

<!-- photos: tibono -->

<element name="yeno">
		<image file="y416xl.png" />
	</element>



<element name="sbui_png">
		<image file="../varios/clipboard09b.png" />
	</element>

<element name="hlbb" defstate="0">
	</element>

	<element name="hlb2" defstate="0">
		<rect><color alpha="0" /></rect> <!-- force unit square element bounds -->
		<disk state="1">
			<bounds xc="0.5" yc="0.5" width="0.85" height="0.85" />
			<color red="0.17" green="0.17" blue="0.175" />
		</disk>
	</element>

		  	<element name="ledr" defstate="0">
		<image file="../leds/red_sel.png" state="1"/>
	    <image file="../leds/red.png" state="0"/>
</element>

	<element name="ledg" defstate="0">
		<rect state="1"><color red="0.1" green="1.0" blue="0.15" /></rect>
		<rect state="0"><color red="0.1" green="1.0" blue="0.15" alpha="0.13" /></rect>
	</element>

   <element name="bt" defstate="0">
	<image file="../botones/down1_sel.png" state="1"/>
        </element>

   <element name="bt1" defstate="0">
	<image file="../botones/down_sel12.png" state="1"/>
        </element>

