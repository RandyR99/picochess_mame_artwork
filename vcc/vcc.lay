<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

<element name="fidelity">
		<image file="vcc.jpg" />
	</element>



	<element name="static_gray"><rect><color red="0.6" green="0.6" blue="0.6" /></rect></element>

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="led" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		
	</element>

<element name="hl" defstate="0">
		<text string=" "/>
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>




<!-- build screen -->

		<view name="artwork by luis">
		<bounds left="0" right="1509" top="0" bottom="888" />



	<element ref="fidelity">
		
			<bounds x="0" y="0" width="1509" height="888" />
		</element>
		
		

	<!-- 7segs/leds -->

		
		<element name="1.7" ref="led"><bounds x="1156" y="349" width="10" height="10" /></element>
		<element name="0.7" ref="led"><bounds x="1154" y="382" width="10" height="10" /></element>

		

		<element name="digit0" ref="digit"><bounds x="1039" y="339" width="50" height="62" /></element>
		<element name="digit1" ref="digit"><bounds x="1099" y="339" width="50" height="62" /></element>
		<element name="digit2" ref="digit"><bounds x="1170" y="339" width="50" height="62" /></element>
		<element name="digit3" ref="digit"><bounds x="1230" y="339" width="50" height="62" /></element>

	<!-- button panel -->

	

	    <element ref="hl" inputtag="RESET" inputmask="0x01"><bounds x="1013" y="460" width="65" height="40" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x01"><bounds x="1083" y="460" width="65" height="40" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x01"><bounds x="1152" y="460" width="65" height="40" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x01"><bounds x="1221" y="460" width="65" height="40" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x02"><bounds x="1017" y="522" width="64" height="42" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x02"><bounds x="1089" y="522" width="64" height="42" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x02"><bounds x="1160" y="522" width="64" height="42" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x02"><bounds x="1230" y="522" width="64" height="42" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x04"><bounds x="1021" y="587" width="65" height="42" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x04"><bounds x="1093" y="587" width="65" height="42" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x04"><bounds x="1165" y="587" width="65" height="42" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x04"><bounds x="1236" y="587" width="65" height="42" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x08"><bounds x="1024" y="653" width="66" height="45" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x08"><bounds x="1099" y="653" width="66" height="45" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x08"><bounds x="1171" y="653" width="66" height="45" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x08"><bounds x="1243" y="653" width="66" height="45" /><color alpha="0.40" /></element>

	</view>
</mamelayout>
