<?xml version="1.0"?>
<!--
license:cc0
-->
<mamelayout version="2">

<element name="savant">
		<image file="savant4.png" />
	</element>

<element name="fondo">
		<image file="../varios/fondo4.png" />
	</element>


<!-- define elements -->

	<element name="gray"><rect><color red="0.7" green="0.7" blue="0.74" /></rect></element>
	<element name="gray2"><rect><color red="0.8" green="0.8" blue="0.85" /></rect></element>
	<element name="black"><rect><color red="0.12" green="0.12" blue="0.13" /></rect></element>
	<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>
	<element name="whiteb"><rect><color red="1" green="1" blue="1" /></rect></element>

	<element name="cb_green"><rect><color red="0.3" green="0.8" blue="0.75" /></rect></element>
	<element name="cb_light" defstate="1">
		<rect state="0"><color red="0.33" green="0.3" blue="0.15" /></rect>
		<rect state="1"><color red="1.0" green="0.79" blue="0.38" /></rect>
	</element>

	<element name="nothing" defstate="0">
		<text string=" "/>
	</element>

	<element name="hl" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1.0034" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.1217" width="0.76" height="0.7634" />
			<color red="0" green="0" blue="0" />
		</disk>
	</element>

<element name="but" defstate="0">
	  
      <image file="../botones/down_sel4.png" state="1"/>
	</element>

	


<!-- groups -->

	<group name="display">
		<bounds x="0" y="0" width="101" height="114" />
		<screen index="0"><bounds x="0.5" y="0.5" width="100" height="112.735" /></screen>

		<!-- squares -->
		<repeat count="4">
			<param name="y" start="10" increment="23.56" />
			<repeat count="4">
				<param name="x" start="14.84" increment="23.48" />
				<element ref="cb_green" blend="multiply"><bounds x="~x~" y="~y~" width="11.74" height="11.78" /></element>
			</repeat>
		</repeat>
		<repeat count="4">
			<param name="y" start="21.78" increment="23.56" />
			<repeat count="4">
				<param name="x" start="3.1" increment="23.48" />
				<element ref="cb_green" blend="multiply"><bounds x="~x~" y="~y~" width="11.74" height="11.78" /></element>
			</repeat>
		</repeat>

		<!-- sensors -->
		<repeat count="8">
			<param name="y" start="10" increment="11.78" />
			<param name="i" start="8" increment="-1" />
			<repeat count="8">
				<param name="x" start="3.1" increment="11.74" />
				<param name="mask" start="0x01" lshift="1" />
				<element ref="hl" inputtag="board:RANK.~i~" inputmask="~mask~"><bounds x="~x~" y="~y~" width="11.74" height="11.78" /><color alpha="0.08" /></element>
			</repeat>
		</repeat>

		<!-- backlight -->
		<element ref="nothing" blend="add" inputtag="light" inputmask="0x00" inputraw="1"><bounds x="0" y="0" width="101" height="114" /></element>
		<element ref="cb_light" blend="multiply" inputtag="light" inputmask="0x01" inputraw="1"><bounds x="0" y="0" width="101" height="114" /></element>

		<!-- mask edges -->
		<element ref="blackb"><bounds x="0" y="0" width="101" height="2" /></element>
		<element ref="blackb"><bounds x="0" y="8.2" width="101" height="1" /></element>
		<element ref="blackb"><bounds x="0" y="104.9" width="101" height="1" /></element>
		<element ref="blackb"><bounds x="0" y="111.7" width="101" height="2" /></element>

		<element ref="blackb"><bounds x="0" y="0" width="1.5" height="114" /></element>
		<element ref="blackb"><bounds x="98.7" y="0" width="2" height="114" /></element>
	</group>




<!-- build screen -->

	<view name="artwork by luis">
	<bounds left="-10" right="1520" top="-10" bottom="1049" />
	
	<element ref="fondo">
			<bounds x="-10" y="-10" width="1530" height="70" />
		</element>
	
<element ref="fondo">
			<bounds x="-10" y="1020" width="1530" height="60" />
		</element>
	
	<element ref="fondo">
			<bounds x="-10" y="-10" width="50" height="1050" />
		</element>

<element ref="fondo">
			<bounds x="1420" y="-10" width="110" height="1050" />
		</element>
	
	
		<element ref="savant">
			<bounds x="0" y="0" width="1510" height="1039"/>
		</element>
		
		
		<group ref="display"><bounds x="308" y="432" width="406" height="443" /></group>

	
		
		
		<element ref="but" inputtag="IN.2" inputmask="0x08"><bounds x="835"  y="535" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x08"><bounds x="930"  y="535" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x08"><bounds x="1028" y="535" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x80"><bounds x="1122" y="535" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x80"><bounds x="1219" y="535" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.2" inputmask="0x80"><bounds x="1311" y="535" width="58" height="27" /></element>

		<!-- button row 2 -->
		

		

		

		
		<element ref="but" inputtag="IN.2" inputmask="0x04"><bounds x="837"  y="611" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x04"><bounds x="934"  y="611" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x04"><bounds x="1029" y="611" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x40"><bounds x="1124" y="611" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x40"><bounds x="1219" y="611" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.2" inputmask="0x40"><bounds x="1313" y="611" width="58" height="27" /></element>

		<!-- button row 3 -->
		

		<element ref="but" inputtag="IN.2" inputmask="0x02"><bounds x="840"  y="687" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x02"><bounds x="936"  y="686" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x02"><bounds x="1033" y="686" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x20"><bounds x="1129" y="686" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x20"><bounds x="1223" y="686" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.2" inputmask="0x20"><bounds x="1317" y="686" width="58" height="27" /></element>

		<!-- button row 4 -->
		

		<element ref="but" inputtag="IN.2" inputmask="0x01"><bounds x="842"  y="764" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x01"><bounds x="939" y="764" width="58"  height="27" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x01"><bounds x="1035" y="764" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x10"><bounds x="1131" y="764" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x10"><bounds x="1227" y="764" width="58" height="27" /></element>
		<element ref="but" inputtag="IN.2" inputmask="0x10"><bounds x="1321" y="764" width="58" height="27" /></element>
	</view>                                                                                                     
                                                                                                                
	<view name="internal layout (screen)">
		<bounds left="1.5" right="98.7" top="2" bottom="111.7" />
		<group ref="display"><bounds x="0" y="0" width="101" height="114" /></group>
	</view>

</mamelayout>
