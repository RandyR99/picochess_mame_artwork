license:CC0-1.0
-->
<mamelayout version="2">



<!-- define elements -->

<element name="mephisto">
		<image file="montreal3a.png" />
	</element>

<element name="mephisto_3d">
		<image file="montreal_3d5.png" />
	</element>


<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>
	

	<element name="hlbb" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk>
	</element>

<element name="nothing" defstate="0">
		<rect><color alpha="0" /></rect>
	</element>

<element name="led" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	<image file="../leds/grey.png" state="0"/>
</element>


<element name="piece" defstate="0">
		<image file="../pieces/pmephisto5/wp.png" state="1"/>
		<image file="../pieces/pmephisto5/wkn.png" state="2"/>
		<image file="../pieces/pmephisto5/wb.png" state="3"/>
		<image file="../pieces/pmephisto5/wr.png" state="4"/>
		<image file="../pieces/pmephisto5/wq.png" state="5"/>
		<image file="../pieces/pmephisto5/wk.png" state="6"/>
		<image file="../pieces/pmephisto5/bp.png" state="7"/>
		<image file="../pieces/pmephisto5/bkn.png" state="8"/>
		<image file="../pieces/pmephisto5/bb.png" state="9"/>
		<image file="../pieces/pmephisto5/br.png" state="10"/>
		<image file="../pieces/pmephisto5/bq.png" state="11"/>
		<image file="../pieces/pmephisto5/bk.png" state="12"/>
		<image file="../pieces/pmephisto5/wp_sel.png" state="13"/>
		<image file="../pieces/pmephisto5/wkn_sel.png" state="14"/>
		<image file="../pieces/pmephisto5/wb_sel.png" state="15"/>
		<image file="../pieces/pmephisto5/wr_sel.png" state="16"/>
		<image file="../pieces/pmephisto5/wq_sel.png" state="17"/>
		<image file="../pieces/pmephisto5/wk_sel.png" state="18"/>
		<image file="../pieces/pmephisto5/bp_sel.png" state="19"/>
		<image file="../pieces/pmephisto5/bkn_sel.png" state="20"/>
		<image file="../pieces/pmephisto5/bb_sel.png" state="21"/>
		<image file="../pieces/pmephisto5/br_sel.png" state="22"/>
		<image file="../pieces/pmephisto5/bq_sel.png" state="23"/>
		<image file="../pieces/pmephisto5/bk_sel.png" state="24"/>
	</element>

<element name="piece_2m" defstate="0">
		<image file="../pieces/chess2/wp.png" state="1"/>
		<image file="../pieces/chess2/wn.png" state="2"/>
		<image file="../pieces/chess2/wb.png" state="3"/>
		<image file="../pieces/chess2/wr.png" state="4"/>
		<image file="../pieces/chess2/wq.png" state="5"/>
		<image file="../pieces/chess2/wk.png" state="6"/>

		<image file="../pieces/chess2/bp.png" state="7"/>
		<image file="../pieces/chess2/bn.png" state="8"/>
		<image file="../pieces/chess2/bb.png" state="9"/>
		<image file="../pieces/chess2/br.png" state="10"/>
		<image file="../pieces/chess2/bq.png" state="11"/>
		<image file="../pieces/chess2/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../pieces/chess2/wp_sel.png" state="13"></image>
		<image file="../pieces/chess2/wn_sel.png" state="14"></image>
		<image file="../pieces/chess2/wb_sel.png" state="15"></image>
		<image file="../pieces/chess2/wr_sel.png" state="16"></image>
		<image file="../pieces/chess2/wq_sel.png" state="17"></image>
		<image file="../pieces/chess2/wk_sel.png" state="18"></image>

		<image file="../pieces/chess2/bp_sel.png" state="19"></image>
		<image file="../pieces/chess2/bn_sel.png" state="20"></image>
		<image file="../pieces/chess2/bb_sel.png" state="21"></image>
		<image file="../pieces/chess2/br_sel.png" state="22"></image>
		<image file="../pieces/chess2/bq_sel.png" state="23"></image>
		<image file="../pieces/chess2/bk_sel.png" state="24"></image>
	</element>





<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />



		<!-- chessboard leds -->
		<repeat count="8">
			<param name="x" start="8.3" increment="10" />
			<param name="la" start="0" increment="1" />
			<param name="lb" start="8" increment="1" />
			<param name="lc" start="16" increment="1" />
			<param name="ld" start="24" increment="1" />
			<param name="le" start="32" increment="1" />
			<param name="lf" start="40" increment="1" />
			<param name="lg" start="48" increment="1" />
			<param name="lh" start="56" increment="1" />

			<element name="led~la~" ref="led"><bounds x="~x~" y="78.3" width="1.2" height="1.2" /></element>
			<element name="led~lb~" ref="led"><bounds x="~x~" y="68.3" width="1.2" height="1.2" /></element>
			<element name="led~lc~" ref="led"><bounds x="~x~" y="58.3" width="1.2" height="1.2" /></element>
			<element name="led~ld~" ref="led"><bounds x="~x~" y="48.3" width="1.2" height="1.2" /></element>
			<element name="led~le~" ref="led"><bounds x="~x~" y="38.3" width="1.2" height="1.2" /></element>
			<element name="led~lf~" ref="led"><bounds x="~x~" y="28.3" width="1.2" height="1.2" /></element>
			<element name="led~lg~" ref="led"><bounds x="~x~" y="18.3" width="1.2" height="1.2" /></element>
			<element name="led~lh~" ref="led"><bounds x="~x~" y="8.3"  width="1.2" height="1.2" /></element>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-6.5" increment="10" />
			<param name="i" start="8" increment="-1" />
            <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece"><bounds x="-2" y="~y~" width="14" height="16" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="8"   y="~y~" width="14" height="16" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="18"  y="~y~" width="14" height="16" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="28"  y="~y~" width="14" height="16" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="38"  y="~y~" width="14" height="16" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="48"  y="~y~" width="14" height="16" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="58"  y="~y~" width="14" height="16" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="68"  y="~y~" width="14" height="16" /></element>
		</repeat>
	</group>

<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

		

		<!-- chessboard leds -->
		<repeat count="8">
			<param name="x" start="8.3" increment="10" />
			<param name="la" start="0" increment="1" />
			<param name="lb" start="8" increment="1" />
			<param name="lc" start="16" increment="1" />
			<param name="ld" start="24" increment="1" />
			<param name="le" start="32" increment="1" />
			<param name="lf" start="40" increment="1" />
			<param name="lg" start="48" increment="1" />
			<param name="lh" start="56" increment="1" />

			<element name="led~la~" ref="led"><bounds x="~x~" y="78.3" width="1.5" height="1.5" /></element>
			<element name="led~lb~" ref="led"><bounds x="~x~" y="68.3" width="1.5" height="1.5" /></element>
			<element name="led~lc~" ref="led"><bounds x="~x~" y="58.3" width="1.5" height="1.5" /></element>
			<element name="led~ld~" ref="led"><bounds x="~x~" y="48.3" width="1.5" height="1.5" /></element>
			<element name="led~le~" ref="led"><bounds x="~x~" y="38.3" width="1.5" height="1.5" /></element>
			<element name="led~lf~" ref="led"><bounds x="~x~" y="28.3" width="1.5" height="1.5" /></element>
			<element name="led~lg~" ref="led"><bounds x="~x~" y="18.3" width="1.5" height="1.5" /></element>
			<element name="led~lh~" ref="led"><bounds x="~x~" y="8.3" width="1.5" height="1.5" /></element>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="0"  y="~y~" width="10" height="10" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10" y="~y~" width="10" height="10" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20" y="~y~" width="10" height="10" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30" y="~y~" width="10" height="10" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40" y="~y~" width="10" height="10" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50" y="~y~" width="10" height="10" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60" y="~y~" width="10" height="10" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70" y="~y~" width="10" height="10" /></element>
		</repeat>
	</group>




	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>




	<group name="sb_ui"><bounds x="0" y="0" width="10" height="80" />
		

		<!-- board -->
		

		<element ref="hlub" inputtag="board:board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>		

		<!-- spawn -->
		

		<element name="piece_ui1" ref="piece_2m"><bounds x="1.4" y="23"    width="3.7" height="3.8" /></element>
		<element name="piece_ui2" ref="piece_2m"><bounds x="1.4" y="27"    width="3.7" height="3.8" /></element>
		<element name="piece_ui3" ref="piece_2m"><bounds x="1.4" y="31"    width="3.7" height="3.8" /></element>
		<element name="piece_ui4" ref="piece_2m"><bounds x="4.8" y="23"    width="3.7" height="3.8" /></element>
		<element name="piece_ui5" ref="piece_2m"><bounds x="4.8" y="27"    width="3.7" height="3.8" /></element>
		<element name="piece_ui6" ref="piece_2m"><bounds x="4.8" y="31"    width="3.7" height="3.8" /></element>
		<element name="piece_ui7" ref="piece_2m"><bounds x="1.4" y="36"    width="3.7" height="3.8" /></element>
		<element name="piece_ui8" ref="piece_2m"><bounds x="1.4" y="40"    width="3.7" height="3.8" /></element>
		<element name="piece_ui9" ref="piece_2m"><bounds x="1.4" y="43.7"  width="3.7" height="3.8" /></element>
		<element name="piece_ui10" ref="piece_2m"><bounds x="4.8" y="36"   width="3.7" height="3.8" /></element>
		<element name="piece_ui11" ref="piece_2m"><bounds x="4.8" y="40"   width="3.7" height="3.8" /></element>
		<element name="piece_ui12" ref="piece_2m"><bounds x="4.8" y="43.7" width="3.7" height="3.8" /></element>

		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0001"><bounds x="1" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0002"><bounds x="1" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0004"><bounds x="1" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0008"><bounds x="5" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0010"><bounds x="5" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0020"><bounds x="5" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0040"><bounds x="1" y="36" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0080"><bounds x="1" y="40" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0100"><bounds x="1" y="44" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0200"><bounds x="5" y="36" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0400"><bounds x="5" y="40" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0800"><bounds x="5" y="44" width="4" height="4" /><color alpha="0.25" /></element>

		<!-- hand -->
		
		<element name="piece_ui0" ref="piece_2m"><bounds x="2" y="52.8" width="6" height="6" /></element>

		<element ref="hlub" inputtag="board:board:UI" inputmask="0x08"><bounds x="1.8" y="59.2" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- undo -->

		<element ref="hlub" inputtag="board:board:UI" inputmask="0x10"><bounds x="1.3" y="67.65" width="2" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x20"><bounds x="3.1" y="67.65" width="1.7" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x40"><bounds x="5.2" y="67.65" width="1.7" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x80"><bounds x="6.9" y="67.65" width="2" height="2" /><color alpha="0.25" /></element>

		<element name="count_ui0" ref="text_uiu3a"><bounds x="0" y="71" width="4" height="2" /></element>
		<element name="count_ui1" ref="text_uiu3c"><bounds x="6" y="71" width="4" height="2" /></element>
		<element ref="text_uiu3b"><bounds x="4" y="71" width="2" height="2" /></element>
	</group>
	
	<!-- display -->

	<element name="lcd_bg"><rect><color red="0.765" green="0.78" blue="0.68" /></rect></element>
	<element name="ldot_hide"><disk><color red="0.54" green="0.57" blue="0.58" /></disk></element>

	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>
	<element name="ldot">
		<rect><color red="0.49412" green="0.51765" blue="0.51765" /></rect>
		<rect statemask="0x80"><color red="0.2" green="0.16" blue="0.16" /></rect>
	</element>

	<group name="display">
		<bounds x="31" y="90.3" width="22.5" height="7.4" />

		<element ref="lcd_bg"><bounds x="31" y="90.3" width="22.5" height="7.4" /></element>

		<element name="digit3" ref="digit"><bounds x="32.6" y="91" width="4" height="6" /></element>
		<element name="digit2" ref="digit"><bounds x="37.7" y="91" width="4" height="6" /></element>
		<element name="digit1" ref="digit"><bounds x="42.8" y="91" width="4" height="6" /></element>
		<element name="digit0" ref="digit"><bounds x="47.9" y="91" width="4" height="6" /></element>

		<!-- digits DP are different from normal 7seg -->
		<element ref="ldot_hide"><bounds x="35.9" y="96.3" width="0.85" height="0.85" /></element>
		<element ref="ldot_hide"><bounds x="41.0" y="96.3" width="0.85" height="0.85" /></element>
		<element ref="ldot_hide"><bounds x="46.1" y="96.3" width="0.85" height="0.85" /></element>
		<element ref="ldot_hide"><bounds x="51.2" y="96.3" width="0.85" height="0.85" /></element>

		<element name="digit3" ref="ldot"><bounds x="36.59" y="96.42" width="0.6" height="0.6" /></element>
		<element name="digit2" ref="ldot"><bounds x="41.69" y="96.42" width="0.6" height="0.6" /></element>
		<element name="digit1" ref="ldot"><bounds x="46.79" y="96.42" width="0.6" height="0.6" /></element>

		<element name="digit0" ref="ldot"><bounds x="42.06" y="92.30" width="0.6" height="0.6" /></element>
		<element name="digit0" ref="ldot"><bounds x="41.80" y="95.12" width="0.6" height="0.6" /></element>
	</group>
	
	
	<!-- buttons -->

	<element name="gray"><rect><color red="0.25" green="0.25" blue="0.25" /></rect></element>
	<element name="white"><rect><color red="0.95" green="0.95" blue="0.95" /></rect></element>

	<element name="blackw">
		<rect><bounds x="0" y="0" width="1" height="1" /><color red="0.95" green="0.95" blue="0.95" /></rect>
		<rect><bounds x="0.15" y="0.15" width="0.7" height="0.7" /><color red="0.25" green="0.25" blue="0.25" /></rect>
	</element>

	<element name="keys" defstate="0">
		<rect state="1"><color red="0.0" green="0.0" blue="0.0" /></rect>
	</element>

	<element name="text_info"><rect><color red="0.25" green="0.25" blue="0.25" /></rect><text string=" INFO"><color red="0.95" green="0.95" blue="0.95" /></text></element>
	<element name="text_pos"> <rect><color red="0.25" green="0.25" blue="0.25" /></rect><text string="POS">  <color red="0.95" green="0.95" blue="0.95" /></text></element>
