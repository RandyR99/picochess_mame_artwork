	</element>
<!-- foto: mythbuster -->

<element name="led" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	<image file="../leds/grey.png" state="0"/>
</element>

	<element name="led_e" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	<image file="../leds/red4.png" state="0"/>
</element>

			<element name="lcd_bg"><rect><color red="0.639" green="0.643" blue="0.596" /></rect></element>
	<element name="ldot_hide"><disk><color red="0.54" green="0.57" blue="0.58" /></disk></element>

	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>
	<element name="ldot">
		<rect><color red="0.49412" green="0.51765" blue="0.51765" /></rect>
		<rect statemask="0x80"><color red="0.2" green="0.16" blue="0.16" /></rect>
	</element>

	<element name="hlb" defstate="0">
	</element>

		<element name="hlbb_e" defstate="0">
	</element>


	<element name="piece_m" defstate="0">
