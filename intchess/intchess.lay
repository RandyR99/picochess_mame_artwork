<view name="artwork by luis">
<bounds left="0" right="2037" top="0" bottom="1637" />

	
	
	
	<element ref="intchess">
			<bounds left="0" right="2037" top="0" bottom="1637" />
		</element>
	
	
	
	
	<!-- display -->
<screen index="0"><bounds x="658" y="44" width="713.5" height="647.7" /></screen>
		

