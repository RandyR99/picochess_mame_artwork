		<element name="count_ui0" ref="text_uiu3a"><bounds x="0" y="71" width="4" height="2" /></element>
		<element name="count_ui1" ref="text_uiu3c"><bounds x="6" y="71" width="4" height="2" /></element>
		<element ref="text_uiu3b"><bounds x="4" y="71" width="2" height="2" /></element>
	</group>

