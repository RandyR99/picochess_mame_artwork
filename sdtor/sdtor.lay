	<element name="mm" defstate="0">
        <image file="button3_sel.png" state="1"/>
	<image file="button3.png" state="0"/>	
</element>



<element name="tb" defstate="0">
        <image file="tb_sel.png" state="1"/>
		
</element>

	<element name="move" defstate="0">
        <image file="move_sel.png" state="1"/>
		
</element>

	

	


<!-- sb board -->

	<element name="cblack"><rect><color red="0.41" green="0.4" blue="0.39" /></rect></element>
	<element name="cwhite"><rect><color red="0.81" green="0.8" blue="0.79" /></rect></element>

	<element name="hlbb" defstate="0">
	
	</element>

	<element name="piece" defstate="0">
		<image file="../pieces/pmephisto2/wp.png" state="1"/>
		<image file="../pieces/pmephisto2/wkn.png" state="2"/>
		<image file="../pieces/pmephisto2/wb.png" state="3"/>
