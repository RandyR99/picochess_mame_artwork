<element name="piece_l" defstate="0">
		<image file="../pieces/pmephisto2/wp.png" state="1"/>
		<image file="../pieces/pmephisto2/wkn.png" state="2"/>
		<image file="../pieces/pmephisto2/wb.png" state="3"/>
		<image file="../pieces/pmephisto2/wr.png" state="4"/>
		<image file="../pieces/pmephisto2/wq.png" state="5"/>
		<image file="../pieces/pmephisto2/wk.png" state="6"/>
		<image file="../pieces/pmephisto2/bp.png" state="7"/>
		<image file="../pieces/pmephisto2/bkn.png" state="8"/>
		<image file="../pieces/pmephisto2/bb.png" state="9"/>
		<image file="../pieces/pmephisto2/br.png" state="10"/>
		<image file="../pieces/pmephisto2/bq.png" state="11"/>
