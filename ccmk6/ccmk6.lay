	<element name="text_p2"><image file="chess/wq.png"><color alpha="0.83" /></image></element>
	<element name="text_p3"><image file="chess/wr.png"><color alpha="0.83" /></image></element>
	<element name="text_p4"><image file="chess/wb.png"><color alpha="0.83" /></image></element>
	<element name="text_p5"><image file="chess/wn.png"><color alpha="0.83" /></image></element>
	<element name="text_p6"><image file="chess/wp.png"><color alpha="0.83" /></image></element>

	<element name="text_b01e" defstate="0"><text state="0" string="ce"><color red="0.6" green="0.6" blue="0.59" /></text></element>
	<element name="text_b02e" defstate="0"><text state="0" string="mode"><color red="0.6" green="0.6" blue="0.59" /></text></element>
	<element name="text_b03e" defstate="0"><text state="0" string="start"><color red="0.6" green="0.6" blue="0.59" /></text></element>
