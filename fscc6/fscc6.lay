	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="cl" defstate="0">
	<image file="cl.png" state="0"/>
<image file="cl_sel.png" state="1"/>

	</element>

	<element name="dm" defstate="0">
	<image file="dm.png" state="0"/>
<image file="dm_sel.png" state="1"/>

