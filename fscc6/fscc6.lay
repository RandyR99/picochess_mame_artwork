		<image file="../pieces/pnovag_plastic/br.png" state="10"/>
		<image file="../pieces/pnovag_plastic/bq.png" state="11"/>
		<image file="../pieces/pnovag_plastic/bk.png" state="12"/>
		<image file="../pieces/pnovag_plastic/wp_sel.png" state="13"/>
		<image file="../pieces/pnovag_plastic/wkn_sel.png" state="14"/>
		<image file="../pieces/pnovag_plastic/wb_sel.png" state="15"/>
		<image file="../pieces/pnovag_plastic/wr_sel.png" state="16"/>
		<image file="../pieces/pnovag_plastic/wq_sel.png" state="17"/>
