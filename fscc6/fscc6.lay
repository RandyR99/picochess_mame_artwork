	</element>

<element name="background">
		<image file="../misc/background4.png" />
	</element>

<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

			<element name="piece" defstate="0">
	
		<image file="../pieces/pfidelity_plastic/wp.png" state="1"/>
		<image file="../pieces/pfidelity_plastic/wkn.png" state="2"/>
        <image file="../pieces/pfidelity_plastic/wb.png" state="3"/>
