<mamelayout version="2">

<!-- define elements -->

     <element name="novag">
		<image file="supernova3f.png" />
	</element>




<element name="background">
		<image file="../misc/background4.png" />
	</element>

<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

<element name="hlbb" defstate="0">
	</element>

<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

<element name="digit_led" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.1" green="0.01" blue="0.015" /></disk>
	</element>

<element name="led" defstate="0">
	<image file="../leds/green.png" state="0"/>
	<image file="../leds/green_sel.png" state="1"/>
	</element>



<element name="hl" defstate="0">

	
	</element>

<element name="lcdm"><rect><color red="0.7" green="0.71" blue="0.72" /></rect></element>


<element name="hlb" defstate="0">
<image file="../buttons/down_sel.png" state="1"/>
	</element>

<element name="h2b" defstate="0">
<image file="../buttons/but4.png" state="0"/>
<image file="../buttons/but4_sel.png" state="1"/>
	</element>

<element name="h2b_a" defstate="0">
<image file="../buttons/but4_yellow.png" state="0"/>
<image file="../buttons/but4_yellow_sel.png" state="1"/>
	</element>
	
	
	


