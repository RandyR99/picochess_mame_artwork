	<element name="hl" defstate="0">
		<text string=" "/>
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

<element name="led" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>

</element>

	<element name="but" defstate="0">
    <image file="but1a.png" state="0"/>
    <image file="but1a_sel.png" state="1"/>
	</element>
	
