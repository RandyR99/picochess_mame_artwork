	<element name="cwhite"><rect><color red="0.84" green="0.75" blue="0.50" /></rect></element>

	<element name="hlbb" defstate="0">
	</element>

	<group name="sb_board_m">
		<bounds x="0" y="0" width="80" height="80" />

		


		<!-- sensors, pieces -->
		<repeat count="8">
			
			<param name="y" start="-5" increment="10" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>



			<element name="piece_a~i~" ref="piece_m"><bounds x="-2.2" y="~y~" width="15" height="15" /></element>
			<element name="piece_b~i~" ref="piece_m"><bounds x="7.8" y="~y~"  width="15" height="15" /></element>
			<element name="piece_c~i~" ref="piece_m"><bounds x="17.8" y="~y~" width="15" height="15" /></element>
			<element name="piece_d~i~" ref="piece_m"><bounds x="27.8" y="~y~"   width="15" height="15" /></element>
			<element name="piece_e~i~" ref="piece_m"><bounds x="37.8" y="~y~" width="15" height="15" /></element>
			<element name="piece_f~i~" ref="piece_m"><bounds x="47.8" y="~y~" width="15" height="15" /></element>
			<element name="piece_g~i~" ref="piece_m"><bounds x="57.8" y="~y~" width="15" height="15" /></element>
			<element name="piece_h~i~" ref="piece_m"><bounds x="67.8" y="~y~" width="15" height="15" /></element>
		</repeat>
	</group>

<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

		
		<!-- leds -->
		

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0.8" increment="10" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>



			<element name="piece_a~i~" ref="piece_2m"><bounds x="1" y="~y~"  width="9" height="9" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="11" y="~y~" width="9" height="9" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="21" y="~y~" width="9" height="9" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="31" y="~y~" width="9" height="9" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40.8" y="~y~" width="9" height="9" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50.7" y="~y~" width="9" height="9" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60.7" y="~y~" width="9" height="9" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70.7" y="~y~" width="9" height="9" /></element>
		</repeat>
	</group>


<!-- sb ui -->

	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui">
