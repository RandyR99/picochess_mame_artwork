	</element>


		<element name="lcd_bg"><rect><color red="0.800" green="0.816" blue="0.710" /></rect></element>
	<element name="ldot_hide"><disk><color red="0.800" green="0.816" blue="0.710" /></disk></element>

	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>
	<element name="ldot">
		<rect><color red="0.539" green="0.51765" blue="0.51765" /></rect>
		<rect statemask="0x80"><color red="0.2" green="0.16" blue="0.16" /></rect>
	</element>

<element name="led" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	    <image file="../leds/grey4.png" state="0"/>
</element>

<element name="led1" defstate="0">
	<image file="../leds/red4_sel.png" state="1"/>
	<image file="../leds/red4.png" state="0"/>
</element>


	<element name="led_v" defstate="0">
