<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->

	<element name="tablero">
		<image file="mirage.png" />
	</element>

<element name="logo">
		<image file="logo.png" />
	</element>




<element name="fondo">
		<image file="../varios/fondo4.png" />
	</element>

<element name="sbui_png">
		<image file="../varios/clipboard09b.png" />
	</element>

<element name="boton" defstate="0">
		
	<image file="../botones/down_sel1.png" state="1"/>
	</element>

	<element name="mpos" defstate="0">
		<rect>
			<bounds x="0" y="0" width="4096" height="1" />
			<color alpha="0" />
		</rect>
		<disk>
			<bounds state="0" x="0" y="0" width="12.5" height="1" />
			<bounds state="3248" x="3248" y="0" width="12.5" height="1" />
			<color red="1.0" green="0.2" blue="0.8" />
		</disk>
	</element>

<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>

<element name="black"><rect><color red="0.17" green="0.15" blue="0.15" /></rect></element>

	<element name="redb"><rect><color red="0.81" green="0.3" blue="0.29" /></rect></element>
	<element name="disk_black"><disk><color red="0.17" green="0.15" blue="0.15" /></disk></element>
	<element name="disk_white"><disk><color red="0.99" green="0.99" blue="0.99" /></disk></element>
	<element name="lcd_bg"><rect><color red="0.639" green="0.643" blue="0.596" /></rect></element>
	<element name="golden_mask"><rect><color red="0.843" green="0.678" blue="0.482" /></rect></element>

	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>
	<element name="ldot" defstate="0">
		<rect state="1"><color red="0.2" green="0.16" blue="0.16" /></rect>
		<rect state="0"><color red="0.49412" green="0.51765" blue="0.51765" /></rect>
	</element>

	<element name="led" defstate="0">
	<image file="../LEDS/RED_SEL.png" state="1"/>
	<image file="../LEDS/RED.png" state="0"/>
	</element>

	<element name="hlr" defstate="0">
		<text string=" ">
			<bounds x="0" y="0" width="8" height="6" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<disk state="1">
			<bounds x="0.5" y="0.5" width="7" height="5" />
			<color red="1.0" green="1.0" blue="1.0" />
		</disk>
	</element>



<!-- sb board -->

	
	<element name="hlbb" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk>
	</element>

<element name="piece" defstate="0">
		<image file="../piezas/pnovag_plastico/wp.png" state="1"/>
		<image file="../piezas/pnovag_plastico/wkn.png" state="2"/>
		<image file="../piezas/pnovag_plastico/wb.png" state="3"/>
		<image file="../piezas/pnovag_plastico/wr.png" state="4"/>
		<image file="../piezas/pnovag_plastico/wq.png" state="5"/>
		<image file="../piezas/pnovag_plastico/wk.png" state="6"/>
		<image file="../piezas/pnovag_plastico/bp.png" state="7"/>
		<image file="../piezas/pnovag_plastico/bkn.png" state="8"/>
		<image file="../piezas/pnovag_plastico/bb.png" state="9"/>
		<image file="../piezas/pnovag_plastico/br.png" state="10"/>
		<image file="../piezas/pnovag_plastico/bq.png" state="11"/>
		<image file="../piezas/pnovag_plastico/bk.png" state="12"/>
		<image file="../piezas/pnovag_plastico/wp_sel.png" state="13"/>
		<image file="../piezas/pnovag_plastico/wkn_sel.png" state="14"/>
		<image file="../piezas/pnovag_plastico/wb_sel.png" state="15"/>
		<image file="../piezas/pnovag_plastico/wr_sel.png" state="16"/>
		<image file="../piezas/pnovag_plastico/wq_sel.png" state="17"/>
		<image file="../piezas/pnovag_plastico/wk_sel.png" state="18"/>
		<image file="../piezas/pnovag_plastico/bp_sel.png" state="19"/>
		<image file="../piezas/pnovag_plastico/bkn_sel.png" state="20"/>
		<image file="../piezas/pnovag_plastico/bb_sel.png" state="21"/>
		<image file="../piezas/pnovag_plastico/br_sel.png" state="22"/>
		<image file="../piezas/pnovag_plastico/bq_sel.png" state="23"/>
		<image file="../piezas/pnovag_plastico/bk_sel.png" state="24"/>
	</element>                       




<element name="piece_2m" defstate="0">
		<image file="../piezas/chess2/wp.png" state="1"/>
		<image file="../piezas/chess2/wn.png" state="2"/>
		<image file="../piezas/chess2/wb.png" state="3"/>
		<image file="../piezas/chess2/wr.png" state="4"/>
		<image file="../piezas/chess2/wq.png" state="5"/>
		<image file="../piezas/chess2/wk.png" state="6"/>

		<image file="../piezas/chess2/bp.png" state="7"/>
		<image file="../piezas/chess2/bn.png" state="8"/>
		<image file="../piezas/chess2/bb.png" state="9"/>
		<image file="../piezas/chess2/br.png" state="10"/>
		<image file="../piezas/chess2/bq.png" state="11"/>
		<image file="../piezas/chess2/bk.png" state="12"/>

