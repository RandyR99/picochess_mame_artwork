		<image file="../piezas/chess2/bb_sel.png" state="21"></image>
		<image file="../piezas/chess2/br_sel.png" state="22"></image>
		<image file="../piezas/chess2/bq_sel.png" state="23"></image>
		<image file="../piezas/chess2/bk_sel.png" state="24"></image>
	</element>

<element name="piece_svg" defstate="0">
		<image file="../piezas/chess/wp.svg" state="1"/>
		<image file="../piezas/chess/wn.svg" state="2"/>
		<image file="../piezas/chess/wb.svg" state="3"/>
		<image file="../piezas/chess/wr.svg" state="4"/>
		<image file="../piezas/chess/wq.svg" state="5"/>
		<image file="../piezas/chess/wk.svg" state="6"/>

		<image file="../piezas/chess/bp.svg" state="7"/>
		<image file="../piezas/chess/bn.svg" state="8"/>
		<image file="../piezas/chess/bb.svg" state="9"/>
		<image file="../piezas/chess/br.svg" state="10"/>
		<image file="../piezas/chess/bq.svg" state="11"/>
		<image file="../piezas/chess/bk.svg" state="12"/>

		<!-- selected pieces -->
		<image file="../piezas/chess/wp.svg" state="13"><color alpha="0.5" /></image>
		<image file="../piezas/chess/wn.svg" state="14"><color alpha="0.5" /></image>
		<image file="../piezas/chess/wb.svg" state="15"><color alpha="0.5" /></image>
		<image file="../piezas/chess/wr.svg" state="16"><color alpha="0.5" /></image>
		<image file="../piezas/chess/wq.svg" state="17"><color alpha="0.5" /></image>
		<image file="../piezas/chess/wk.svg" state="18"><color alpha="0.5" /></image>
					
		<image file="../piezas/chess/bp.svg" state="19"><color alpha="0.5" /></image>
		<image file="../piezas/chess/bn.svg" state="20"><color alpha="0.5" /></image>
		<image file="../piezas/chess/bb.svg" state="21"><color alpha="0.5" /></image>
		<image file="../piezas/chess/br.svg" state="22"><color alpha="0.5" /></image>
		<image file="../piezas/chess/bq.svg" state="23"><color alpha="0.5" /></image>
		<image file="../piezas/chess/bk.svg" state="24"><color alpha="0.5" /></image>
	</element>



	<group name="sb_board">
		<bounds x="-20.5" y="0" width="119.5" height="80" />

	
				<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-9" increment="10.1" />
			<param name="i" start="8" increment="-1" />
            <param name="z" start="0" increment="10" />
            <param name="z1" start="-1.9" increment="10.1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x400"><bounds x="-20.5" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x800"><bounds x="-10.5" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x100"><bounds x="80.5"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x200"><bounds x="90.5"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece"><bounds x="-3."  y="~y~" width="15" height="15" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="6.3" y="~y~"   width="15" height="15" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="16.3" y="~y~"  width="15" height="15" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="26.3" y="~y~"  width="15" height="15" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="36.3" y="~y~"  width="15" height="15" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="46.3" y="~y~"  width="15" height="15" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="56.3" y="~y~"  width="15" height="15" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="66.3" y="~y~"  width="15" height="15" /></element>

			<element name="piece_k~i~" ref="piece_2m"><bounds x="-17" y="~z1~" width="7" height="7" /></element>
			<element name="piece_l~i~" ref="piece_2m"><bounds x="-8.5" y="~z1~" width="7" height="7" /></element>
			<element name="piece_i~i~" ref="piece_2m"><bounds x="78.6"  y="~z1~" width="7" height="7" /></element>
			<element name="piece_j~i~" ref="piece_2m"><bounds x="87"  y="~z1~" width="7" height="7" /></element>
		</repeat>
	</group>

	<group name="sb_board_2m">
		<bounds x="-20.5" y="0" width="121.0" height="80" />

<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-3.8" increment="10.1" />
			<param name="i" start="8" increment="-1" />
            <param name="z1" start="-1.9" increment="10.1" />
			
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x400"><bounds x="-20.5" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x800"><bounds x="-10.5" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x100"><bounds x="80.5" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x200"><bounds x="90.5" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="0"  y="~y~" width="10" height="10" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10" y="~y~" width="10" height="10" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20" y="~y~" width="10" height="10" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30" y="~y~" width="10" height="10" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40" y="~y~" width="10" height="10" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50" y="~y~" width="10" height="10" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60" y="~y~" width="10" height="10" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70" y="~y~" width="10" height="10" /></element>

			<element name="piece_k~i~" ref="piece_2m"><bounds x="-17" y="~z1~" width="7" height="7" /></element>
			<element name="piece_l~i~" ref="piece_2m"><bounds x="-8.5" y="~z1~" width="7" height="7" /></element>
			<element name="piece_i~i~" ref="piece_2m"><bounds x="78.6"  y="~z1~" width="7" height="7" /></element>
			<element name="piece_j~i~" ref="piece_2m"><bounds x="87"  y="~z1~" width="7" height="7" /></element>
		</repeat>
	</group>

<!-- sb ui -->

	<!-- sb ui -->

	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uit1"><text string="S.BOARD"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uit2"><text string="INTERFACE"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib1"><text string="BOARD:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib2">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="RESET"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uib3">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="CLEAR"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uis1"><text string="SPAWN:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih1"><text string="HAND:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih2">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="REMOVE"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu1"><text string="UNDO:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu2a">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &lt;&lt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2b">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &lt;  "><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2c">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="   &gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2d">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &gt;&gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui">
		<bounds x="0" y="0" width="10" height="80" />
		
		<element ref="hlub" inputtag="board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- spawn -->
		

		<element name="piece_ui1" ref="piece_2m"><bounds x="1.4" y="23"    width="3.7" height="3.8" /></element>
		<element name="piece_ui2" ref="piece_2m"><bounds x="1.4" y="27"    width="3.7" height="3.8" /></element>
		<element name="piece_ui3" ref="piece_2m"><bounds x="1.4" y="31"    width="3.7" height="3.8" /></element>
		<element name="piece_ui4" ref="piece_2m"><bounds x="4.8" y="23"    width="3.7" height="3.8" /></element>
		<element name="piece_ui5" ref="piece_2m"><bounds x="4.8" y="27"    width="3.7" height="3.8" /></element>
		<element name="piece_ui6" ref="piece_2m"><bounds x="4.8" y="31"    width="3.7" height="3.8" /></element>
		<element name="piece_ui7" ref="piece_2m"><bounds x="1.4" y="36"    width="3.7" height="3.8" /></element>
		<element name="piece_ui8" ref="piece_2m"><bounds x="1.4" y="40"    width="3.7" height="3.8" /></element>
		<element name="piece_ui9" ref="piece_2m"><bounds x="1.4" y="43.7"  width="3.7" height="3.8" /></element>
		<element name="piece_ui10" ref="piece_2m"><bounds x="4.8" y="36"   width="3.7" height="3.8" /></element>
		<element name="piece_ui11" ref="piece_2m"><bounds x="4.8" y="40"   width="3.7" height="3.8" /></element>
		<element name="piece_ui12" ref="piece_2m"><bounds x="4.8" y="43.7" width="3.7" height="3.8" /></element>

		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0001"><bounds x="1" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0002"><bounds x="1" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0004"><bounds x="1" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0008"><bounds x="5" y="23" width="4" height="4" /><color alpha="0.25" /></element>
