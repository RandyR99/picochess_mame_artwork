<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->

<element name="scisys">
		<image file="tatrain.png" />
	</element>



<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>



	
	

		<element name="ledg_v" defstate="0">
	<image file="../leds/green_v.png" state="0"/>
	<image file="../leds/green_v_sel.png" state="1"/>
	</element>	
	
		<element name="ledg_h" defstate="0">
	<image file="../leds/green_h.png" state="0"/>
	<image file="../leds/green_h_sel.png" state="1"/>
	</element>
	
  
		<element name="ledo">
		<rect><color red="0.1" green="0.1" blue="0.1" /></rect>
	</element>
	<element name="ledr" defstate="0">
		<rect state="0"><color red="0" green="0" blue="0" /></rect>
		<rect state="1"><color red="1" green="0" blue="0" /></rect>
	</element>
	<element name="ledg" defstate="0">
		<rect state="0"><color red="0.014" green="0.14" blue="0.02" /></rect>
		<rect state="1"><color red="0.1" green="1.0" blue="0.15" /></rect>
	</element>
	
	<element name="but" defstate="0">
	<image file="../buttons/button.png" state="0"/>
	<image file="../buttons/button_sel.png" state="1"/>
	</element>
	
<element name="lcd_bg"><rect><color red="0.5412" green="0.57255" blue="0.5804" /></rect></element>
	<element name="background"><rect><color red="0.63" green="0.63" blue="0.63" /></rect></element>
	<element name="blackb"><rect><color red="0.1" green="0.1" blue="0.1" /></rect></element>
	
	<element name="bmask"><rect><color red="0.17" green="0.15" blue="0.15" /></rect></element>
	
	
		<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>
	<element name="ldot" defstate="0">
		<rect state="1"><color red="0.2" green="0.16" blue="0.16" /></rect>
		<rect state="0"><color red="0.49412" green="0.51765" blue="0.51765" /></rect>
	</element>
	
	
