	  <element name="led7seg_background"><rect><color red="0.639" green="0.643" blue="0.596" />      </rect></element>
	<element name="background"> <rect><color red="0.86" green="0.85" blue="0.85" /></rect></element>
	<element name="black">      <rect><color red="0" green="0" blue="0" />         </rect></element>
	<element name="red">        <rect><color red="0.8" green="0.2" blue="0.2" />         </rect></element>
	  
	<element name="lcdm"><rect><color red="0.730" green="0.684" blue="0.488" /></rect></element>  
	  
	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>  
	  
	  	  	<element name="ledhr" defstate="0">
	<image file="../leds/red_h_sel.png" state="1"/>
    <image file="../leds/black_h.png" state="0"/>
</element>

	  	<element name="ledvr" defstate="0">
	<image file="../leds/red_v_sel.png" state="1"/>
	<image file="../leds/black_v.png" state="0"/>
