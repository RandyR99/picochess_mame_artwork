local function wrist_depth_region(bitmap,joint)
    -- Depth is needed around the wrist, where the two links and the housing
    -- can exchange which one is in front. Keep the rest of the arm span-based.
    local left,top,right,bottom=math.huge,math.huge,-math.huge,-math.huge
    local radius=.62*link_head_size
    for _,x in ipairs({joint.head_x-radius,joint.head_x+radius}) do
        for _,y in ipairs({joint.head_y-radius,joint.head_y+radius}) do
            local high=link_projection(v(x,y,joint.z+.1*link_head_size))
            local low=link_projection(v(x,y,joint.z-1.7*link_head_size))
            left,right=math.min(left,high[1]),math.max(right,high[1])
            top,bottom=math.min(top,high[2]),math.max(bottom,low[2])
        end
    end
    local sx,sy=bitmap.width/draw_width,bitmap.height/draw_height
    return {rows={},left=floor((left-draw_left)*sx),right=ceil((right-draw_left)*sx),
        top=floor((top-draw_top)*sy),bottom=ceil((bottom-draw_top)*sy)}
end

local function elbow_depth_region(bitmap,link)
    local left,top,right,bottom=math.huge,math.huge,-math.huge,-math.huge
    -- Enclose the bracket and its rounded crown throughout the yaw sweep.
    local radius=206
    for _,x in ipairs({link.x-radius,link.x+radius}) do
        for _,y in ipairs({link.y-radius,link.y+radius}) do
            local high=link_projection(v(x,y,upper_arm_top+32))
            local low=link_projection(v(x,y,forearm_root_height(0)-26))
            left,right=math.min(left,high[1]),math.max(right,high[1])
            top,bottom=math.min(top,high[2]),math.max(bottom,low[2])
        end
    end
    local sx,sy=bitmap.width/draw_width,bitmap.height/draw_height
    return {rows={},left=floor((left-draw_left)*sx),right=ceil((right-draw_left)*sx),
        top=floor((top-draw_top)*sy),bottom=ceil((bottom-draw_top)*sy)}
end

local function paint_arm(bitmap,link,joint,opening,hand,figure_box)
    projection=link_projection
    local links=wrist_depth_region(bitmap,joint)
    link_depth=links
    local elbow_links=elbow_depth_region(bitmap,link)
    elbow_depth=elbow_links
    upper_end(bitmap,link)
    upper_link(bitmap,link.upper_angle)
    forearm(bitmap,link,joint,elbow_frame(link,joint.pitch))
    elbow_depth=nil

    -- All casting faces and the spindle share the arm housings' depth.
    local elbow={rows={},top=math.huge,bottom=-1,links=elbow_links,link_tolerance=1e-9}
    wrist_depth=elbow
    elbow_bracket(bitmap,link)
    wrist_depth=nil
    flush_wrist(bitmap,elbow)

    link_depth=nil
    local buffer={rows={},top=math.huge,bottom=-1,figure=figure_masks[hand],
        figure_box=figure_box,figure_depth=link_scale(joint.head_y),links=links,
        mask_width=figure_mask_width,mask_height=figure_mask_height}
    wrist_depth=buffer
    jaws(bitmap,link,joint,opening)
    wrist_depth=nil
    wrist_occlusion=buffer
    wrist_shell(bitmap,link,joint)
    wrist_occlusion=nil
    flush_wrist(bitmap,buffer)
    projection=flat_projection
end

file:set_resolve_tags_callback(function()
    local claw_view=file.views["Artwork by Luis - 3D Claw"]
    local moving_claw=claw_view.items["moving_claw"]
    local claw_bounds=artwork_bounds({-408.954,255.536,3895.592,276.011})
    moving_claw:set_bounds_callback(function() return claw_bounds end)
    claw_view:set_prepare_items_callback(function()
        local raw=output_value("pos_x")
        local x,y=raw &amp; 0x7ff,output_value("pos_y")
        if y==0 then return end
        local left,top,width,height=atlas(y)
        local correction=10*clamp((y-750)/130,0,1)
        left,top=left-correction,top+correction*.6-height*.456
        -- Seat the moving wrist against the photo only near the parked position.
        local park=1-clamp((math.sqrt((x-744)^2+(y-856)^2)-17)/27,0,1)
        park=park*park*(3-2*park)
        local scroll_size=.519911853
        local scroll=clamp((x-140)/1220,0,1)
        local centre=(.5-(1-scroll)*(1-scroll_size))/scroll_size
        local parked_width=263*8035*scroll_size/208
        left=mix(left,1555-parked_width*centre,park)
        top=mix(top,393,park)
        width=mix(width,parked_width,park)
        height=mix(height,315,park)
        claw_bounds=artwork_bounds({left,top,width,height})
    end)

    local view=file.views[draw_view]
    local arm=view.items["articulated_arm"]
    local piece=view.items["carried_figure"]
    local arm_element=arm.element
    local support_box={1448,62,264,675}
    local support_stencil,support_width,support_height
    local arm_render
    local rx,ry=748,846
    local phase,opening,updated=0,0,nil
    local last_hand,lift
    local settling=false
    local link,_,park_drop=calibrated_link(rx,ry,false)
    local joint=wrist_joint(link,math.asin(-park_drop/link_length))
    local function raised_fraction()
        -- novagsound publishes the saved cam counter plus one. Zero means
        -- this driver or installation does not expose the lift.
        local lever=output_value("novag_lift_phase")
        if lever==0 then return nil end
        return .5+.5*math.cos(math.pi*(lever-1)/1000000)
    end
    -- Match the fixed view bounds, with room for the elbow at the left edge.
    local view_top=-395
    -- Match the fixed XML bounds so the raster grid never shifts with a pose.
    local arm_box={0,view_top,3300,2360-view_top}
    local figure_box={0,0,32,60}
    local piece_bounds=artwork_bounds(figure_box,view_top)

    piece:set_bounds_callback(function() return piece_bounds end)

    view.items["arm_pedestal"].element:set_draw_callback(function(_,bitmap)
        draw_into(support_box,link_projection)
        stationary_support(bitmap)
    end)
    arm_element:set_draw_callback(function(_,bitmap)
        -- Supersample the moving layer only, and bound the work at large sizes.
        local w,h=bitmap.width,bitmap.height
        local scale=math.min(1.4,1200/w,1020/h)
        local target=bitmap
        if scale&gt;=1.20 and emu.bitmap_argb32 then
            local sw,sh=floor(w*scale+.5),floor(h*scale+.5)
            if not arm_render or arm_render.width~=sw or arm_render.height~=sh then
                arm_render=emu.bitmap_argb32(sw,sh)
            end
            target=arm_render
            target:fill(0)
        else
            arm_render=nil
        end
        draw_into(arm_box,link_projection)
        -- Cache the fixed geometry's depth on this texture's pixel grid.
        -- It is rebuilt only if MAME requests a different output resolution.
        if target.width~=support_width or target.height~=support_height then
            support_width,support_height=target.width,target.height
            support_stencil={rows={},top=math.huge,bottom=-1}
            wrist_depth=support_stencil
            stationary_support(target)
            wrist_depth=nil
        end
        support_depth=support_stencil
        paint_arm(target,link,joint,opening,last_hand,figure_box)
        support_depth=nil
        if target~=bitmap then target:resample(bitmap) end
    end)

    local function follow(previous, target, dt)
        local value=mix(previous,target,1-math.exp(-dt/.017))
        if abs(target-value)&lt;.12 then return target end
        return value
    end

    view:set_prepare_items_callback(function()
        local pos=output_value("pos_x")
        local x,y=pos &amp; 0x7ff,output_value("pos_y")
        if y==0 then return end
        local time=machine.time:as_double()
        local target=(pos &amp; 0x800)==0 and 0 or 1
        local hand=output_value("cpu_hand")
        local fresh=not updated or time&lt;updated or time-updated&gt;.25
        local dt=updated and clamp(time-updated,0,.05) or 0
        local next_x=fresh and x or follow(rx,x,dt)
        local next_y=fresh and y or follow(ry,y,dt)
        local next_phase=fresh and target or clamp(target,phase-dt*11,phase+dt*11)
        local next_lift=raised_fraction()
        local pose_changed=fresh or settling or next_x~=rx or next_y~=ry or next_lift~=lift
        if not pose_changed and next_phase==phase and hand==last_hand then
            updated=time
            return
        end
        rx,ry,phase,lift,updated,last_hand=next_x,next_y,next_phase,next_lift,time,hand
        opening=phase*phase*(3-2*phase)

        if pose_changed then
            local target_link,travel,drop=calibrated_link(rx,ry,lift~=nil)
            if fresh then
                link,settling=target_link,false
            else
                link,settling=park_motion(link,target_link,rx,ry,dt,settling)
            end
            local dz=(lift and (lift-1)*travel or 0)-drop
            joint=wrist_joint(link,math.asin(dz/link_length))
        end

        if hand~=0 then
            local _,_,width=atlas(ry)
            local texture_width=width/.519911853*160/8035
            local height=link_head_size*link_scale(joint.head_y)
            local contact=link_projection(v(joint.head_x,joint.head_y,
                joint.z-reference_root_z-grip_contact*link_head_size/.83))
            local grip_row=(piece_grip_rows[hand] or 170)/296
            figure_box={contact[1]-texture_width/2,contact[2]-grip_row*height,texture_width,height}
            piece_bounds=artwork_bounds(figure_box,view_top)
        end
        arm_element:invalidate()
    end)
    emu.print_verbose("NOVAG ARM READY")
end)
</script>

