		</element>
		<collection name="Claw Position">
			<element name="pos_x" ref="hand_mpos">
				<animate name="pos_y" />
				<bounds state="0" x="-108.625" y="-170.125" width="819.2" height="5" />
				<bounds state="1500" x="-108.625" y="129.875" width="819.2" height="5" />
				<color alpha="0.4" />
			</element>
			<element name="pos_x" ref="hand_mpos">
				<animate name="pos_y" />
				<bounds state="0" x="-518.225" y="-169.125" width="819.2" height="3.5" />
				<bounds state="1500" x="-518.225" y="130.875" width="819.2" height="3.5" />
				<color alpha="0.9" />
			</element>
			<element ref="hand_blackb">
				<bounds x="-516.225" y="-200" width="409.6" height="400" />
			</element>
