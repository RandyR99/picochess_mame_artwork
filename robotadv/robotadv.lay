	<view name="Artwork by Franz - Hand">
		<bounds left="-38" right="112" top="-16" bottom="107" />
		<group ref="hand_default">
			<bounds left="-38" right="112" top="-16" bottom="107" />
		</group>
	</view>
	<script>-- Approximate the original Novag mechanism with two rigid links.
-- Lengths and inputs are in units of one chess square.
local shoulder_length = 5.43
local forearm_length = math.sqrt(5.62^2 + 1.07^2)
local rows = {{750,-408.954,381.397,3895.592,276.011},{880,-620.357,701.655,4390.795,311.098},{930,-705.429,827.134,4581.015,324.575},{980,-774.636,956.281,4723.759,334.689},{1030,-817.219,1099.549,4807.079,340.592},{1080,-887.035,1238.938,4955.797,351.129},{1130,-941.204,1382.682,5074.96,359.572},{1180,-1020.185,1547.227,5235.626,370.956},{1230,-1063.201,1723.62,5329.635,377.617},{1290,-1114.824,1935.304,5442.51,385.614}}
local draw_view = "Artwork by Luis - 3D Arm"
local floor, ceil, abs = math.floor, math.ceil, math.abs

local function clamp(value, low, high)
    return math.max(low, math.min(high, value))
end

-- Read an output through a fresh proxy (output.get_value is deprecated).
-- Don't keep proxies: they point into the machine's output storage.
local function output_value(name)
    return machine.devices[":"]:output(name):get()
end

local function mix(a,b,f)
    return a + (b-a)*f
end

local function atlas(raw_y)
    for i=2,#rows do
        local a,b=rows[i-1],rows[i]
        if raw_y&lt;=b[1] or i==#rows then
            local f=clamp((raw_y-a[1])/(b[1]-a[1]),0,1)
            return mix(a[2],b[2],f),mix(a[3],b[3],f),mix(a[4],b[4],f),mix(a[5],b[5],f)
        end
    end
end

local wrist_plane_offset=.25
local wrist_cap_thickness=.048
local wrist_flat_side=.515
local wrist_scale_x,wrist_scale_y=.93,.86
local wrist_height=.94
local function head(raw_x,raw_y)
    local x,y,w,h=atlas(raw_y)
    local f=clamp((raw_x-140)/1220,0,1)
    local size=0.519911853
    local cx=x + w*(0.5-(1-f)*(1-size))/size
    -- Blend only in the parking area, outside the magnet grid.
    local distance=math.sqrt((raw_x-748)^2+(raw_y-846)^2)
    local park=1-clamp((distance-3)/34,0,1)
    park=park*park*(3-2*park)
    return cx-14*park,y+h*.005,h*(1-.09*park),park
end

-- Centre the foot at the rear D/E line. Keep the board's camera fixed.
local camera_x,shoulder_y=1547,267
local shoulder_x=1580
local pedestal_raise=30/.83
local arm_base_z=62/.83+pedestal_raise
local shoulder_extension=185
local foot_y=646
local function pose(raw_x,raw_y)
    local x,y=(raw_x-750)/50,(raw_y-750)/50
    local reach=math.sqrt(x*x+y*y)
    local safe=clamp(reach,0.4,shoulder_length+forearm_length)
    local angle=math.atan(y,x)+math.acos(clamp((shoulder_length^2+safe^2-forearm_length^2)/(2*shoulder_length*safe),-1,1))
    return shoulder_length*math.cos(angle),shoulder_length*math.sin(angle)
end

local function elbow_point(ex,ey)
    -- Project the elbow using the lens approximation of the perspective board.
    local perspective=1+0.023*ey
    return shoulder_x+ex*174*perspective,shoulder_y+ey*97*perspective
end

local function articulated_pose(raw_x,raw_y)
    local tx,ty,h,park=head(raw_x,raw_y)
    local bx,by=elbow_point(pose(raw_x,raw_y))
    -- In the folded pose the forearm points almost straight across the board.
    -- Its endpoint is the same depth as the centre of the wrist's flat side.
    by=by-18*park
    local folded_axis_y=by+21
    ty=mix(ty,folded_axis_y+wrist_plane_offset*h,park)
    return tx,ty,h,bx,by,park
end

-- Draw into the current layer's tight rectangle in artwork coordinates.
local draw_left,draw_top,draw_width,draw_height
local function flat_projection(point)
    return {point[1],point[2]*.64-point[3]*.83}
end

-- A common camera for the fixed spindle and the complete articulated arm.
local lens=.00018
local shoulder_world_y=shoulder_y/.64
local function link_scale(y)
    return 1/(1-lens*(y-shoulder_world_y))
end

local function link_projection(point)
    local scale=link_scale(point[2])
    return {camera_x+(point[1]-camera_x)*scale,
        shoulder_y+((point[2]-shoulder_world_y)*.64-point[3]*.83)*scale,scale}
end

local function unproject_link(x,y,z)
    local offset=y-shoulder_y
    local depth=(offset+.83*z)/(.64+lens*offset)+shoulder_world_y
    return camera_x+(x-camera_x)/link_scale(depth),depth
end

local projection=flat_projection
local function draw_into(bounds,project)
    draw_left,draw_top,draw_width,draw_height=table.unpack(bounds)
    projection=project or flat_projection
end

-- The wrist and all three fingers share one depth buffer in the arm texture.
-- Reciprocal depth is affine after projection, including along a scanline.
local wrist_depth,wrist_occlusion,support_depth,link_depth,elbow_depth
local function wrist_row(buffer, y, sx, sy)
    local row=buffer.rows[y]
    if row then return row end
    row={depth={},color={},left=math.huge,right=-1}
    buffer.rows[y]=row
    buffer.top=math.min(buffer.top,y)
    buffer.bottom=math.max(buffer.bottom,y)
    local figure=buffer.figure
    if figure then
        local x0,y0,w,h=table.unpack(buffer.figure_box)
        local art_y=draw_top+(y+.5)/sy
        local spans=figure[floor((art_y-y0)/h*buffer.mask_height)+1]
        if spans and #spans&gt;0 then
            local left=(x0-draw_left)*sx
            local scale=w*sx/buffer.mask_width
            row.mask={}
            for i=1,#spans,2 do
                local first=ceil(left+(spans:byte(i)-40)*scale-.5)
                local last=ceil(left+(spans:byte(i+1)-40)*scale-.5)-1
                for x=first,last do row.mask[x]=true end
            end
        end
    end
    return row
end

local function write_wrist_span(buffer,y,l,r,left,right,left_z,right_z,color,sx,sy)
    local row=wrist_row(buffer,y,sx,sy)
    local step=(right_z-left_z)/(right-left)
    local depth=left_z+(l+.5-left)*step
    local depths,colors,mask=row.depth,row.color,row.mask
    local support=support_depth and support_depth.rows[y]
    local fixed=support and support.depth
    local link=buffer.links and buffer.links.rows[y]
    local foreground=link and link.depth
    for x=l,r do
        if (not fixed or not fixed[x] or depth&gt;fixed[x]) and
            (not foreground or not foreground[x] or depth&gt;foreground[x]-(buffer.link_tolerance or 0)) and
            (not depths[x] or depth&gt;=depths[x]-1e-10) and
            (not mask or not mask[x] or depth&gt;=buffer.figure_depth) then
            depths[x],colors[x]=depth,color
        end
        depth=depth+step
    end
    row.left=math.min(row.left,l)
    row.right=math.max(row.right,r)
end

local function cover_fingers(buffer,y,l,r,left,right,left_z,right_z)
    local row=buffer.rows[y]
    if not row or r&lt;row.left or l&gt;row.right then return end
    l,r=math.max(l,row.left),math.min(r,row.right)
    local step=(right_z-left_z)/(right-left)
    local depth=left_z+(l+.5-left)*step
    local depths,colors=row.depth,row.color
    for x=l,r do
        if colors[x] and depth&gt;=depths[x] then colors[x]=nil end
        depth=depth+step
    end
end

local function flush_wrist(bitmap,buffer)
    for y=buffer.top,buffer.bottom do
        local row=buffer.rows[y]
        if row then
            local color,start
            for x=row.left,row.right+1 do
                local next_color=row.color[x]
                if color~=next_color then
                    if color then bitmap:fill(color,start,y,x-1,y) end
                    color,start=next_color,x
                end
            end
        end
    end
end

local function fill_visible_span(bitmap,y,l,r,left,right,left_z,right_z,color)
    -- Keep the housing silhouette intact throughout a sweep. The support
    -- and the articulated links are painted first. Finger/figure depth
    -- tests still run in the wrist buffer.
    local row=not wrist_occlusion and support_depth and support_depth.rows[y]
    if not row or r&lt;row.left or l&gt;row.right then
        bitmap:fill(color,l,y,r,y)
        return
    end
    local first,last=math.max(l,row.left),math.min(r,row.right)
    local step=(right_z-left_z)/(right-left)
    local depth=left_z+(first+.5-left)*step
    local start=l
    for x=first,last do
        local fixed=row.depth[x]
        if fixed and depth&lt;=fixed then
            if start&lt;x then bitmap:fill(color,start,y,x-1,y) end
            start=x+1
        end
        depth=depth+step
    end
    if start&lt;=r then bitmap:fill(color,start,y,r,y) end
end

local function record_link_span(buffer,y,l,r,left,right,left_z,right_z)
    if y&lt;buffer.top or y&gt;buffer.bottom then return end
    l,r=math.max(l,buffer.left),math.min(r,buffer.right)
    if l&gt;r then return end
    local row=buffer.rows[y]
    if not row then
        row={left=l,right=r,depth={}}
        buffer.rows[y]=row
    end
    row.left,row.right=math.min(l,row.left),math.max(r,row.right)
    local step=(right_z-left_z)/(right-left)
    local depth=left_z+(l+.5-left)*step
    local samples=row.depth
    for x=l,r do
        if not samples[x] or depth&gt;samples[x] then samples[x]=depth end
        depth=depth+step
    end
end

local function raster(bitmap,points,color)
    local sx,sy=bitmap.width/draw_width,bitmap.height/draw_height
    local edges,low,high={},bitmap.height,0
    local previous=points[#points]
    local depth,occlusion=wrist_depth,wrist_occlusion
    for _,point in ipairs(points) do
        local ax,ay=(previous[1]-draw_left)*sx,(previous[2]-draw_top)*sy
        local bx,by=(point[1]-draw_left)*sx,(point[2]-draw_top)*sy
        local az,bz=previous[3] or 0,point[3] or 0
        if ay&gt;by then ax,ay,az,bx,by,bz=bx,by,bz,ax,ay,az end
        if by&gt;ay then
            edges[#edges+1]={ax,ay,by,(bx-ax)/(by-ay),az,(bz-az)/(by-ay)}
            low=math.min(low,ay)
            high=math.max(high,by)
        end
        previous=point
    end
    -- Each face is convex. The outer intersections delimit a span.
    for y=math.max(0,ceil(low-0.5)),math.min(bitmap.height-1,ceil(high-0.5)-1) do
        local left,right=math.huge,-math.huge
        local left_z,right_z
        local capture_link=link_depth and y&gt;=link_depth.top and y&lt;=link_depth.bottom
        local capture_elbow=elbow_depth and y&gt;=elbow_depth.top and y&lt;=elbow_depth.bottom
        local compare_depth=depth or occlusion or capture_link or capture_elbow or (support_depth and support_depth.rows[y])
        local scan=y+0.5
        for _,edge in ipairs(edges) do
            if scan&gt;=edge[2] and scan&lt;edge[3] then
                local offset=scan-edge[2]
                local x=edge[1]+offset*edge[4]
                if x&lt;left then
                    left=x
                    if compare_depth then left_z=edge[5]+offset*edge[6] end
                end
                if x&gt;right then
                    right=x
                    if compare_depth then right_z=edge[5]+offset*edge[6] end
                end
            end
        end
        local l=math.max(0,ceil(left-0.5))
        local r=math.min(bitmap.width-1,floor(right-0.5))
        if l&lt;=r and right&gt;left then
            if depth then
                write_wrist_span(depth,y,l,r,left,right,left_z,right_z,color,sx,sy)
            else
                fill_visible_span(bitmap,y,l,r,left,right,left_z,right_z,color)
                if capture_link then record_link_span(link_depth,y,l,r,left,right,left_z,right_z) end
                if capture_elbow then record_link_span(elbow_depth,y,l,r,left,right,left_z,right_z) end
                if occlusion then cover_fingers(occlusion,y,l,r,left,right,left_z,right_z) end
            end
        end
    end
end

-- Project 3D section meshes into the same artwork space as the board.
-- X/Y are the projected floor plane; Z is height toward the camera.
local function v(x,y,z) return {x,y,z} end
local function sub(a,b) return v(a[1]-b[1],a[2]-b[2],a[3]-b[3]) end
local function cross(a,b)
    return v(a[2]*b[3]-a[3]*b[2],a[3]*b[1]-a[1]*b[3],a[1]*b[2]-a[2]*b[1])
end
local function unit(a)
    local d=math.sqrt(a[1]^2+a[2]^2+a[3]^2)
    if d&lt;0.0001 then return v(0,0,1) end
    return v(a[1]/d,a[2]/d,a[3]/d)
end
local function dot(a,b) return a[1]*b[1]+a[2]*b[2]+a[3]*b[3] end
local light=unit(v(-0.68,0.22,0.82))
local view_dir=unit(v(0,0.83,0.64))
local sheen=unit(v(light[1],light[2]+view_dir[2],light[3]+view_dir[3]))
local plastic={base={40,43,41}, ambient=0.44, diffuse=0.82, glint=34, power=22}
local shoulder_bevel={base={47,49,47}, ambient=.46, diffuse=.82, glint=42, power=23}
local foot_plastic={base={22,24,24}, ambient=.43, diffuse=.77, glint=23, power=21}
local forearm_plastic={base={49,51,49}, ambient=.44, diffuse=.82, glint=35, power=22}
local seam={base={24,25,23}, ambient=0.48, diffuse=0.55, glint=8, power=15}
local metal={base={160,160,155}, ambient=0.48, diffuse=0.70, glint=90, power=19}
local steel={base={90,92,90}, ambient=0.36, diffuse=0.58, glint=68, power=16}

-- A soft side fill separates the black fingers from the dark squares.
local finger_fill_direction=unit(v(-.52,.86,.32))

local function surface(normal, material)
    local level=material.ambient+material.diffuse*math.max(0,dot(normal,light))
    local gloss=material.glint*math.max(0,dot(normal,sheen))^material.power
    if material.rim then
        local grazing=1-clamp(dot(normal,view_dir),0,1)
        gloss=gloss+material.rim*grazing^2.3
    end
    if material.fill then
        gloss=gloss+material.fill*math.max(0,dot(normal,finger_fill_direction))
    end
    local c=material.base
    local function channel(i) return floor(clamp(c[i]*level+gloss,0,255)) end
    return 0xff000000 | (channel(1)&lt;&lt;16) | (channel(2)&lt;&lt;8) | channel(3)
end

local function solid(bitmap, sections, materials, draw_bottom, cap_split, first_side)
    local faces={}
    local function face(points, material)
        local n=unit(cross(sub(points[2],points[1]),sub(points[3],points[1])))
        if dot(n,view_dir)&lt;=0.002 then return end
        local projected={}
        local depth=0
        for i,p in ipairs(points) do
            projected[i]=projection(p)
            depth=depth+dot(p,view_dir)
        end
        faces[#faces+1]={projected,surface(n,material),depth/#points}
    end
    for k=1,#sections-1 do
        local lower,upper=sections[k],sections[k+1]
        for i=first_side or 1,#lower do
            local j=i%#lower+1
            face({lower[i],lower[j],upper[j],upper[i]},materials[k])
        end
    end
    if draw_bottom then
        local first={}
        for i,p in ipairs(sections[1]) do first[#sections[1]-i+1]=p end
        face(first,materials[1])
    end
    local top,finish=sections[#sections],materials[#materials]
    if cap_split then
        -- Two convex areas share the chord at the neck of the trim.
        local round_top={table.unpack(top,1,cap_split)}
        local strip_top={top[1],table.unpack(top,cap_split)}
        face(round_top,finish)
        face(strip_top,finish)
    else
        face(top,finish)
    end
    table.sort(faces,function(a,b) return a[3]&lt;b[3] end)
    for _,f in ipairs(faces) do raster(bitmap,f[1],f[2]) end
end

local function column(bitmap,x,y,base,profile,outline,slope_x,slope_y,cap_split)
    slope_x,slope_y=slope_x or 0,slope_y or 0
    local sections,materials={},{}
    for k,q in ipairs(profile) do
        local ring={}
        for i,p in ipairs(outline) do
            local px,py=p[1]*q[2],p[2]*q[2]
            ring[i]=v(x+px,y/.64+py,base+q[1]+px*slope_x+py*slope_y)
        end
        sections[k],materials[k]=ring,q[3]
    end
    solid(bitmap,sections,materials,false,cap_split)
end

local function circle(radius,ratio,sides)
    local ring={}
    sides=sides or 28
    for i=1,sides do
        local a=(i-1)*math.pi/(sides*.5)
        ring[i]={radius*math.cos(a),radius*math.sin(a)*ratio}
    end
    return ring
end

local function rounded(width,length,radius,angle)
    local outline={}
    local c,s=math.cos(angle),math.sin(angle)
    for corner=0,3 do
        local start=corner*math.pi/2
        local x=(corner==0 or corner==3) and length/2-radius or -length/2+radius
        local y=corner&lt;2 and width/2-radius or -width/2+radius
        for j=0,4 do
            local a=start+j*math.pi/8
            local u,w=x+radius*math.cos(a),y+radius*math.sin(a)
            outline[#outline+1]={u*c-w*s,u*s+w*c}
        end
    end
    return outline
end

-- The head is carried by this hinge on the centre of its flat wall.
-- It shares the forearm's yaw. The bearing compensates its pitch.
local upper_length=938
local link_length=798
-- The forearm runs in front of the axle through the end of the upper arm.
local forearm_offset=90
local link_head_size=290
local wrist_roof_recess=28
local link_root_z=arm_base_z-12/.83
local reference_root_z=link_root_z-pedestal_raise
local wrist_flat_distance=wrist_flat_side*wrist_scale_x*link_head_size

local function pose_from_angles(upper_angle,lower_angle)
    return {x=shoulder_x+upper_length*math.cos(upper_angle),
        y=shoulder_world_y+upper_length*math.sin(upper_angle),
        upper_angle=upper_angle,angle=lower_angle,c=math.cos(lower_angle),s=math.sin(lower_angle)}
end

local function angle_delta(current,target)
    local difference=target-current
    return math.atan(math.sin(difference),math.cos(difference))
end

local function linked_pose(target_x,target_y,target_z,reference_pitch,park)
    local x,y=unproject_link(target_x,target_y,target_z)
    x=x+park*(shoulder_x-camera_x)
    local dx,dy=x-shoulder_x,y-shoulder_world_y
    -- The folded wrist parks on the near side of the fixed column. Its
    -- housing and finger sweep must clear the column before moving away.
    local clearance=mix(226,212,park)
    if dx*dx+dy*dy&lt;clearance^2 then
        dy=math.sqrt(clearance^2-dx*dx)
        y=shoulder_world_y+dy
    end
    local along=link_length*math.cos(reference_pitch)+wrist_flat_distance
    local reach=math.sqrt(along^2+forearm_offset^2)
    local distance=math.sqrt(dx*dx+dy*dy)
    local safe=clamp(distance,math.max(abs(upper_length-reach),.01),upper_length+reach)
    local offset=math.acos(clamp((upper_length^2+safe^2-reach^2)/(2*upper_length*safe),-1,1))
    local upper_angle=math.atan(dy,dx)+offset

    local bx=shoulder_x+upper_length*math.cos(upper_angle)
    local by=shoulder_world_y+upper_length*math.sin(upper_angle)
    local wrist_offset=math.atan(forearm_offset,along)
    local angle=math.atan(y-by,x-bx)-wrist_offset
    -- At rest the upper link lies across the board. Retain the wrist's
    -- clearance in depth with the corresponding folded lower angle.
    local parked_upper=math.pi
    local parked_lower=math.asin(clamp(dy/reach,-1,1))-wrist_offset
    return pose_from_angles(upper_angle+park*angle_delta(upper_angle,parked_upper),
        angle+park*angle_delta(angle,parked_lower))
end

-- Almost folded, the projected target can move around the shoulder axis
-- far faster than either motor. Advance both angles by the same fraction.
-- The board calibration is used directly once the links leave this area.
local function park_motion(current,target,x,y,dt,settling)
    if not settling and (x-748)^2+(y-846)^2&gt;52^2 then return target,false end
    local upper_step=angle_delta(current.upper_angle,target.upper_angle)
    local lower_step=angle_delta(current.angle,target.angle)
    local distance=math.max(abs(upper_step),abs(lower_step))
    local limit=math.rad(150)*dt
    if distance&lt;=limit or distance&lt;1e-7 then return target,false end
    local progress=limit/distance
    return pose_from_angles(current.upper_angle+progress*upper_step,
        current.angle+progress*lower_step),true
end

local function wrist_joint(link,pitch)
    local reach=link_length*math.cos(pitch)
    local x=link.x+link.c*reach-link.s*forearm_offset
    local y=link.y+link.s*reach+link.c*forearm_offset
    local dz=link_length*math.sin(pitch)
    return {x=x,y=y,z=link_root_z+dz,rise=dz*.83,
        head_x=x+link.c*wrist_flat_distance,head_y=y+link.s*wrist_flat_distance,pitch=pitch}
end

-- Keep the bearing contact and add material above the original shell.
local upper_arm_underside=arm_base_z-156
local upper_arm_half_height=121
local upper_arm_top=upper_arm_underside+2*upper_arm_half_height

-- The elbow bracket follows the forearm in yaw. The shell alone pitches
-- on its transverse seat inside the bracket.
local forearm_inset,forearm_seat=64,28
local forearm_seat_start,forearm_join,forearm_half_width=49,80,49
local forearm_profile={
    {0,.93,forearm_plastic},{.045,1,forearm_plastic},
    {.47,1,seam},{.48,.974,seam,1},{.52,.974,forearm_plastic,1},
    {.54,1,forearm_plastic},{.95,1,forearm_plastic},{1,.914,forearm_plastic}
}
local wrist_depth_at_wall=wrist_height*link_head_size
local forearm_end_depth=.70*wrist_depth_at_wall
local forearm_join_fraction=(forearm_join+forearm_inset)/(link_length+forearm_inset)
local forearm_root_depth=mix(158/.83,forearm_end_depth,forearm_join_fraction)+42

local function forearm_root_height(level)
    return upper_arm_top+(level-1)*forearm_root_depth
end

local function elbow_frame(link,pitch)
    local cp,sp=math.cos(pitch),math.sin(pitch)
    local pitch_seat=42
    return function(along,across,z)
        local dz=z-link_root_z
        local offset=along-pitch_seat
        local distance=pitch_seat+offset*cp-dz*sp
        return v(link.x+distance*link.c-across*link.s,
            link.y+distance*link.s+across*link.c,link_root_z+offset*sp+dz*cp)
    end
end

local function forearm_section(link,joint,mount)
    local cp,sp=math.cos(joint.pitch),math.sin(joint.pitch)
    local wall_middle=-(wrist_depth_at_wall+wrist_roof_recess)*.5
    local roof_at_wrist=wall_middle+.5*forearm_end_depth
    local function roof_before(along)
        local fade=clamp((along+forearm_inset)/(link_length+forearm_inset),0,1)
        return joint.z+(math.min(along,link_length)-link_length)*sp+fade*roof_at_wrist
    end
    local rise=upper_arm_top-roof_before(forearm_join)
    return function(along,across,level)
        across=across+forearm_offset
        local fade=clamp((along+forearm_inset)/(link_length+forearm_inset),0,1)
        local root_z=(level-1)*158/.83
        if along&lt;=forearm_join then
            return mount(along,across,forearm_root_height(level))
        end
        -- Loft from the elbow to an upright section centred on
        -- the flat wall. Extension inside that wall keeps the joint seated.
        local distance=along*cp-root_z*sp*(1-fade)
        local relative_z=mix(root_z*cp,wall_middle+(level-.5)*forearm_end_depth,fade)
        local axis_z=joint.z+(math.min(along,link_length)-link_length)*sp
        local shell_rise=rise*clamp((link_length-along)/(link_length-forearm_join),0,1)
        -- Keep enough casing depth at the root to cover the lower seat.
        local root_depth=42*(1-level)*clamp((link_length-along)/(link_length-forearm_join),0,1)
        return v(link.x+distance*link.c-across*link.s,
            link.y+distance*link.s+across*link.c,axis_z+relative_z+shell_rise-root_depth)
    end
end

local function forearm(bitmap,link,joint,mount)
    local span=link_length
    local c,s=link.c,link.s
    local cp,sp=math.cos(joint.pitch),math.sin(joint.pitch)
    local point=forearm_section(link,joint,mount)
    local tip=span+forearm_seat
    local length=tip-forearm_join
    local centre=(tip+forearm_join)*.5
    local sections,materials={},{}
    for k,q in ipairs(forearm_profile) do
        local across=forearm_half_width*q[2]
        local outline=rounded(across*2,length,7,0)
        -- Close the plastic seam where it meets the continuous silver wall.
        local root_across=forearm_half_width*(q[4] or q[2])
        local ring={point(forearm_join,root_across,q[1]),
            point(forearm_seat_start,root_across,q[1]),
            point(forearm_seat_start,-root_across,q[1]),
            point(forearm_join,-root_across,q[1])}
        for _,i in ipairs({16,17,18,19,20,1,2,3,4,5}) do
            local p=outline[i]
            ring[#ring+1]=point(centre+p[1],p[2],q[1])
        end
        sections[k],materials[k]=ring,q[3]
    end
    solid(bitmap,sections,materials,false,4)
    local half=forearm_half_width*.85
    local colour=surface(v(-c*sp,-s*sp,cp),seam)
    local function project(along,across)
        return projection(point(along,across,1))
    end
    for _,setback in ipairs({103,75,47,19}) do
        local along=span-setback
        raster(bitmap,{project(along,-half),project(along,half),
            project(along+4,half),project(along+4,-half)},colour)
    end
end

local pedestal_outline=circle(90.5,.95)
local function stationary_support(bitmap)
    -- Both the floor and bearing use the shoulder's world X/Y. The
    -- projected displacement between them comes entirely from height.
    local base=(shoulder_y-foot_y)/.83-8
    local height=upper_arm_underside-base
    column(bitmap,shoulder_x,shoulder_y,base,{{0,1.04,seam},{6,1.06,foot_plastic},
        {15,.99,foot_plastic},{24,.96,foot_plastic},{height-25,.93,foot_plastic},
        {height-16,.93,seam},{height-11,.97,foot_plastic},
        {height,.97,foot_plastic}},pedestal_outline)

end

local upper_trim_finish={base={47,49,47},ambient=.43,diffuse=.79,glint=30,power=23}

local function upper_trim(bitmap,c,s)
    local radius,half_width=113,67
    local start=math.asin(half_width/radius)
    local arc_count=33
    local tip=upper_length-123
    local outline={}
    local function append(x,y)
        outline[#outline+1]={x*c-y*s,x*s+y*c}
    end
    for i=0,arc_count-1 do
        local turn=mix(start,2*math.pi-start,i/(arc_count-1))
        append(radius*math.cos(turn),radius*math.sin(turn))
    end
    append(tip-7,-half_width)
    append(tip,-half_width+7)
    append(tip,half_width-7)
    append(tip-7,half_width)
    column(bitmap,shoulder_x,shoulder_y,upper_arm_top,{{0,1,seam},{5,1,plastic},
        {16,.997,shoulder_bevel},{19,.994,upper_trim_finish}},outline,nil,nil,arc_count)
end

-- The broad shoulder and the upper link are one two-piece shell.
local function upper_link(bitmap,angle)
    local length=upper_length-62
    local c,s=math.cos(angle),math.sin(angle)
    local outline={}
    local function append(x,y)
        outline[#outline+1]={x*c-y*s,x*s+y*c}
    end
    append(length,80)
    append(length-8,88)
    local tail_radius,half_depth=157,143
    local blend=15*math.pi/180
    append(tail_radius*math.sin(blend),half_depth*math.cos(blend))
    append(0,half_depth)
    -- Keep the pivot at the seam between the link and the extended capsule.
    for i=0,32 do
        local theta=math.pi*(.5+i/32)
        append(-shoulder_extension+tail_radius*math.cos(theta),half_depth*math.sin(theta))
    end
    append(0,-half_depth)
    append(tail_radius*math.sin(blend),-half_depth*math.cos(blend))
    append(length-8,-88)
    append(length,-80)
    local half=upper_arm_half_height
    column(bitmap,shoulder_x,shoulder_y,upper_arm_underside,{{0,.95,plastic},{8,1,plastic},
        {half-5,1,seam},{half-2,.989,seam},{half+2,.989,plastic},{half+6,1,plastic},
        {2*half-8,1,shoulder_bevel},{2*half,.972,plastic}},outline)
    upper_trim(bitmap,c,s)
end

local screw_positions={upper_arm_top-80,upper_arm_top-153}

local function elbow_screw(bitmap,mount,along,across,z,normal)
    if dot(normal,view_dir)&lt;=.002 then return end
    local sections={}
    for k,q in ipairs({{0,26},{3,28},{7,26},{9,23}}) do
        local ring={}
        for i=0,19 do
            local a=i*math.pi/10
            ring[#ring+1]=mount(along-q[2]*math.cos(a),across+q[1],z+q[2]*math.sin(a))
        end
        sections[k]=ring
    end
    solid(bitmap,sections,{steel,metal,metal,metal})
    for _,offset in ipairs({-11,11}) do
        local points={}
        for _,p in ipairs(circle(4.1,1,12)) do
            points[#points+1]=projection(mount(along+offset+p[1],across+9,z+p[2]))
        end
        raster(bitmap,points,surface(normal,seam))
    end
end

local upper_end_radius=55
local upper_end_outline={{0,upper_end_radius},{-91,upper_end_radius},
    {-101,36},{-101,-36},{-91,-upper_end_radius}}
for i=0,15 do
    local a=math.pi*(-.5+i/16)
    upper_end_outline[#upper_end_outline+1]={upper_end_radius*math.cos(a),upper_end_radius*math.sin(a)}
end

local function upper_end(bitmap,link)
    local angle=link.upper_angle
    local c,s=math.cos(angle),math.sin(angle)
    local outline={}
    for i,p in ipairs(upper_end_outline) do
        outline[i]={p[1]*c-p[2]*s,p[1]*s+p[2]*c}
    end
    local half=upper_arm_half_height
    column(bitmap,link.x,link.y*.64,upper_arm_underside,{{0,.95,plastic},{8,1,plastic},
        {half-5,1,seam},{half-2,.989,seam},{half+2,.989,plastic},{half+6,1,plastic},
        {2*half-8,1,shoulder_bevel},{2*half,.972,plastic}},outline)
end

local bracket_top,bracket_bottom=upper_arm_top+7,upper_arm_underside-17
local bracket_front_y=forearm_offset+forearm_half_width
local bracket_front={
    {forearm_join,bracket_front_y},{-91,bracket_front_y},{-98,137},
    {-104,131},{-108,123},{-109,114}
}
local bracket_inner={
    {forearm_join,bracket_front_y-6},{-90,bracket_front_y-6},{-96,132},
    {-100,128},{-102,121},{-103,114}
}
local bracket_outline={table.unpack(bracket_front)}
for _,point in ipairs({{-107,70},{-99,25},{-84,-15},{-65,-42},{-39,-60},
    {-9,-68},{24,-66},{51,-52},{70,-31},{82,-6},{83,32},{82,75}}) do
    bracket_outline[#bracket_outline+1]=point
end

local function bent_metal(bitmap,mount,outline,bottom,top,first_side)
    local lower,upper={},{}
    for i,p in ipairs(outline) do
        lower[i]=mount(p[1],p[2],bottom)
        upper[i]=mount(p[1],p[2],top)
    end
    solid(bitmap,{lower,upper},{metal,metal},true,nil,first_side)
end

-- The axle is driven through the upper arm and turns with the bracket.
local spindle_stem,spindle_head=circle(20,1,24),circle(46,1,32)
local function elbow_spindle(bitmap,mount)
    bent_metal(bitmap,mount,spindle_stem,bracket_bottom,bracket_top+3)
    local sections={}
    for k,q in ipairs({{0,1},{6,.99},{14,.92}}) do
        local ring={}
        for i,p in ipairs(spindle_head) do
            ring[i]=mount(p[1]*q[2],p[2]*q[2],bracket_top+q[1])
        end
        sections[k]=ring
    end
    solid(bitmap,sections,{steel,metal,metal})
end

local function elbow_bracket(bitmap,link)
    local mount=elbow_frame(link,0)
    -- Both folds and the wall meet at the same perimeter vertices. The
    -- front wall spans their full height, leaving the rear open.
    bent_metal(bitmap,mount,bracket_outline,bracket_bottom,bracket_bottom+7,#bracket_front)
    bent_metal(bitmap,mount,bracket_outline,bracket_top-7,bracket_top,#bracket_front)
    for i=1,#bracket_front-1 do
        local wall={bracket_front[i],bracket_front[i+1],bracket_inner[i+1],bracket_inner[i]}
        bent_metal(bitmap,mount,wall,bracket_bottom,bracket_top)
    end

    local normal=v(-link.s,link.c,0)
    for _,z in ipairs(screw_positions) do
        elbow_screw(bitmap,mount,42,bracket_front_y,z,normal)
    end
    elbow_spindle(bitmap,mount)
end

local wrist_lift = 0.275
local jaw_hook_depth=1.161
-- Vertical contact landmarks on the twelve 296-pixel-tall carried sprites.
local piece_grip_rows={170,183,140,188,134,138,170,183,178,190,132,138}
-- All fingers use black plastic with a narrow specular edge.
local finger_plastic={base={16,17,18},ambient=.85,diffuse=.17,glint=12,power=9,rim=42,fill=21}
local jaw_spacing=.012
local jaw_profiles={
    -- Depth, radial position at rest and the two shaft half-widths.
    {0.535,.184,.025,.024},
    {0.735,.192,.025,.024},
    {0.905,.191,.024,.023},
    {1.101,.176,.024,.023},
    {1.178,.151,.030,.028}
}

local function jaw_hook(bitmap,point,angle)
    local pieces={}
    local span=34*math.pi/180
    local segments=8
    local function hook_point(a,r,z)
        return point(jaw_spacing+math.cos(a-angle)*r,math.sin(a-angle)*r,jaw_hook_depth+z)
    end
    for i=1,segments do
        local a=angle+span*(2*(i-1)/segments-1)
        local b=angle+span*(2*i/segments-1)
        local function ring(z,outer,inner)
            return {hook_point(a,inner,z),hook_point(a,outer,z),
                hook_point(b,outer,z),hook_point(b,inner,z)}
        end
        local sections={
            ring(.024,.123,.080),
            ring(.018,.133,.075),
            ring(-.006,.133,.075),
            ring(-.012,.124,.079)
        }
        pieces[#pieces+1]={math.sin((a+b)/2),sections}
    end
    table.sort(pieces,function(a,b) return a[1]&lt;b[1] end)
    for _,part in ipairs(pieces) do
        solid(bitmap,part[2],{finger_plastic,finger_plastic,finger_plastic,finger_plastic},true)
    end
end

local function jaw(bitmap,joint,angle,opening)
    -- Every attachment is expressed in the wrist's coordinate system.
    local h=link_head_size
    local lift_z=joint.z-reference_root_z+(wrist_lift-wrist_plane_offset)*h/.83
    local nx,ny=math.cos(angle),math.sin(angle)
    local pivot_radius=jaw_profiles[1][2]+jaw_spacing
    local pivot_depth=jaw_profiles[1][1]
    local spread=opening*.151
    local c,s=math.cos(spread),math.sin(spread)
    -- Apply the same hinge rotation to the shaft and hook about the
    -- tangential axis through this finger's own attachment point.
    local function point(radius,tangent,depth)
        local dr,dz=radius-pivot_radius,(depth-pivot_depth)/.83
        local r=(pivot_radius+dr*c+dz*s)*h
        local t=tangent*h
        local z=lift_z-(pivot_depth/.83+dz*c-dr*s)*h
        return v(joint.head_x+nx*r-ny*t,joint.head_y+ny*r+nx*t,z)
    end
    local sections,materials={},{}
    for index=#jaw_profiles,1,-1 do
        local q=jaw_profiles[index]
        local ring={}
        for i=0,11 do
            local a=math.pi*(i+.5)/6
            ring[i+1]=point(q[2]+jaw_spacing+q[3]*math.cos(a),q[4]*math.sin(a),q[1])
        end
        sections[#sections+1]=ring
        materials[#materials+1]=finger_plastic
    end
    solid(bitmap,sections,materials,true)
    jaw_hook(bitmap,point,angle)
end

-- The three mounts stay 120 degrees apart. Index the tripod so the
-- shafts remain distinguishable from the fixed board camera.
local jaw_heading=math.rad(5)
local jaw_angles={jaw_heading,jaw_heading+2*math.pi/3,jaw_heading+4*math.pi/3}
local function jaws(bitmap,link,joint,opening)
    for _,offset in ipairs(jaw_angles) do
        jaw(bitmap,joint,link.angle+offset,opening)
    end
end
local function artwork_bounds(box,top)
    local x,y,w,h=table.unpack(box)
    top=top or -2
    local height=2590-top
    return emu.render_bounds((x+300)/3600,(y-top)/height,(x+w+300)/3600,(y+h-top)/height)
end

local wrist_plastic={base={43,47,44}, ambient=.43, diffuse=.83, glint=35, power=20}
local wrist_bevel={base={50,54,50}, ambient=.44, diffuse=.82, glint=40, power=20}

local function wrist_shell(bitmap,link,joint)
    local h=link_head_size
    local c,s=link.c,link.s
    local x,y=joint.head_x,joint.head_y*.64
    local outline={}
    local function append(u,v)
        -- Scale in the housing's own plane before rotating around its axis.
        -- The flat side stays normal to the forearm at every heading.
        local along,across=wrist_scale_x*u,.94*wrist_scale_y*v
        outline[#outline+1]={h*(along*c-across*s),h*(along*s+across*c)}
    end
    for i=0,28 do
        local theta=math.pi*(i/28-.5)
        append(.483*math.cos(theta),.475*math.sin(theta))
    end
    -- A short bevel at each end of the flat bearing face leaves a distinct
    -- corner before the curved housing continues around the head.
    local function rear_shoulder(t,sign)
        local q=1-t
        local u=-.10*3*q*q*t-.22*3*q*t*t-.30*t*t*t
        local v=.475*(q*q*q+3*q*q*t)+.473*3*q*t*t+.465*t*t*t
        append(u,sign*v)
    end
    local shoulder_segments=12
    for i=1,shoulder_segments do rear_shoulder(i/shoulder_segments,1) end
    append(-wrist_flat_side,.29)
    append(-wrist_flat_side,-.29)
    for i=shoulder_segments,1,-1 do rear_shoulder(i/shoulder_segments,-1) end

    -- Recess the crown at the bearing while keeping the lower rim and
    -- all three finger pivots on the existing travel and grip calibration.
    local top_z=joint.z-wrist_roof_recess
    local height=wrist_height*h-wrist_roof_recess
    local split=height*.51
    column(bitmap,x,y,top_z-height,{{0,.93,wrist_plastic},{.035*h,1,wrist_plastic},
        {split-.018*h,1,seam},{split-.006*h,.985,seam},{split+.009*h,.985,wrist_plastic},
        {split+.022*h,1,wrist_plastic},{height-.037*h,1,wrist_plastic},
        {height-.014*h,.989,wrist_bevel},{height,.971,wrist_bevel}},outline)
    local lid={}
    for i,point in ipairs(outline) do
        lid[i]=projection(v(x+point[1]*.951,y/.64+point[2]*.951,top_z))
    end
    raster(bitmap,lid,surface(v(0,0,1),wrist_plastic))

    -- A thin visible join follows the cap around its complete circumference.
    -- Drawing it on the top plane keeps the far half readable against the lid.
    column(bitmap,x,y,top_z,{{0,1,seam},{.003*h,1,seam}},circle(.314*h,1))
    column(bitmap,x,y,top_z+.003*h,{{0,.985,seam},{.011*h,1,wrist_plastic},
        {.043*h,.966,wrist_bevel},{(wrist_cap_thickness-.003)*h,.939,wrist_bevel}},circle(.304*h,1))
end

local grip_contact=jaw_hook_depth-wrist_lift+wrist_plane_offset+.026
local function calibrated_link(raw_x,raw_y,has_lift)
    local x,y,size,_,_,park=articulated_pose(raw_x,raw_y)
    local height=has_lift and .65 or .33
    local previous_lift=has_lift and .32*size*(1-park) or 0
    local contact_y=y+(grip_contact-wrist_plane_offset-height*(1-park))*size+previous_lift
    local travel=has_lift and .32*link_head_size/.83 or 0
    local reference_drop=travel*(1-park)
    -- Recover the original contact plane away from the parked position.
    -- Use the original board calibration for X/Y and solve at the new pitch.
    local drop=pedestal_raise*(1-park)-93*park
    local pitch=math.asin(-(reference_drop+drop)/link_length)
    local contact_z=-grip_contact*link_head_size/.83
    return linked_pose(x,contact_y,contact_z-reference_drop,pitch,park),travel,drop
end

