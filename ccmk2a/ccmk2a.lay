<?xml version="1.0"?>
<!--
license:cc0
-->
<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

<element name="novag">
		<image file="ccmk2a.png" />
	</element>

<element name="background">
		<image file="../misc/background.png" />
	</element>




	<element name="black"><rect><color red="0.12" green="0.12" blue="0.12" /></rect></element>
	<element name="black2"><rect><color red="0.16" green="0.16" blue="0.16" /></rect></element>
	<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>
	<element name="red"><rect><color red="0.8" green="0.2" blue="0.25" /></rect></element>

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="hl" defstate="0">
		<text string=" "/>
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>


    <element name="but1" defstate="0">
    <image file="../buttons/down_sel7.png" state="1"/>
	</element>

<element name="but2" defstate="0">
    <image file="../buttons/down_sel.png" state="1"/>
	</element>

<element name="but3" defstate="0">
    <image file="../buttons/down_sel6.png" state="1"/>
	</element>

	<element name="led" defstate="0">
	<image file="../leds/red_sel.png" state="1"/>
	<image file="../leds/red.png" state="0"/>
	</element>



<element name="ledi" defstate="1">
	<image file="../leds/red_sel.png" state="0"/>
	<image file="../leds/red.png" state="1"/>
	</element>

<element name="sound" defstate="0">
	<image file="sound_1.png" state="0"/>
	<image file="sound_0.png" state="1"/>
	</element>


<group name="display">
<!-- digit panel is actually on the left, but that would leave a large empty space in this internal layout -->
		<element name="digit0" ref="digit"><bounds x="3.125"  y="-2" width="4" height="6" /></element>
		<element name="digit1" ref="digit"><bounds x="7.125"  y="-2" width="4" height="6" /></element>
		<element name="digit2" ref="digit"><bounds x="11.125"  y="-2" width="4" height="6" /></element>
		<element name="digit3" ref="digit"><bounds x="15.125" y="-2" width="4" height="6" /></element>

</group>

<!-- build screen -->

	<view name="artwork by luis">
<bounds left="0" right="1600" top="0" bottom="892" />




<element ref="novag">
			<bounds x="0" y="0" width="1600" height="892" />
		</element>

<group ref="display"><bounds x="326" y="182" width="312" height="87" /></group>


		
        <element name="4.0" ref="led"><bounds  x="772" y="192" width="39" height="39" /></element>
		<element name="4.2" ref="led"><bounds  x="870" y="192" width="39" height="39" /></element>
		<element name="4.1" ref="led"><bounds  x="772" y="250" width="39" height="39" /></element>
		<element name="4.1" ref="ledi"><bounds x="870" y="250" width="39" height="39" /></element>
		

		<element ref="sound" inputtag="IN.4" inputmask="0x01"><bounds x="1132" y="422" width="65" height="50" /></element>
		
		




        <element ref="but1" inputtag="RESET" inputmask="0x01"><bounds x="226"  y="402" width="118" height="107" /><color alpha="0.7" /></element>
		<element ref="but1" inputtag="IN.1"  inputmask="0x10"><bounds x="380"  y="402" width="121" height="107" /><color alpha="0.7" /></element>
		<element ref="but2" inputtag="IN.1"  inputmask="0x08"><bounds x="543" y="402" width="252" height="98" /><color alpha="0.7" /></element>
        
		<element ref="but1" inputtag="IN.0" inputmask="0x20"><bounds x="196"  y="588" width="130" height="113" /><color alpha="0.7" /></element>
		<element ref="but1" inputtag="IN.0" inputmask="0x10"><bounds x="363"  y="586" width="130" height="115" /><color alpha="0.7" /></element>
		<element ref="but2" inputtag="IN.0" inputmask="0x08"><bounds x="532" y="585"  width="116" height="112" /><color alpha="0.7" /></element>
		<element ref="but2" inputtag="IN.0" inputmask="0x04"><bounds x="691" y="583"  width="111" height="112" /><color alpha="0.7" /></element>
		<element ref="but3" inputtag="IN.0" inputmask="0x02"><bounds x="840" y="581"  width="126" height="113" /><color alpha="0.7" /></element>
		<element ref="but3" inputtag="IN.0" inputmask="0x01"><bounds x="990" y="578"  width="126" height="109" /><color alpha="0.7" /></element>
		<element ref="but3" inputtag="IN.1" inputmask="0x40"><bounds x="1140" y="578" width="130" height="113" /><color alpha="0.7" /></element>
		<element ref="but3" inputtag="IN.1" inputmask="0x20"><bounds x="1290" y="578" width="130" height="113" /><color alpha="0.7" /></element>



	</view>
</mamelayout>
