<?xml version="1.0"?>
<mamelayout version="2">
<!-- define elements -->

<element name="novag">
		<image file="expert8c.png" />
	</element>

<element name="background">
		<image file="../misc/background4.png" />
	</element>



<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

<element name="led" defstate="0">
	<image file="../leds/red5_sel.png" state="1"/>
	<image file="../leds/red5.png" state="0"/>
	</element>
	
<element name="led2" defstate="0">
	<image file="../leds/red5_sel.png" state="1"/>
	<image file="../leds/red5.png" state="0"/>
	</element>	

<element name="but" defstate="0">
	  <image file="../buttons/but4.png" state="0"/>
      <image file="../buttons/but4_sel.png" state="1"/>
	</element>


<element name="piece" defstate="0">
		<image file="../pieces/pmephisto5/wp.png" state="1"/>
		<image file="../pieces/pmephisto5/wkn.png" state="2"/>
		<image file="../pieces/pmephisto5/wb.png" state="3"/>
		<image file="../pieces/pmephisto5/wr.png" state="4"/>
		<image file="../pieces/pmephisto5/wq.png" state="5"/>
		<image file="../pieces/pmephisto5/wk.png" state="6"/>
		<image file="../pieces/pmephisto5/bp.png" state="7"/>
		<image file="../pieces/pmephisto5/bkn.png" state="8"/>
		<image file="../pieces/pmephisto5/bb.png" state="9"/>
		<image file="../pieces/pmephisto5/br.png" state="10"/>
		<image file="../pieces/pmephisto5/bq.png" state="11"/>
		<image file="../pieces/pmephisto5/bk.png" state="12"/>
		<image file="../pieces/pmephisto5/wp_sel.png" state="13"/>
		<image file="../pieces/pmephisto5/wkn_sel.png" state="14"/>
		<image file="../pieces/pmephisto5/wb_sel.png" state="15"/>
		<image file="../pieces/pmephisto5/wr_sel.png" state="16"/>
		<image file="../pieces/pmephisto5/wq_sel.png" state="17"/>
		<image file="../pieces/pmephisto5/wk_sel.png" state="18"/>
		<image file="../pieces/pmephisto5/bp_sel.png" state="19"/>
		<image file="../pieces/pmephisto5/bkn_sel.png" state="20"/>
		<image file="../pieces/pmephisto5/bb_sel.png" state="21"/>
		<image file="../pieces/pmephisto5/br_sel.png" state="22"/>
		<image file="../pieces/pmephisto5/bq_sel.png" state="23"/>
		<image file="../pieces/pmephisto5/bk_sel.png" state="24"/>
	</element>

<element name="piece_2m" defstate="0">
		<image file="../pieces/chess2/wp.png" state="1"/>
		<image file="../pieces/chess2/wn.png" state="2"/>
		<image file="../pieces/chess2/wb.png" state="3"/>
		<image file="../pieces/chess2/wr.png" state="4"/>
		<image file="../pieces/chess2/wq.png" state="5"/>
		<image file="../pieces/chess2/wk.png" state="6"/>

		<image file="../pieces/chess2/bp.png" state="7"/>
		<image file="../pieces/chess2/bn.png" state="8"/>
		<image file="../pieces/chess2/bb.png" state="9"/>
		<image file="../pieces/chess2/br.png" state="10"/>
		<image file="../pieces/chess2/bq.png" state="11"/>
		<image file="../pieces/chess2/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../pieces/chess2/wp_sel.png" state="13"></image>
		<image file="../pieces/chess2/wn_sel.png" state="14"></image>
		<image file="../pieces/chess2/wb_sel.png" state="15"></image>
		<image file="../pieces/chess2/wr_sel.png" state="16"></image>
		<image file="../pieces/chess2/wq_sel.png" state="17"></image>
		<image file="../pieces/chess2/wk_sel.png" state="18"></image>

		<image file="../pieces/chess2/bp_sel.png" state="19"></image>
		<image file="../pieces/chess2/bn_sel.png" state="20"></image>
		<image file="../pieces/chess2/bb_sel.png" state="21"></image>
		<image file="../pieces/chess2/br_sel.png" state="22"></image>
		<image file="../pieces/chess2/bq_sel.png" state="23"></image>
		<image file="../pieces/chess2/bk_sel.png" state="24"></image>
