		<element ref="hl" inputtag="IN.0" inputmask="0x01"><bounds x="650" y="1011" width="69" height="68" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x40"><bounds x="750" y="1011" width="69" height="68" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x20"><bounds x="847" y="1011" width="69" height="68" /></element>

        <element ref="hl" inputtag="RESET" inputmask="0x01"><bounds x="205" y="887" width="69" height="71" /></element>
