	<image file="../botones/button.png" state="0"/>
	</element>
	
	
	
	<element name="led" defstate="0">
	<image file="../leds/red1_h.png" state="1"/>
	</element>
	
	<element name="ledv" defstate="0">
	<image file="../leds/redv_sel.png" state="1"/>
	</element>
	
	<element name="button" defstate="0">
	<image file="../botones/button2_sel.png" state="1"/>
	<image file="../botones/button.png" state="0"/>
	</element>

<element name="sym_colon">
		<rect><color red="0.541" green="0.573" blue="0.58" /></rect>
		<text state="0" string=":"> <color red="0.49412" green="0.51765" blue="0.51765" /></text>
		<text state="1" string=":"> <color red="0.2" green="0.16" blue="0.16" /></text>
	</element>
	<element name="sym_left">
		<rect><color red="0.541" green="0.573" blue="0.58" /></rect>
		<text state="0" string="&#x2190;">  <color red="0.49412" green="0.51765" blue="0.51765" /></text>
		<text state="1" string="&#x2190;">  <color red="0.2" green="0.16" blue="0.16" /></text>
	</element>
	<element name="sym_right">
		<rect><color red="0.541" green="0.573" blue="0.58" /></rect>
		<text state="0" string="&#x2192;">  <color red="0.49412" green="0.51765" blue="0.51765" /></text>
		<text state="1" string="&#x2192;">  <color red="0.2" green="0.16" blue="0.16" /></text>
	</element>
