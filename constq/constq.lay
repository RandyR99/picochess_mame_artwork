<group ref="sb_board"><bounds x="3.2" y="3.2" width="79.8" height="79.8" /></group>
<element ref="sbui_png"><bounds x="-15.5" y="3" width="10" height="80" /></element>
	   <group ref="sb_ui"><bounds x="-15.5" y="3" width="10" height="80" /></group>




		<element name="0.0" ref="ledg_v"><bounds x="92" y="24.03" width="1.8" height="2.9" /></element>
