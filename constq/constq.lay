<?xml version="1.0"?>
<mamelayout version="2">




<!-- define elements -->

	<element name="cforteq">
		<image file="quattro2a.png" />
	</element>

<element name="background">
		<image file="../misc/background4.png" />
	</element>

<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

<element name="static_red"><rect><color red="0.7" green="0.13" blue="0.12" /></rect></element>
	<element name="white"><rect><color red="0.81" green="0.8" blue="0.79" /></rect></element>
	<element name="lcd_bg"><rect><color red="0.54" green="0.57" blue="0.58" /></rect></element>

	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>
	<element name="seg_m" defstate="0">
		<rect><color red="0.54" green="0.57" blue="0.58" /></rect>
		<text state="1" string="m"><color red="0.2" green="0.16" blue="0.16" /></text>
		<text state="0" string="m"><color red="0.49412" green="0.51765" blue="0.51765" /></text>
	</element>
	<element name="seg_ap" defstate="0">
		<rect><color red="0.54" green="0.57" blue="0.58" /></rect>
		<text state="1" string="'"><color red="0.2" green="0.16" blue="0.16" /></text>
		<text state="0" string="'"><color red="0.49412" green="0.51765" blue="0.51765" /></text>
	</element>

		<element name="ledr_h" defstate="0">
	<image file="../leds/red_h_sel.png" state="1"/>
	<image file="../leds/red_h.png" state="0"/>
	</element>

	<element name="ledr_v" defstate="0">
	<image file="../leds/red_v_sel.png" state="1"/>
	<image file="../leds/red_v.png" state="0"/>
	</element>

	<element name="ledg_v" defstate="0">
	<image file="../leds/green_v_sel.png" state="1"/>
	<image file="../leds/green_v.png" state="0"/>
	</element>

	<element name="hl" defstate="0">
	</element>

	<element name="btwhite" defstate="0">
	<image file="../cfortea/bwhite.png" state="0"/>
      <image file="../cfortea/bwhite_sel.png" state="1"/>
	</element>

	<element name="but" defstate="0">
	<image file="../cfortea/but.png" state="0"/>
    <image file="../cfortea/but_sel.png" state="1"/>
	</element>

     <element name="but_b" defstate="0">
	<image file="../cfortea/but_b.png" state="0"/>
      <image file="../cfortea/but_b_sel.png" state="1"/>
	</element>

	<element name="but_king" defstate="0">
	<image file="but_king.png" state="0"/>
    <image file="butk_sel.png" state="1"/>
	</element>

	<element name="but_queen" defstate="0">
	<image file="but_queen.png" state="0"/>
    <image file="butq_sel.png" state="1"/>
	</element>

	<element name="but_bishop" defstate="0">
	<image file="but_bishop.png" state="0"/>
      <image file="butb_sel.png" state="1"/>
	</element>

	<element name="but_knight" defstate="0">
	<image file="but_knight.png" state="0"/>
      <image file="butkn_sel.png" state="1"/>
	</element>

	<element name="but_rook" defstate="0">
	<image file="but_rook.png" state="0"/>
      <image file="butr_sel.png" state="1"/>
	</element>

	<element name="but_pawn" defstate="0">
	<image file="but_pawn.png" state="0"/>
      <image file="butp_sel.png" state="1"/>
	</element>

	

	<element name="hlb" defstate="0">
		<text string=" ">
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<disk state="1">
			<bounds x="0.2466" y="0.12" width="0.5066" height="0.76" />
			<color red="1.0" green="1.0" blue="1.0" />
		</disk>
	</element>

	

<!-- sb board -->

	<element name="cblack"><rect><color red="0.41" green="0.4" blue="0.39" /></rect></element>
	<element name="cwhite"><rect><color red="0.81" green="0.8" blue="0.79" /></rect></element>

	<element name="hlbb" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk>
	</element>

<element name="piece" defstate="0">
		<image file="../pieces/pnovag_plastic/wp.png" state="1"/>
		<image file="../pieces/pnovag_plastic/wkn.png" state="2"/>
		<image file="../pieces/pnovag_plastic/wb.png" state="3"/>
		<image file="../pieces/pnovag_plastic/wr.png" state="4"/>
