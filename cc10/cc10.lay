<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

<element name="fidelity">
		<image file="cc10.jpg" />
	</element>

	<element name="static_gray"><rect><color red="0.6" green="0.6" blue="0.6" /></rect></element>

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="led" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		
	</element>

<element name="hl" defstate="0">
		<text string=" "/>
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	


<!-- build screen -->

		<view name="artwork by luis">
		<bounds left="0" right="1600" top="0" bottom="938" />

	<element ref="fidelity">
		
			<bounds x="0" y="0" width="1600" height="938" />
		</element>

	<!-- 7segs/leds -->

		
		<element name="4.a" ref="led"><bounds x="1010" y="334" width="17" height="17" /></element>
		<element name="5.a" ref="led"><bounds x="1159" y="334" width="17" height="17" /></element>

		

		<element name="digit0" ref="digit"><bounds x="1031" y="366" width="38" height="57" /></element>
		<element name="digit1" ref="digit"><bounds x="1091" y="366" width="38" height="57" /></element>
		<element name="digit2" ref="digit"><bounds x="1180" y="366" width="38" height="57" /></element>
		<element name="digit3" ref="digit"><bounds x="1240" y="366" width="38" height="57" /></element>

	<!-- button panel -->

		

	   <element ref="hl" inputtag="RESET" inputmask="0x01"><bounds x="1010" y="499" width="67" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x01"><bounds x="1082" y="499" width="67" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x01"><bounds x="1156" y="499" width="67" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x01"><bounds x="1229" y="499" width="67" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x02"><bounds x="1012" y="573" width="68" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x02"><bounds x="1084" y="573" width="68" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x02"><bounds x="1156" y="573" width="68" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x02"><bounds x="1229" y="573" width="68" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x04"><bounds x="1012" y="646" width="70" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x04"><bounds x="1084" y="646" width="70" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x04"><bounds x="1156" y="646" width="70" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x04"><bounds x="1229" y="646" width="70" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x08"><bounds x="1012" y="722" width="72" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x08"><bounds x="1084" y="722" width="72" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x08"><bounds x="1156" y="722" width="72" height="55" /><color alpha="0.2" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x08"><bounds x="1229" y="722" width="72" height="55" /><color alpha="0.2" /></element>

	</view>
</mamelayout>
