<?xml version="1.0"?>
<!--
license:cc0
-->
<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

<element name="intel02">
		<image file="intel02.png" />
	</element>

<element name="intel02a">
		<image file="intel02_eng.png" />
	</element>

 


<element name="fondo">
		<image file="../varios/fondo4.png" />
	</element>




<element name="button" defstate="0">
	<image file="../botones/down_sel2.png" state="1"/>
	
	</element>

<element name="led" defstate="0">
		<image file="../leds/rojo_1a.png" state="1"/>
		
	</element>

	

	<element name="digit" defstate="0">
		<led7seg><color red="0" green="1" blue="0" /></led7seg>
	</element>

	

	


<!-- build screen -->
<view name="russian artwork by luis">
<bounds left="0" right="1100" top="0" bottom="874" />
	
<element ref="fondo">
			<bounds x="0" y="0" width="1100" height="874" />
		</element>	
	
	
	<element ref="intel02">
			<bounds left="0" right="1100" top="0" bottom="874" />
		</element>
	
	<element name="5.a" ref="led"><bounds x="255" y="728" width="18" height="18" /></element>
		<element name="4.a" ref="led"><bounds x="249" y="772" width="18" height="18" /></element>
	
	
	<!-- display -->

		<element name="digit0" ref="digit"><bounds x="300" y="746" width="20" height="30" /></element>
		<element name="digit1" ref="digit"><bounds x="336" y="746" width="20" height="30" /></element>
		<element name="digit2" ref="digit"><bounds x="417" y="746" width="20" height="30" /></element>
		<element name="digit3" ref="digit"><bounds x="452" y="746" width="20" height="30" /></element>


		

	<!-- buttons -->

	<element ref="button" inputtag="RESET" inputmask="0x01"><bounds x="537" y="707" width="40" height="26" /></element>
		<element ref="button" inputtag="IN.1" inputmask="0x04"><bounds x="594" y="707" width="40" height="26" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0008"><bounds x="652" y="707" width="40" height="26" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x2000"><bounds x="713" y="707" width="40" height="26" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x1000"><bounds x="772" y="707" width="40" height="26" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0800"><bounds x="833" y="707" width="40" height="26" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0400"><bounds x="891" y="707" width="40" height="26" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0200"><bounds x="948" y="707" width="40" height="26" /></element>

		<element ref="button" inputtag="IN.1" inputmask="0x02"><bounds x="537" y="756" width="44" height="28" /></element>
		<element ref="button" inputtag="IN.1" inputmask="0x08"><bounds x="595" y="756" width="44" height="28" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0010"><bounds x="656" y="756" width="44" height="28" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0100"><bounds x="719" y="756" width="44" height="28" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0080"><bounds x="777" y="756" width="44" height="28" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0040"><bounds x="841" y="756" width="44" height="28" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x0020"><bounds x="898" y="756" width="44" height="28" /></element>
		<element ref="button" inputtag="IN.0" inputmask="0x4000"><bounds x="956" y="756" width="44" height="28" /></element>
		

		

		

		

	</view>
	
