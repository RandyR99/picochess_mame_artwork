<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />

		

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-5.3" increment="10" />
			<param name="i" start="8" increment="-1" />
            <param name="z" start="0" increment="10" />


			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_m"><bounds x="-2.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_b~i~" ref="piece_m"><bounds  x="7.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_c~i~" ref="piece_m"><bounds x="17.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_d~i~" ref="piece_m"><bounds x="27.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_e~i~" ref="piece_m"><bounds x="37.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_f~i~" ref="piece_m"><bounds x="47.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_g~i~" ref="piece_m"><bounds x="57.5" y="~y~" width="15" height="15" /></element>
			<element name="piece_h~i~" ref="piece_m"><bounds x="67.5" y="~y~" width="15" height="15" /></element>
		</repeat>
	</group>	

<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

		
		<!-- leds -->
		

		<!-- sensors, pieces -->
		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="1.1" increment="10" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>



			<element name="piece_a~i~" ref="pflat"><bounds x="0.8" y="~y~" width="8" height="8" /></element>
			<element name="piece_b~i~" ref="pflat"><bounds x="10.8" y="~y~"  width="8" height="8" /></element>
			<element name="piece_c~i~" ref="pflat"><bounds x="20.8" y="~y~" width="8" height="8" /></element>
			<element name="piece_d~i~" ref="pflat"><bounds x="30.8" y="~y~" width="8" height="8" /></element>
			<element name="piece_e~i~" ref="pflat"><bounds x="40.8" y="~y~" width="8" height="8" /></element>
			<element name="piece_f~i~" ref="pflat"><bounds x="50.8" y="~y~" width="8" height="8" /></element>
			<element name="piece_g~i~" ref="pflat"><bounds x="60.8" y="~y~" width="8" height="8" /></element>
			<element name="piece_h~i~" ref="pflat"><bounds x="70.8" y="~y~" width="8" height="8" /></element>
		</repeat>
	</group>

<!-- sb ui -->

<element name="cwhite_m"><rect><color red="0.9" green="0.9" blue="0.9" /></rect></element>
	<element name="cblack_m"><rect><color red="0.4" green="0.4" blue="0.4" /></rect></element>


<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>


	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uit1"><text string="S.BOARD"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uit2"><text string="INTERFACE"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib1"><text string="BOARD:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib2">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="RESET"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uib3">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="CLEAR"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uis1"><text string="SPAWN"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih1"><text string="HAND::"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih2">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="REMOVE"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu1"><text string="UNDO:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu2a">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &lt;&lt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2b">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &lt;  "><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2c">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="   &gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2d">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &gt;&gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui"><bounds x="0" y="0" width="10" height="80" />
		

		<!-- board -->
		

