<element ref="sbui_png"><bounds x="-11" y="2" width="12" height="96" /></element>
		<group ref="sb_ui"><bounds x="-11" y="2" width="12" height="96" /></group>

<!-- chessboard leds -->

		<element name="0.15" ref="led3"><bounds x="20.7" y="31.3"  width="2.9" height="2.8" /></element>
		<element name="1.15" ref="led3"><bounds x="28.8" y="31.3"  width="2.9" height="2.8" /></element>
