<mamelayout version="2">

<!-- NOTE: no chesspieces simulation here -->

<!-- define elements -->

<element name="fidelity">
		<image file="../vcc/vcc.jpg" />
	</element>

<element name="advanced">
		<image file="advanced.png" />
	</element>

	<element name="static_gray"><rect><color red="0.6" green="0.6" blue="0.6" /></rect></element>

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="led" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		
	</element>

<element name="hl" defstate="0">
		<text string=" "/>
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>




<!-- build screen -->

		<view name="Artwork by Luis">
		<bounds left="0" right="1509" top="0" bottom="888" />

	<element ref="fidelity">
		
			<bounds x="0" y="0" width="1509" height="888" />
		</element>
		
		<element ref="advanced">
		
			<bounds x="1040" y="110" width="260" height="35" />
		</element>

	<!-- 7segs/leds -->

		
		<element name="1.7" ref="led"><bounds x="1156" y="349" width="10" height="10" /></element>
		<element name="0.7" ref="led"><bounds x="1154" y="382" width="10" height="10" /></element>

		

		<element name="digit0" ref="digit"><bounds x="1039" y="339" width="50" height="62" /></element>
		<element name="digit1" ref="digit"><bounds x="1099" y="339" width="50" height="62" /></element>
		<element name="digit2" ref="digit"><bounds x="1170" y="339" width="50" height="62" /></element>
		<element name="digit3" ref="digit"><bounds x="1230" y="339" width="50" height="62" /></element>

	<!-- button panel -->

	

	    <element ref="hl" inputtag="RESET" inputmask="0x01"><bounds x="1021" y="479" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x01"><bounds x="1098" y="479" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x01"><bounds x="1175" y="479" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x01"><bounds x="1253" y="479" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x02"><bounds x="1021" y="548" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x02"><bounds x="1098" y="548" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x02"><bounds x="1175" y="548" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x02"><bounds x="1253" y="548" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x04"><bounds x="1021" y="620" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x04"><bounds x="1098" y="620" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x04"><bounds x="1175" y="620" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x04"><bounds x="1253" y="620" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.0" inputmask="0x08"><bounds x="1021" y="693" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.1" inputmask="0x08"><bounds x="1098" y="693" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.2" inputmask="0x08"><bounds x="1175" y="693" width="62" height="44" /><color alpha="0.40" /></element>
		<element ref="hl" inputtag="IN.3" inputmask="0x08"><bounds x="1253" y="693" width="64" height="44" /><color alpha="0.40" /></element>

	</view>
</mamelayout>
