<?xml version="1.0"?>
<mamelayout version="2">


<element name="esb">
		<image file="../mephisto2e/esb2.png" />
	</element>
        <element name="modular">
		<image file="../mephisto2e/modular3.png" />
	</element>

<!-- foto:mythbuster-->   

     <element name="modulo">
		<image file="mephistoiiig.png" />
	</element>

<element name="fondo_madera">
		<image file="../varios/fondo4.png" />
	</element>

<element name="sbui_png">
		<image file="../varios/clipboard09b.png" />
	</element>

<element name="sbui_e_png">
		<image file="../varios/clipboard09b.png" />
	</element>




<!-- define elements -->

	<element name="led" defstate="0">
	<image file="../leds/red4_sel.png" state="1"/>
	<image file="../leds/red4.png" state="0"/>
</element>



<element name="ledg" defstate="0">
		<image file="../leds/verde_0.png" state="0"/>
	    <image file="../leds/verde_1.png" state="1"/>
	</element>

<element name="led_m" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	    <image file="../leds/gris.png" state="0"/>
</element>



<!-- display -->

	

	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>


	<group name="display">
		<bounds x="31" y="90.3" width="22.5" height="7.4" />

		

		<element name="digit3" ref="digit"><bounds x="32" y="91" width="4" height="6" /></element>
		<element name="digit2" ref="digit"><bounds x="37.5" y="91" width="4" height="6" /></element>
		<element name="digit1" ref="digit"><bounds x="43" y="91" width="4" height="6" /></element>
		<element name="digit0" ref="digit"><bounds x="48.5" y="91" width="4" height="6" /></element>

		
	</group>


<!-- buttons -->

	<element name="hlb" defstate="0">
		<rect state="1"><color red="1" green="1" blue="1" /></rect>
	</element>

	<group name="buttons">
		<bounds x="0" y="0" width="18.7" height="23.7" />

		<element ref="hlb" inputtag="IN.0" inputmask="0x01"><bounds x="0.1"  y="5.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- cl -->
		<element ref="hlb" inputtag="IN.2" inputmask="0x01"><bounds x="5.1"  y="5.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- pos -->
		<element ref="hlb" inputtag="IN.1" inputmask="0x04"><bounds x="10.1" y="5.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- lev -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x04"><bounds x="15.1" y="5.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- mem -->
		<element ref="hlb" inputtag="RESET" inputmask="0x01"><bounds x="15.1" y="0.1" width="3.5" height="3.5" /><color alpha="0.1" /></element>

		<element ref="hlb" inputtag="IN.0" inputmask="0x02"><bounds x="0.1"  y="10.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- a1 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x08"><bounds x="5.1"  y="10.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- b2 -->
		<element ref="hlb" inputtag="IN.1" inputmask="0x02"><bounds x="10.1" y="10.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- c3 -->
		<element ref="hlb" inputtag="IN.1" inputmask="0x01"><bounds x="15.1" y="10.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- info -->

		<element ref="hlb" inputtag="IN.1" inputmask="0x08"><bounds x="0.1"  y="15.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- d4 -->
		<element ref="hlb" inputtag="IN.2" inputmask="0x02"><bounds x="5.1"  y="15.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- e5 -->
		<element ref="hlb" inputtag="IN.2" inputmask="0x08"><bounds x="10.1" y="15.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- f6 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x04"><bounds x="15.1" y="15.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- ent -->

		<element ref="hlb" inputtag="IN.3" inputmask="0x02"><bounds x="0.1"  y="20.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- g7 -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x08"><bounds x="5.1"  y="20.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- h7 -->
		<element ref="hlb" inputtag="IN.2" inputmask="0x04"><bounds x="10.1" y="20.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- 9 -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x01"><bounds x="15.1" y="20.1" width="3.5" height="3.5" /><color alpha="0.1" /></element> <!-- 0 -->
	</group>


<!-- brikett -->

	<element name="gray"><rect><color red="0.21" green="0.2" blue="0.2" /></rect></element>

	<group name="brikett">
		<bounds x="16.5" y="6" width="58.5" height="32" />
                <element ref="modulo"><bounds x="17.5" y="2.9" width="58.3" height="37.3" /></element>
		
		<group ref="display"><bounds x="24.4" y="15.4" width="15.2" height="6.4" /></group>
		<group ref="buttons"><bounds x="50" y="9.5" width="19.5" height="26.3" /></group>
	</group>


<!-- sb board -->

	<element name="cwhite_m"><rect><color red="0.9" green="0.9" blue="0.9" /></rect></element>
	<element name="cblack_m"><rect><color red="0.4" green="0.4" blue="0.4" /></rect></element>


     <element name="cblack"><rect><color red="0.56" green="0.33" blue="0.12" /></rect></element>
	<element name="cwhite"><rect><color red="0.84" green="0.75" blue="0.50" /></rect></element>

	<element name="hlbb" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk>
	</element>


<element name="piece_e" defstate="0">
		<image file="../piezas/pmephisto3/wp.png" state="1"/>
		<image file="../piezas/pmephisto3/wkn.png" state="2"/>
		<image file="../piezas/pmephisto3/wb.png" state="3"/>
		<image file="../piezas/pmephisto3/wr.png" state="4"/>
		<image file="../piezas/pmephisto3/wq.png" state="5"/>
		<image file="../piezas/pmephisto3/wk.png" state="6"/>
		<image file="../piezas/pmephisto3/bp.png" state="7"/>
		<image file="../piezas/pmephisto3/bkn.png" state="8"/>
		<image file="../piezas/pmephisto3/bb.png" state="9"/>
		<image file="../piezas/pmephisto3/br.png" state="10"/>
		<image file="../piezas/pmephisto3/bq.png" state="11"/>
		<image file="../piezas/pmephisto3/bk.png" state="12"/>
