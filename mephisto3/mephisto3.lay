		<image file="../piezas/pmephisto3/wkn_sel.png" state="14"/>
		<image file="../piezas/pmephisto3/wb_sel.png" state="15"/>
		<image file="../piezas/pmephisto3/wr_sel.png" state="16"/>
		<image file="../piezas/pmephisto3/wq_sel.png" state="17"/>
		<image file="../piezas/pmephisto3/wk_sel.png" state="18"/>
		<image file="../piezas/pmephisto3/bp_sel.png" state="19"/>
		<image file="../piezas/pmephisto3/bkn_sel.png" state="20"/>
		<image file="../piezas/pmephisto3/bb_sel.png" state="21"/>
		<image file="../piezas/pmephisto3/br_sel.png" state="22"/>
		<image file="../piezas/pmephisto3/bq_sel.png" state="23"/>
		<image file="../piezas/pmephisto3/bk_sel.png" state="24"/>
	</element>


<element name="piece_m" defstate="0">
		<image file="../piezas/pfidelity_plastico2/wp.png" state="1"/>
		<image file="../piezas/pfidelity_plastico2/wkn.png" state="2"/>
		<image file="../piezas/pfidelity_plastico2/wb.png" state="3"/>
		<image file="../piezas/pfidelity_plastico2/wr.png" state="4"/>
		<image file="../piezas/pfidelity_plastico2/wq.png" state="5"/>
		<image file="../piezas/pfidelity_plastico2/wk.png" state="6"/>
		<image file="../piezas/pfidelity_plastico2/bp.png" state="7"/>
		<image file="../piezas/pfidelity_plastico2/bkn.png" state="8"/>
		<image file="../piezas/pfidelity_plastico2/bb.png" state="9"/>
		<image file="../piezas/pfidelity_plastico2/br.png" state="10"/>
		<image file="../piezas/pfidelity_plastico2/bq.png" state="11"/>
		<image file="../piezas/pfidelity_plastico2/bk.png" state="12"/>
		<image file="../piezas/pfidelity_plastico2/wp_sel.png" state="13"/>
		<image file="../piezas/pfidelity_plastico2/wkn_sel.png" state="14"/>
		<image file="../piezas/pfidelity_plastico2/wb_sel.png" state="15"/>
