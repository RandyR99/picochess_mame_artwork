<?xml version="1.0"?>
<mamelayout version="2">
<!-- define elements -->
<element name="mephisto">
		<image file="mirage_modular4a.png" />
	</element>

<element name="led" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	    <image file="../leds/gris.png" state="0"/>
</element>

	<element name="hidew" defstate="0">
		<rect state="0"><color red="0.81" green="0.8" blue="0.79" /></rect>
	</element>
	<element name="hideb" defstate="0">
		<rect state="0"><color red="0.41" green="0.4" blue="0.39" /></rect>
	</element>

<element name="fondo_gris">
		<image file="../varios/fondo4.png" />
	</element>

<element name="sbui_png">
		<image file="../varios/clipboard09b.png" />
	</element>


	<element name="hlb" defstate="0">
		<rect state="0">
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
	</element>

	

	<element name="piece" defstate="0">
		<image file="../piezas/pfidelity_plastico2/wp.png" state="1"/>
		<image file="../piezas/pfidelity_plastico2/wkn.png" state="2"/>
		<image file="../piezas/pfidelity_plastico2/wb.png" state="3"/>
		<image file="../piezas/pfidelity_plastico2/wr.png" state="4"/>
		<image file="../piezas/pfidelity_plastico2/wq.png" state="5"/>
		<image file="../piezas/pfidelity_plastico2/wk.png" state="6"/>
		<image file="../piezas/pfidelity_plastico2/bp.png" state="7"/>
		<image file="../piezas/pfidelity_plastico2/bkn.png" state="8"/>
		<image file="../piezas/pfidelity_plastico2/bb.png" state="9"/>
		<image file="../piezas/pfidelity_plastico2/br.png" state="10"/>
		<image file="../piezas/pfidelity_plastico2/bq.png" state="11"/>
		<image file="../piezas/pfidelity_plastico2/bk.png" state="12"/>
		<image file="../piezas/pfidelity_plastico2/wp_sel.png" state="13"/>
		<image file="../piezas/pfidelity_plastico2/wkn_sel.png" state="14"/>
		<image file="../piezas/pfidelity_plastico2/wb_sel.png" state="15"/>
		<image file="../piezas/pfidelity_plastico2/wr_sel.png" state="16"/>
		<image file="../piezas/pfidelity_plastico2/wq_sel.png" state="17"/>
		<image file="../piezas/pfidelity_plastico2/wk_sel.png" state="18"/>
		<image file="../piezas/pfidelity_plastico2/bp_sel.png" state="19"/>
		<image file="../piezas/pfidelity_plastico2/bkn_sel.png" state="20"/>
		<image file="../piezas/pfidelity_plastico2/bb_sel.png" state="21"/>
		<image file="../piezas/pfidelity_plastico2/br_sel.png" state="22"/>
		<image file="../piezas/pfidelity_plastico2/bq_sel.png" state="23"/>
		<image file="../piezas/pfidelity_plastico2/bk_sel.png" state="24"/>
	</element>

	<element name="piece_2m" defstate="0">
	     <image file="../piezas/chess2/wp.png" state="1"/>
		<image file="../piezas/chess2/wn.png" state="2"/>
		<image file="../piezas/chess2/wb.png" state="3"/>
		<image file="../piezas/chess2/wr.png" state="4"/>
		<image file="../piezas/chess2/wq.png" state="5"/>
		<image file="../piezas/chess2/wk.png" state="6"/>

		<image file="../piezas/chess2/bp.png" state="7"/>
		<image file="../piezas/chess2/bn.png" state="8"/>
		<image file="../piezas/chess2/bb.png" state="9"/>
		<image file="../piezas/chess2/br.png" state="10"/>
		<image file="../piezas/chess2/bq.png" state="11"/>
		<image file="../piezas/chess2/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../piezas/chess2/wp.png" state="13"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/wn.png" state="14"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/wb.png" state="15"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/wr.png" state="16"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/wq.png" state="17"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/wk.png" state="18"><color alpha="0.5" /></image>

		<image file="../piezas/chess2/bp.png" state="19"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/bn.png" state="20"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/bb.png" state="21"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/br.png" state="22"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/bq.png" state="23"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/bk.png" state="24"><color alpha="0.5" /></image>
	</element>



<!-- sb board -->

<element name="cwhite_m"><rect><color red="0.9" green="0.9" blue="0.9" /></rect></element>
	<element name="cblack_m"><rect><color red="0.4" green="0.4" blue="0.4" /></rect></element>


	<element name="cblack"><rect><color red="0.56" green="0.33" blue="0.12" /></rect></element>
	<element name="cwhite"><rect><color red="0.84" green="0.75" blue="0.50" /></rect></element>

	<element name="hlbb" defstate="0">
	</element>

	<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />

		
			<!-- leds -->
		<repeat count="8">
			<param name="x" start="8" increment="10" />
			<param name="la" start="0" increment="1" />
			<param name="lb" start="8" increment="1" />
			<param name="lc" start="16" increment="1" />
			<param name="ld" start="24" increment="1" />
			<param name="le" start="32" increment="1" />
			<param name="lf" start="40" increment="1" />
			<param name="lg" start="48" increment="1" />
			<param name="lh" start="56" increment="1" />

			<element name="led~la~" ref="led"><bounds x="~x~" y="78.3" width="1.20" height="1.20" /></element>
			<element name="led~lb~" ref="led"><bounds x="~x~" y="68.3" width="1.20" height="1.20" /></element>
			<element name="led~lc~" ref="led"><bounds x="~x~" y="58.3" width="1.20" height="1.20" /></element>
			<element name="led~ld~" ref="led"><bounds x="~x~" y="48.3" width="1.20" height="1.20" /></element>
			<element name="led~le~" ref="led"><bounds x="~x~" y="38.3" width="1.20" height="1.20" /></element>
			<element name="led~lf~" ref="led"><bounds x="~x~" y="28.3" width="1.20" height="1.20" /></element>
			<element name="led~lg~" ref="led"><bounds x="~x~" y="18.3" width="1.20" height="1.20" /></element>
			 <element name="led~lh~" ref="led"><bounds x="~x~" y="8.3" width="1.20" height="1.20" /></element>
		</repeat>


		<repeat count="4">
			<param name="y1" start="8.3" increment="20" />
			<param name="y2" start="18.3" increment="20" />

			<repeat count="4">
				<param name="x1" start="8.3" increment="20" />
				<param name="x2" start="18.3" increment="20" />
				<element ref="hidew" inputtag="fake" inputmask="0x01" inputraw="yes"><bounds x="~x1~" y="~y1~" width="0" height="0" /></element>
				<element ref="hidew" inputtag="fake" inputmask="0x01" inputraw="yes"><bounds x="~x2~" y="~y2~" width="0" height="0" /></element>
				<element ref="hideb" inputtag="fake" inputmask="0x01" inputraw="yes"><bounds x="~x1~" y="~y2~" width="0" height="0" /></element>
				<element ref="hideb" inputtag="fake" inputmask="0x01" inputraw="yes"><bounds x="~x2~" y="~y1~" width="0" height="0" /></element>
			</repeat>
		</repeat>

		<!-- sensors -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
		</repeat>


		<!-- pieces -->
		<repeat count="8">
			<param name="y" start="-7" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element name="piece_a~i~" ref="piece"><bounds x="-2.99"  y="~y~" width="16" height="16" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="7.1" y="~y~" width="16" height="16" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="17.1" y="~y~" width="16" height="16" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="27.1" y="~y~" width="16" height="16" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="37.1" y="~y~" width="16" height="16" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="47.1" y="~y~" width="16" height="16" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="57.1" y="~y~" width="16" height="16" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="67.1" y="~y~" width="16" height="16" /></element>
		</repeat>
</group>


<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

		
				<!-- leds -->
			<repeat count="8">
			<param name="x" start="8" increment="10" />
			<param name="la" start="0" increment="1" />
			<param name="lb" start="8" increment="1" />
			<param name="lc" start="16" increment="1" />
			<param name="ld" start="24" increment="1" />
			<param name="le" start="32" increment="1" />
			<param name="lf" start="40" increment="1" />
			<param name="lg" start="48" increment="1" />
			<param name="lh" start="56" increment="1" />

			<element name="led~la~" ref="led"><bounds x="~x~" y="78.3" width="1.20" height="1.20" /></element>
			<element name="led~lb~" ref="led"><bounds x="~x~" y="68.3" width="1.20" height="1.20" /></element>
			<element name="led~lc~" ref="led"><bounds x="~x~" y="58.3" width="1.20" height="1.20" /></element>
			<element name="led~ld~" ref="led"><bounds x="~x~" y="48.3" width="1.20" height="1.20" /></element>
			<element name="led~le~" ref="led"><bounds x="~x~" y="38.3" width="1.20" height="1.20" /></element>
			<element name="led~lf~" ref="led"><bounds x="~x~" y="28.3" width="1.20" height="1.20" /></element>
			<element name="led~lg~" ref="led"><bounds x="~x~" y="18.3" width="1.20" height="1.20" /></element>
			 <element name="led~lh~" ref="led"><bounds x="~x~" y="8.3" width="1.20" height="1.20" /></element>
		</repeat>


		<repeat count="4">
			<param name="y1" start="8.3" increment="20" />
			<param name="y2" start="18.3" increment="20" />

			<repeat count="4">
				<param name="x1" start="8.3" increment="20" />
				<param name="x2" start="18.3" increment="20" />
				<element ref="hidew" inputtag="fake" inputmask="0x01" inputraw="yes"><bounds x="~x1~" y="~y1~" width="0" height="0" /></element>
				<element ref="hidew" inputtag="fake" inputmask="0x01" inputraw="yes"><bounds x="~x2~" y="~y2~" width="0" height="0" /></element>
				<element ref="hideb" inputtag="fake" inputmask="0x01" inputraw="yes"><bounds x="~x1~" y="~y2~" width="0" height="0" /></element>
				<element ref="hideb" inputtag="fake" inputmask="0x01" inputraw="yes"><bounds x="~x2~" y="~y1~" width="0" height="0" /></element>
			</repeat>
		</repeat>

		<!-- sensors -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
		</repeat>


		
		<!-- pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element name="piece_a~i~" ref="piece_2m"><bounds x="0"  y="~y~" width="9.3" height="9.3" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10" y="~y~" width="9.3" height="9.3" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20" y="~y~" width="9.3" height="9.3" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30" y="~y~" width="9.3" height="9.3" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40.4" y="~y~" width="9.3" height="9.3" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50" y="~y~" width="9.3" height="9.3" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60" y="~y~" width="9.3" height="9.3" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70" y="~y~" width="9.3" height="9.3" /></element>
		</repeat>
	</group>





<!-- sb ui -->

	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui">
		<bounds x="0" y="0" width="10" height="80" />
		
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- spawn -->
		

		<element name="piece_ui1" ref="piece_2m"><bounds x="1.4" y="23" width="3.8" height="3.8" /></element>
		<element name="piece_ui2" ref="piece_2m"><bounds x="1.4" y="27" width="3.8" height="3.8" /></element>
		<element name="piece_ui3" ref="piece_2m"><bounds x="1.4" y="31" width="3.8" height="3.8" /></element>
		<element name="piece_ui4" ref="piece_2m"><bounds x="4.8" y="23" width="3.8" height="3.8" /></element>
		<element name="piece_ui5" ref="piece_2m"><bounds x="4.8" y="27" width="3.8" height="3.8" /></element>
		<element name="piece_ui6" ref="piece_2m"><bounds x="4.8" y="31" width="3.8" height="3.8" /></element>
		<element name="piece_ui7" ref="piece_2m"><bounds x="1.4" y="36" width="3.8" height="3.8" /></element>
		<element name="piece_ui8" ref="piece_2m"><bounds x="1.4" y="40" width="3.8" height="3.8" /></element>
		<element name="piece_ui9" ref="piece_2m"><bounds x="1.4" y="43.7" width="3.8" height="3.8" /></element>
		<element name="piece_ui10" ref="piece_2m"><bounds x="4.8" y="36" width="3.8" height="3.8" /></element>
		<element name="piece_ui11" ref="piece_2m"><bounds x="4.8" y="40" width="3.8" height="3.8" /></element>
		<element name="piece_ui12" ref="piece_2m"><bounds x="4.8" y="43.7" width="3.8" height="3.8" /></element>

		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0001"><bounds x="1" y="23" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0002"><bounds x="1" y="27" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0004"><bounds x="1" y="31" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0008"><bounds x="4.9" y="23" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0010"><bounds x="4.9" y="27" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0020"><bounds x="4.9" y="31" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0040"><bounds x="1" y="36" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0080"><bounds x="1" y="40" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0100"><bounds x="1" y="43.7" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0200"><bounds x="4.9" y="36" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0400"><bounds x="4.9" y="40" width="3.8" height="3.8" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:SPAWN" inputmask="0x0800"><bounds x="4.9" y="43.7" width="3.8" height="3.8" /><color alpha="0.25" /></element>

		<!-- HAND: -->
		
		<element name="piece_ui0" ref="piece_2m"><bounds x="2" y="52.8" width="6" height="6" /></element>

		<element ref="hlub" inputtag="board:board:UI" inputmask="0x08"><bounds x="1.8" y="59.2" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- undo -->

		<element ref="hlub" inputtag="board:board:UI" inputmask="0x10"><bounds x="1.3" y="67.65" width="2" height="2.2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x20"><bounds x="3.1" y="67.65" width="1.7" height="2.2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x40"><bounds x="5.2" y="67.65" width="1.7" height="2.2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x80"><bounds x="6.9" y="67.65" width="2" height="2.2" /><color alpha="0.25" /></element>

		<element name="count_ui0" ref="text_uiu3a"><bounds x="0" y="71" width="4" height="2" /></element>
		<element name="count_ui1" ref="text_uiu3c"><bounds x="6" y="71" width="4" height="2" /></element>
		<element ref="text_uiu3b"><bounds x="4" y="71" width="2" height="2" /></element>
	</group>



<!-- display -->


