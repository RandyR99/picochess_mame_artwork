		<element ref="text_4"><bounds x="-0.5" y="46.5" width="3" height="3" /></element>
		<element ref="text_3"><bounds x="-0.5" y="56.5" width="3" height="3" /></element>
		<element ref="text_2"><bounds x="-0.5" y="66.5" width="3" height="3" /></element>
		<element ref="text_1"><bounds x="-0.5" y="76.5" width="3" height="3" /></element>

		<element ref="text_a"><bounds x="7"  y="85.5" width="3" height="3" /></element>
