		<image file="../pieces/pmephisto2/bq_sel.png" state="23"/>
		<image file="../pieces/pmephisto2/bk_sel.png" state="24"/>
	</element>

<element name="pflat" defstate="0">
		<image file="../pieces/pflat/wp.png" state="1"/>
		<image file="../pieces/pflat/wn.png" state="2"/>
		<image file="../pieces/pflat/wb.png" state="3"/>
		<image file="../pieces/pflat/wr.png" state="4"/>
		<image file="../pieces/pflat/wq.png" state="5"/>
		<image file="../pieces/pflat/wk.png" state="6"/>
        <image file="../pieces/pflat/bp.png" state="7"/>
		<image file="../pieces/pflat/bn.png" state="8"/>
		<image file="../pieces/pflat/bb.png" state="9"/>
		<image file="../pieces/pflat/br.png" state="10"/>
		<image file="../pieces/pflat/bq.png" state="11"/>
		<image file="../pieces/pflat/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../pieces/pflat/wp_sel.png" state="13"></image>
		<image file="../pieces/pflat/wn_sel.png" state="14"></image>
		<image file="../pieces/pflat/wb_sel.png" state="15"></image>
		<image file="../pieces/pflat/wr_sel.png" state="16"></image>
		<image file="../pieces/pflat/wq_sel.png" state="17"></image>
		<image file="../pieces/pflat/wk_sel.png" state="18"></image>
        <image file="../pieces/pflat/bp_sel.png" state="19"></image>
		<image file="../pieces/pflat/bn_sel.png" state="20"></image>
		<image file="../pieces/pflat/bb_sel.png" state="21"></image>
		<image file="../pieces/pflat/br_sel.png" state="22"></image>
		<image file="../pieces/pflat/bq_sel.png" state="23"></image>
		<image file="../pieces/pflat/bk_sel.png" state="24"></image>
	</element>

	<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />

		

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-3.6" increment="10" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_m"><bounds x="-1.3"  y="~y~" width="13" height="13" /></element>
			<element name="piece_b~i~" ref="piece_m"><bounds x="8.7" y="~y~" width="13" height="13" /></element>
			<element name="piece_c~i~" ref="piece_m"><bounds x="18.7" y="~y~" width="13" height="13" /></element>
			<element name="piece_d~i~" ref="piece_m"><bounds x="28.7" y="~y~" width="13" height="13" /></element>
			<element name="piece_e~i~" ref="piece_m"><bounds x="38.7" y="~y~" width="13" height="13" /></element>
			<element name="piece_f~i~" ref="piece_m"><bounds x="48.7" y="~y~" width="13" height="13" /></element>
			<element name="piece_g~i~" ref="piece_m"><bounds x="58.7" y="~y~" width="13" height="13" /></element>
			<element name="piece_h~i~" ref="piece_m"><bounds x="68.7" y="~y~" width="13" height="13" /></element>
		</repeat>
	</group>

<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

		
		<!-- leds -->
		

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="1" increment="10" />
			<param name="i" start="8" increment="-1" />
                <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>



			<element name="piece_a~i~" ref="pflat"><bounds x="0.9" y="~y~" width="8" height="8" /></element>
			<element name="piece_b~i~" ref="pflat"><bounds x="10.9" y="~y~"  width="8" height="8" /></element>
			<element name="piece_c~i~" ref="pflat"><bounds x="20.9" y="~y~" width="8" height="8" /></element>
			<element name="piece_d~i~" ref="pflat"><bounds x="30.9" y="~y~" width="8" height="8" /></element>
			<element name="piece_e~i~" ref="pflat"><bounds x="40.9" y="~y~" width="8" height="8" /></element>
			<element name="piece_f~i~" ref="pflat"><bounds x="50.9" y="~y~" width="8" height="8" /></element>
			<element name="piece_g~i~" ref="pflat"><bounds x="60.9" y="~y~" width="8" height="8" /></element>
			<element name="piece_h~i~" ref="pflat"><bounds x="70.9" y="~y~" width="8" height="8" /></element>
		</repeat>
	</group>

<!-- sb ui -->

	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uit1"><text string="S.BOARD"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uit2"><text string="INTERFACE"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib1"><text string="BOARD:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib2">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="RESET"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uib3">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="CLEAR"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uis1"><text string="SPAWN"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih1"><text string="HAND::"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih2">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="REMOVE"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu1"><text string="UNDO:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu2a">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &lt;&lt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2b">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &lt;  "><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2c">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="   &gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2d">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &gt;&gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui">
		<bounds x="0" y="0" width="10" height="80" />
		
		<element ref="hlub" inputtag="board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- spawn -->
		

		<element name="piece_ui1" ref="piece_2m"><bounds x="1.4" y="23" width="3.8" height="3.8" /></element>
		<element name="piece_ui2" ref="piece_2m"><bounds x="1.4" y="27" width="3.8" height="3.8" /></element>
		<element name="piece_ui3" ref="piece_2m"><bounds x="1.4" y="31" width="3.8" height="3.8" /></element>
		<element name="piece_ui4" ref="piece_2m"><bounds x="4.6" y="23" width="3.8" height="3.8" /></element>
		<element name="piece_ui5" ref="piece_2m"><bounds x="4.6" y="27" width="3.8" height="3.8" /></element>
		<element name="piece_ui6" ref="piece_2m"><bounds x="4.6" y="31" width="3.8" height="3.8" /></element>
		<element name="piece_ui7" ref="piece_2m"><bounds x="1.4" y="36" width="3.8" height="3.8" /></element>
		<element name="piece_ui8" ref="piece_2m"><bounds x="1.4" y="40" width="3.8" height="3.8" /></element>
		<element name="piece_ui9" ref="piece_2m"><bounds x="1.4" y="43.7" width="3.8" height="3.8" /></element>
		<element name="piece_ui10" ref="piece_2m"><bounds x="4.6" y="36" width="3.8" height="3.8" /></element>
		<element name="piece_ui11" ref="piece_2m"><bounds x="4.6" y="40" width="3.8" height="3.8" /></element>
		<element name="piece_ui12" ref="piece_2m"><bounds x="4.6" y="43.7" width="3.8" height="3.8" /></element>

		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0001"><bounds x="1" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0002"><bounds x="1" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0004"><bounds x="1" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0008"><bounds x="5" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0010"><bounds x="5" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0020"><bounds x="5" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0040"><bounds x="1" y="36" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0080"><bounds x="1" y="40" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0100"><bounds x="1" y="44" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0200"><bounds x="5" y="36" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0400"><bounds x="5" y="40" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0800"><bounds x="5" y="44" width="4" height="4" /><color alpha="0.25" /></element>

		<!-- HAND: -->
		
		<element name="piece_ui0" ref="piece_2m"><bounds x="2" y="52.8" width="6" height="6" /></element>

		<element ref="hlub" inputtag="board:UI" inputmask="0x08"><bounds x="1.8" y="59.2" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- undo -->

		<element ref="hlub" inputtag="board:UI" inputmask="0x10"><bounds x="1.3" y="67.65" width="2" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x20"><bounds x="3.1" y="67.65" width="1.7" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x40"><bounds x="5.2" y="67.65" width="1.7" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x80"><bounds x="6.9" y="67.65" width="2" height="2" /><color alpha="0.25" /></element>

		<element name="count_ui0" ref="text_uiu3a"><bounds x="0" y="71" width="4" height="2" /></element>
		<element name="count_ui1" ref="text_uiu3c"><bounds x="6" y="71" width="4" height="2" /></element>
		<element ref="text_uiu3b"><bounds x="4" y="71" width="2" height="2" /></element>
	</group>


<!-- shared view -->

	<group name="shared">
		<bounds x="-0.5" y="6.5" width="83" height="94.9" />

		<element ref="cblack"><bounds x="3" y="89.4" width="27" height="12" /></element>
		<element ref="black2"><bounds x="5" y="91.4" width="23" height="8" /></element>
		<element ref="lcd_bg"><bounds x="5.3" y="91.7" width="22.4" height="7.4" /></element>
		<element name="digit0" ref="digit"><bounds x="7"    y="92.625" width="3.7" height="5.55" /></element>
		<element name="digit1" ref="digit"><bounds x="12.1" y="92.625" width="3.7" height="5.55" /></element>
