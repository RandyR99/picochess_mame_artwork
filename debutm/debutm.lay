		<image file="../pieces/pmephisto2/br.png" state="10"/>
		<image file="../pieces/pmephisto2/bq.png" state="11"/>
		<image file="../pieces/pmephisto2/bk.png" state="12"/>
		<image file="../pieces/pmephisto2/wp_sel.png" state="13"/>
		<image file="../pieces/pmephisto2/wkn_sel.png" state="14"/>
		<image file="../pieces/pmephisto2/wb_sel.png" state="15"/>
		<image file="../pieces/pmephisto2/wr_sel.png" state="16"/>
