		<image file="../piezas/pmephisto5/bq_sel.png" state="23"/>
		<image file="../piezas/pmephisto5/bk_sel.png" state="24"/>
	</element>

<element name="piece_2m" defstate="0">
		<image file="../piezas/chess2/wp.png" state="1"/>
		<image file="../piezas/chess2/wn.png" state="2"/>
		<image file="../piezas/chess2/wb.png" state="3"/>
		<image file="../piezas/chess2/wr.png" state="4"/>
		<image file="../piezas/chess2/wq.png" state="5"/>
		<image file="../piezas/chess2/wk.png" state="6"/>

		<image file="../piezas/chess2/bp.png" state="7"/>
		<image file="../piezas/chess2/bn.png" state="8"/>
		<image file="../piezas/chess2/bb.png" state="9"/>
		<image file="../piezas/chess2/br.png" state="10"/>
		<image file="../piezas/chess2/bq.png" state="11"/>
		<image file="../piezas/chess2/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../piezas/chess2/wp_sel.png" state="13"></image>
		<image file="../piezas/chess2/wn_sel.png" state="14"></image>
		<image file="../piezas/chess2/wb_sel.png" state="15"></image>
		<image file="../piezas/chess2/wr_sel.png" state="16"></image>
		<image file="../piezas/chess2/wq_sel.png" state="17"></image>
		<image file="../piezas/chess2/wk_sel.png" state="18"></image>

		<image file="../piezas/chess2/bp_sel.png" state="19"></image>
		<image file="../piezas/chess2/bn_sel.png" state="20"></image>
		<image file="../piezas/chess2/bb_sel.png" state="21"></image>
		<image file="../piezas/chess2/br_sel.png" state="22"></image>
		<image file="../piezas/chess2/bq_sel.png" state="23"></image>
		<image file="../piezas/chess2/bk_sel.png" state="24"></image>
	</element>

<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />
		
		
		<!-- leds -->
	<repeat count="8">
			<param name="y" start="8.3" increment="10" />
			<param name="i2" start="8" increment="1" />

			<repeat count="8">
				<param name="x" start="0.5" increment="10" />
				<param name="i1" start="0" increment="1" />
				<element name="~i1~.~i2~" ref="led"><bounds x="~x~" y="~y~" width="1.25" height="1.25" /></element>
			</repeat>
		</repeat>
		
		
		
		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

<param name="z" start="-5" increment="10" />
<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece"><bounds x="-2"  y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="8" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="18" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="28" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="38" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="48" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="58" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="68" y="~z~" width="14.5" height="14.5" /></element>
		</repeat>
	</group>


<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />
<!-- leds -->
		<repeat count="8">
			<param name="y" start="8.3" increment="10" />
			<param name="i2" start="8" increment="1" />

			<repeat count="8">
				<param name="x" start="0.5" increment="10" />
				<param name="i1" start="0" increment="1" />
				<element name="~i1~.~i2~" ref="led"><bounds x="~x~" y="~y~" width="1.25" height="1.25" /></element>
			</repeat>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="0"  y="~y~" width="10" height="10" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10" y="~y~" width="10" height="10" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20" y="~y~" width="10" height="10" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30" y="~y~" width="10" height="10" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40" y="~y~" width="10" height="10" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50" y="~y~" width="10" height="10" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60" y="~y~" width="10" height="10" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70" y="~y~" width="10" height="10" /></element>
		</repeat>
	</group>


<!-- sb ui -->

	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui">
		<bounds x="0" y="0" width="10" height="80" />
		
		<element ref="hlub" inputtag="board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- spawn -->
		

		<element name="piece_ui1" ref="piece_2m"><bounds x="1.4" y="23" width="3.8" height="3.8" /></element>
		<element name="piece_ui2" ref="piece_2m"><bounds x="1.4" y="27" width="3.8" height="3.8" /></element>
		<element name="piece_ui3" ref="piece_2m"><bounds x="1.4" y="31" width="3.8" height="3.8" /></element>
		<element name="piece_ui4" ref="piece_2m"><bounds x="4.8" y="23" width="3.8" height="3.8" /></element>
		<element name="piece_ui5" ref="piece_2m"><bounds x="4.8" y="27" width="3.8" height="3.8" /></element>
