<?xml version="1.0"?>
<mamelayout version="2">

<element name="fondo">
		<image file="../varios/fondo4.png" />
	</element>

<element name="fidelity">
		<image file="elite_as5e2.png" />
	</element>

<element name="sbui_png">
		<image file="../varios/clipboard09b.png" />
	</element>

<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

<element name="hlbb" defstate="0">
	</element>

<element name="led" defstate="0">
	<image file="../leds/rojo_1a.png" state="1"/>
	<image file="../leds/rojo_0.png" state="0"/>
	</element>

<element name="led2" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.1" green="0.01" blue="0.015" /></disk>
	</element>

<element name="but" defstate="0">
	    <image file="../botones/boton_0.png" state="0"/>
        <image file="../botones/boton_1.png" state="1"/>
	</element>

<element name="piece" defstate="0">
		<image file="../piezas/pmephisto5/wp.png" state="1"/>
		<image file="../piezas/pmephisto5/wkn.png" state="2"/>
		<image file="../piezas/pmephisto5/wb.png" state="3"/>
