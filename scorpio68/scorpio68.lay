		<image file="../piezas/pnovag_plastico/bkn.png" state="8"/>
		<image file="../piezas/pnovag_plastico/bb.png" state="9"/>
		<image file="../piezas/pnovag_plastico/br.png" state="10"/>
		<image file="../piezas/pnovag_plastico/bq.png" state="11"/>
		<image file="../piezas/pnovag_plastico/bk.png" state="12"/>
