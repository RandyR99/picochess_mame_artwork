	</element>

<element name="sbui_png">
		<image file="../varios/clipboard09b.png" />
	</element>

<element name="fondo">
		<image file="../varios/fondo4.png" />
	</element>


	<element name="whitew"><rect><color red="1" green="1" blue="1" /></rect></element>
    <element name="lcdw"><rect><color red="1" green="1" blue="1" /></rect></element>
	<element name="lcdm"><rect><color red="0.73" green="0.71" blue="0.65" /></rect></element>
	<element name="lcda"><rect><color red="0.20" green="0.16" blue="0.17" /></rect></element>


	<element name="piece" defstate="0">
		<image file="../piezas/pnovag_plastico/wp.png" state="1"/>
		<image file="../piezas/pnovag_plastico/wkn.png" state="2"/>
		<image file="../piezas/pnovag_plastico/wb.png" state="3"/>
