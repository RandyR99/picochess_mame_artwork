		<image file="../piezas/pnovag_plastico/wr_sel.png" state="16"/>
		<image file="../piezas/pnovag_plastico/wq_sel.png" state="17"/>
		<image file="../piezas/pnovag_plastico/wk_sel.png" state="18"/>
