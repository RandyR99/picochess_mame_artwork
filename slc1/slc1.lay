<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->

<!-- artwork by volodymyr -->


	<element name="slc1">
		<image file="slc1b.png" />
	</element>

	<element name="piece" defstate="0">
		<image file="../piezas/chess2/bp.png" state="1"/>
		<image file="../piezas/chess2/bkn.png" state="2"/>
		<image file="../piezas/chess2/bb.png" state="3"/>
		<image file="../piezas/chess2/br.png" state="4"/>
		<image file="../piezas/chess2/bq.png" state="5"/>
		<image file="../piezas/chess2/bk.png" state="6"/>
		<image file="../piezas/chess2/wp.png" state="7"/>
		<image file="../piezas/chess2/wkn.png" state="8"/>
		<image file="../piezas/chess2/wb.png" state="9"/>
		<image file="../piezas/chess2/wr.png" state="10"/>
		<image file="../piezas/chess2/wq.png" state="11"/>
		<image file="../piezas/chess2/wk.png" state="12"/>
		<image file="../piezas/chess2/bp_sel.png" state="13"/>
		<image file="../piezas/chess2/bkn_sel.png" state="14"/>
		<image file="../piezas/chess2/bb_sel.png" state="15"/>
		<image file="../piezas/chess2/br_sel.png" state="16"/>
		<image file="../piezas/chess2/bq_sel.png" state="17"/>
		<image file="../piezas/chess2/bk_sel.png" state="18"/>
		<image file="../piezas/chess2/wp_sel.png" state="19"/>
		<image file="../piezas/chess2/wkn_sel.png" state="20"/>
		<image file="../piezas/chess2/wb_sel.png" state="21"/>
		<image file="../piezas/chess2/wr_sel.png" state="22"/>
		<image file="../piezas/chess2/wq_sel.png" state="23"/>
		<image file="../piezas/chess2/wk_sel.png" state="24"/>
	</element>

	<element name="CLEARboard"><image file="CLEARboard.png" /></element>
	<element name="startpos">  <image file="startpos.png" />  </element>
	<element name="turnboard"> <image file="turnboard.png" /> </element>

	<element name="sensor" defstate="0"></element>

	<element name="btc" defstate="0">
	<image file="rojo_c.png" state="0"/>
	<image file="rojo_c_sel.png" state="1"/>
	</element>

	<element name="bta" defstate="0">
	<image file="gris_a.png" state="0"/>
	<image file="gris_a_sel.png" state="1"/>
	</element>

	<element name="btst" defstate="0">
	<image file="gris_st.png" state="0"/>
	<image file="gris_st_sel.png" state="1"/>
	</element>

	<element name="btz" defstate="0">
	<image file="gris_z.png" state="0"/>
	<image file="gris_z_sel.png" state="1"/>
	</element>

	<element name="bt1" defstate="0">
	<image file="azul_1.png" state="0"/>
	<image file="azul_1_sel.png" state="1"/>
	</element>

	<element name="bt2" defstate="0">
	<image file="azul_2.png" state="0"/>
	<image file="azul_2_sel.png" state="1"/>
	</element>

	<element name="bt3" defstate="0">
	<image file="azul_3.png" state="0"/>
	<image file="azul_3_sel.png" state="1"/>
	</element>

	<element name="bt4" defstate="0">
	<image file="azul_4.png" state="0"/>
	<image file="azul_4_sel.png" state="1"/>
	</element>

	<element name="bt5" defstate="0">
	<image file="azul_5.png" state="0"/>
	<image file="azul_5_sel.png" state="1"/>
	</element>

	<element name="bt6" defstate="0">
	<image file="azul_6.png" state="0"/>
	<image file="azul_6_sel.png" state="1"/>
	</element>

	<element name="bt7" defstate="0">
	<image file="azul_7.png" state="0"/>
	<image file="azul_7_sel.png" state="1"/>
	</element>

	<element name="bt8" defstate="0">
	<image file="azul_8.png" state="0"/>
	<image file="azul_8_sel.png" state="1"/>
	</element>

<element name="RESET" defstate="0">
	<image file="reset.png" state="0"/>
	<image file="reset_sel.png" state="1"/>
	</element>


	<element name="led" defstate="0">
	<image file="../leds/red_sel.png" state="1"/>
	<image file="../leds/red.png" state="0"/>
	</element>


<element name="digit" defstate="0">
		<led7seg>
			<color red="0.4" green="1.0" blue="0" />
		</led7seg>
	</element>

<group name="display">
		
	 
		<element name="digit6" ref="digit">
			<bounds x="10" y="0" width="18" height="26" />
		</element>
		<element name="digit5" ref="digit">
			<bounds x="28" y="0" width="18" height="26" />
		</element>
		<element name="digit4" ref="digit">
			<bounds x="46" y="0" width="18" height="26" />
		</element>
		<element name="digit3" ref="digit">
			<bounds x="64" y="0" width="18" height="26" />
		</element>
		<element name="digit1" ref="digit">
			<bounds x="100" y="0" width="18" height="26" />
		</element>
		<element name="digit0" ref="digit">
			<bounds x="118" y="0" width="18" height="26" />
		</element>
</group>






<!-- build screen -->

	<view name="artwork by luis">

		<bounds left="0" right="0" top="-3.2" bottom="534" />
		
		<element ref="slc1">
			<bounds x="0" y="0" width="306" height="534" />
		</element>





		<element name="busyled" ref="led">
			<bounds x="220" y="147" width="20" height="20" />
		</element>

		<element ref="btc" inputtag="IN.2" inputmask="0x01"><bounds x="25"  y="271" width="55" height="44" /></element>
		<element ref="bta" inputtag="IN.2" inputmask="0x02"><bounds x="91"  y="271" width="55" height="44" /></element>
	   <element ref="btst" inputtag="IN.2" inputmask="0x04"><bounds x="157" y="271" width="55" height="44" /></element>
		<element ref="btz" inputtag="IN.2" inputmask="0x08"><bounds x="223" y="271" width="55" height="44" /></element>

		<element ref="bt8" inputtag="IN.1" inputmask="0x08"><bounds x="25"  y="362" width="55" height="44" /></element>
		<element ref="bt7" inputtag="IN.1" inputmask="0x04"><bounds x="91"  y="362" width="55" height="44" /></element>
		<element ref="bt6" inputtag="IN.1" inputmask="0x02"><bounds x="157" y="362" width="55" height="44" /></element>
		<element ref="bt5" inputtag="IN.1" inputmask="0x01"><bounds x="223" y="362" width="55" height="44" /></element>

		<element ref="bt4" inputtag="IN.0" inputmask="0x01"><bounds x="25"  y="447" width="55" height="44" /></element>
		<element ref="bt3" inputtag="IN.0" inputmask="0x02"><bounds x="91"  y="447" width="55" height="44" /></element>
		<element ref="bt2" inputtag="IN.0" inputmask="0x04"><bounds x="157" y="447" width="55" height="44" /></element>
		<element ref="bt1" inputtag="IN.0" inputmask="0x08"><bounds x="223" y="447" width="55" height="44" /></element>

<element ref="RESET" inputtag="RESET" inputmask="0x01"><bounds x="223" y="179" width="55" height="44" /></element>

<group ref="display"><bounds x="46" y="69" width="209" height="40" /></group>

	</view>
</mamelayout>
