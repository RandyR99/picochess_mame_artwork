	</element>

<element name="display">
		<image file="display.png" />
	</element>
<element name="background">
		<image file="../misc/background4.png" />
	</element>


<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

	<element name="led" defstate="0">
	<image file="../leds/red_0.png" state="0"/>
	<image file="../leds/red_1a.png" state="1"/>
	</element>

<element name="ledr" defstate="0">
	<image file="../leds/led_red_0.png" state="0"/>
	<image file="../leds/led_red_2.png" state="1"/>
	</element>



	<element name="ledro">
	<image file="../leds/led_red_0.png" />
	</element>
	
	<element name="ledrr" defstate="0">
		<image file="../leds/led_grey_0.png" state="0"/>
	    <image file="../leds/led_red_2.png" state="1"/>
	</element>
	
	<element name="ledrg" defstate="0">
	<image file="../leds/led_grey_0.png" state="0"/>
	<image file="../leds/led_green_2.png" state="1"/>
	</element>
	
	<element name="ledo">
		<image file="../buttons/down_sel.png" />
	</element>
	
	
	<element name="lcdm"><rect><color red="0.639" green="0.643" blue="0.596" /></rect></element>
	




<element name="button" defstate="0">
		<image file="../buttons/button1.png" state="0"/>
	    <image file="../buttons/button1_sel.png" state="1"/>
	</element>

<element name="hlb" defstate="0">
		<rect state="0"><color red="0.4" green="0.4" blue="0.4" /></rect>
		<rect state="1"><color red="0.3" green="0.3" blue="0.3" /></rect>
	</element>

<element name="cblack"><rect><color red="0.56" green="0.33" blue="0.12" /></rect></element>
	<element name="cwhite"><rect><color red="0.84" green="0.75" blue="0.50" /></rect></element>

	<element name="hlbb" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk>
	</element>

	<element name="piece_e" defstate="0">
