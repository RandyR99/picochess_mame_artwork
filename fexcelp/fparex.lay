<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->

	<element name="fparex">
		<image file="board.png" />
	</element>

	<element name="piece" defstate="0">
		<image file="bp.png" state="1"/>
		<image file="bkn.png" state="2"/>
		<image file="bb.png" state="3"/>
		<image file="br.png" state="4"/>
		<image file="bq.png" state="5"/>
