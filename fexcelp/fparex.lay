	</element>

      <element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="digit_led" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.1" green="0.01" blue="0.015" /></disk>
	</element>

	<element name="led" defstate="0">
	<image file="red_sel.png" state="1"/>
	<image file="red.png" state="0"/>
	</element>

	<element name="ledg" defstate="0">
	<image file="green.png" state="0"/>
	<image file="green_sel.png" state="1"/>
	</element>

	<element name="newgame" defstate="0">
	<image file="newgame.png" state="0"/>
	</element>

	<element name="verify" defstate="0">
	<image file="verify.png" state="0"/>
	</element>

	<element name="options" defstate="0">
	<image file="options.png" state="0"/>
	</element>

	<element name="level" defstate="0">
	<image file="level.png" state="0"/>
	</element>

	<element name="hint" defstate="0">
	<image file="hint.png" state="0"/>
	</element>

	<element name="move" defstate="0">
	<image file="move.png" state="0"/>
	</element>

	<element name="CLEAR" defstate="0">
	<image file="clear.png" state="0"/>
	</element>

	<element name="takeback" defstate="0">
	<image file="takeback.png" state="0"/>
	</element>

	<element name="hl" defstate="0">
