<!-- sb board -->

	<element name="cwhite"><rect><color red="0.9" green="0.9" blue="0.9" /></rect></element>
	<element name="cblack"><rect><color red="0.4" green="0.4" blue="0.4" /></rect></element>

<element name="cwhite_v"><rect><color red="0.9" green="0.9" blue="0.9" /></rect></element>
	<element name="cblack_v"><rect><color red="0.1" green="0.1" blue="0.1" /></rect></element>

	<element name="hlbb_v" defstate="0">
	</element>



	<element name="hlbb" defstate="0">
	</element>

	<group name="sb_board_m">
		<bounds x="0" y="0" width="79" height="80" />

		<!-- chessboard leds -->
		<repeat count="8">
			<param name="x" start="6.8" increment="10.1" />
			<param name="la" start="0" increment="1" />
			<param name="lb" start="8" increment="1" />
			<param name="lc" start="16" increment="1" />
			<param name="ld" start="24" increment="1" />
			<param name="le" start="32" increment="1" />
			<param name="lf" start="40" increment="1" />
			<param name="lg" start="48" increment="1" />
			<param name="lh" start="56" increment="1" />

            <element name="led~lh~" ref="led"><bounds x="~x~" y="7.7"  width="1.2" height="1.2" /></element>
            <element name="led~lg~" ref="led"><bounds x="~x~" y="18.0" width="1.2" height="1.2" /></element>
            <element name="led~lf~" ref="led"><bounds x="~x~" y="28.2" width="1.2" height="1.2" /></element>
            <element name="led~le~" ref="led"><bounds x="~x~" y="38.3" width="1.2" height="1.2" /></element>
            <element name="led~ld~" ref="led"><bounds x="~x~" y="48.5" width="1.2" height="1.2" /></element>
            <element name="led~lc~" ref="led"><bounds x="~x~" y="58.6" width="1.2" height="1.2" /></element>
            <element name="led~lb~" ref="led"><bounds x="~x~" y="68.8" width="1.2" height="1.2" /></element>
			<element name="led~la~" ref="led"><bounds x="~x~" y="79.0" width="1.2" height="1.2" /></element>
			
		</repeat>


<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-5.1" increment="10.15" />
			<param name="i" start="8" increment="-1" />
			
                <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_m"><bounds x="-3" y="~y~" width="14" height="14" /></element>
			<element name="piece_b~i~" ref="piece_m"><bounds x="7.3"  y="~y~" width="14" height="14" /></element>
			<element name="piece_c~i~" ref="piece_m"><bounds x="17.3" y="~y~" width="14" height="14" /></element>
			<element name="piece_d~i~" ref="piece_m"><bounds x="27.3" y="~y~" width="14" height="14" /></element>
			<element name="piece_e~i~" ref="piece_m"><bounds x="37.3" y="~y~" width="14" height="14" /></element>
			<element name="piece_f~i~" ref="piece_m"><bounds x="47.3" y="~y~" width="14" height="14" /></element>
			<element name="piece_g~i~" ref="piece_m"><bounds x="57.3" y="~y~" width="14" height="14" /></element>
			<element name="piece_h~i~" ref="piece_m"><bounds x="67.3" y="~y~" width="14" height="14" /></element>
		</repeat>
	</group>


<group name="sb_board_2m">
		<bounds x="0" y="0" width="79" height="80" />

		

		<!-- chessboard leds -->
		<repeat count="8">
			<param name="x" start="6.8" increment="10.1" />
			<param name="la" start="0" increment="1" />
			<param name="lb" start="8" increment="1" />
			<param name="lc" start="16" increment="1" />
			<param name="ld" start="24" increment="1" />
			<param name="le" start="32" increment="1" />
			<param name="lf" start="40" increment="1" />
			<param name="lg" start="48" increment="1" />
			<param name="lh" start="56" increment="1" />

            <element name="led~lh~" ref="led"><bounds x="~x~" y="7.7"  width="1.2" height="1.2" /></element>
            <element name="led~lg~" ref="led"><bounds x="~x~" y="18.0" width="1.2" height="1.2" /></element>
            <element name="led~lf~" ref="led"><bounds x="~x~" y="28.2" width="1.2" height="1.2" /></element>
            <element name="led~le~" ref="led"><bounds x="~x~" y="38.3" width="1.2" height="1.2" /></element>
            <element name="led~ld~" ref="led"><bounds x="~x~" y="48.5" width="1.2" height="1.2" /></element>
            <element name="led~lc~" ref="led"><bounds x="~x~" y="58.6" width="1.2" height="1.2" /></element>
            <element name="led~lb~" ref="led"><bounds x="~x~" y="68.8" width="1.2" height="1.2" /></element>
			<element name="led~la~" ref="led"><bounds x="~x~" y="79.0" width="1.2" height="1.2" /></element>
			
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-0.1" increment="10.2" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="-1" y="~y~"   width="9" height="9" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="9.1" y="~y~"    width="9" height="9" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="19.2" y="~y~" width="9" height="9" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="29.3" y="~y~" width="9" height="9" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="39.4" y="~y~" width="9" height="9" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="49.5" y="~y~" width="9" height="9" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="59.6" y="~y~" width="9" height="9" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="69.7" y="~y~" width="9" height="9" /></element>
		</repeat>
	</group>



<!-- sb ui -->

	<!-- sb ui -->

<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>


	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>


	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui"><bounds x="0" y="0" width="10" height="80" />
		

		<!-- board -->
		

		<element ref="hlub" inputtag="board:board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- spawn -->
		

		<element name="piece_ui1" ref="piece_2m"><bounds x="1.4" y="23"    width="3.7" height="3.8" /></element>
		<element name="piece_ui2" ref="piece_2m"><bounds x="1.4" y="27"    width="3.7" height="3.8" /></element>
		<element name="piece_ui3" ref="piece_2m"><bounds x="1.4" y="31"    width="3.7" height="3.8" /></element>
		<element name="piece_ui4" ref="piece_2m"><bounds x="4.8" y="23"    width="3.7" height="3.8" /></element>
		<element name="piece_ui5" ref="piece_2m"><bounds x="4.8" y="27"    width="3.7" height="3.8" /></element>
		<element name="piece_ui6" ref="piece_2m"><bounds x="4.8" y="31"    width="3.7" height="3.8" /></element>
