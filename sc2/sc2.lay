<!-- build screen -->

	<view name="artwork by volodymyr/luis">

		<bounds left="75" right="126" top="-3.2" bottom="84.5" />
		
		<element ref="fondo">
			<bounds x="75" y="-3.2" width="126" height="89.5" />
		</element>
		
		<element ref="sc2">
			<bounds x="-9.2" y="-3.2" width="136" height="89.5" />
		</element>







		<element name="digit0" ref="digit">
			<bounds x="89.7" y="28.05" width="4" height="6" />
