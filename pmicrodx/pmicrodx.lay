<mamelayout version="2">

<!-- NOTE: no chesspieces simulation here -->

<!-- define elements -->

<element name="board">
		<image file="ckpocket3.png" />
	</element>




<element name="lcdm"><rect><color red="0.537" green="0.482" blue="0.34.5" /></rect></element>




<element name="button" defstate="0">
	<image file="../buttons/down_sel2.png" state="1"/>
	
	</element>



<view name="Artwork by Luis">
<bounds left="0" right="988" top="0" bottom="1443" />
	
	<element ref="board">
			<bounds left="0" right="988" top="0" bottom="1443" />
		</element>
	
	<!-- screen -->
                   <screen index="0"><bounds x="651" y="1071" width="163" height="75" /></screen>
<element ref="lcdm" blend="multiply"><bounds x="646" y="1065" width="170" height="82" /></element>

	<!-- buttons	-->

	<element ref="button" inputtag="IN.0" inputmask="0x04"><bounds x="585" y="1048" width="45" height="45" /></element>
    <element ref="button" inputtag="IN.3" inputmask="0x04"><bounds x="837" y="1048" width="45" height="45" /></element>
	<element ref="button" inputtag="IN.1" inputmask="0x04"><bounds x="585" y="1129" width="45" height="48" /></element>
	<element ref="button" inputtag="IN.2" inputmask="0x04"><bounds x="837" y="1129" width="45" height="45" /></element>
    <element ref="button" inputtag="IN.0" inputmask="0x01"><bounds x="585" y="1213" width="45" height="45" /></element>
    <element ref="button" inputtag="IN.1" inputmask="0x01"><bounds x="670" y="1213" width="45" height="45" /></element>
    <element ref="button" inputtag="IN.2" inputmask="0x01"><bounds x="754" y="1213" width="45" height="45" /></element>
    <element ref="button" inputtag="IN.3" inputmask="0x01"><bounds x="837" y="1213" width="45" height="45" /></element>
    <element ref="button" inputtag="IN.0" inputmask="0x02"><bounds x="585" y="1294" width="45" height="45" /></element>
