<?xml version="1.0"?>
<mamelayout version="2">
<!-- define elements -->

<element name="mephisto">
		<image file="modular_mm1.png" />
	</element>


<element name="mephisto_e">
		<image file="exclusive_s3a.png" />
	</element>

<element name="background_grey">
		<image file="../misc/background4.png" />
	</element>

<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

<element name="sbui_e_png">
		<image file="../misc/clipboard09b.png" />
	</element>


<element name="led" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	    <image file="../leds/grey4.png" state="0"/>
</element>

	<element name="led_e" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	<image file="../leds/red4.png" state="0"/>
</element>

		<element name="lcd_bg"><rect><color red="0.800" green="0.816" blue="0.710" /></rect></element>
	<element name="ldot_hide"><disk><color red="0.800" green="0.816" blue="0.710" /></disk></element>

	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>
	<element name="ldot">
		<rect><color red="0.539" green="0.51765" blue="0.51765" /></rect>
		<rect statemask="0x80"><color red="0.2" green="0.16" blue="0.16" /></rect>
	</element>


	<element name="hlb" defstate="0">
		<rect state="0">
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
		<rect state="1">
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="0.4" green="0.4" blue="0.4" />
		</rect>
	</element>

		<element name="hlbb_e" defstate="0">
	</element>


	<element name="piece_m" defstate="0">
	<image file="../pieces/pnovag_plastic/wp.png" state="1"/>
		<image file="../pieces/pnovag_plastic/wkn.png" state="2"/>
		<image file="../pieces/pnovag_plastic/wb.png" state="3"/>
		<image file="../pieces/pnovag_plastic/wr.png" state="4"/>
		<image file="../pieces/pnovag_plastic/wq.png" state="5"/>
		<image file="../pieces/pnovag_plastic/wk.png" state="6"/>
		<image file="../pieces/pnovag_plastic/bp.png" state="7"/>
		<image file="../pieces/pnovag_plastic/bkn.png" state="8"/>
		<image file="../pieces/pnovag_plastic/bb.png" state="9"/>
		<image file="../pieces/pnovag_plastic/br.png" state="10"/>
		<image file="../pieces/pnovag_plastic/bq.png" state="11"/>
		<image file="../pieces/pnovag_plastic/bk.png" state="12"/>
