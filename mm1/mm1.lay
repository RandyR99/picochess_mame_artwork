<element name="piece_e" defstate="0">
		<image file="../pieces/pmephisto8/wp.png" state="1"/>
		<image file="../pieces/pmephisto8/wn.png" state="2"/>
		<image file="../pieces/pmephisto8/wb.png" state="3"/>
