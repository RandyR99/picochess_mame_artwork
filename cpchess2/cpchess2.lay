<mamelayout version="2">

<!-- define elementos -->

<element name="cxg">
		<image file="computachess2.png" />
	</element>
	
	<element name="background">
		<rect><color red="0" green="0" blue="0" /></rect>
	</element>

<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

	<element name="led" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	    <image file="../leds/red4.png" state="0"/>
</element>
	
	<element name="save" defstate="0">
		<text state="0" string="POWER SW.: ON" align="1"><color red="0.81" green="0.8" blue="0.79" /></text>
		<text state="1" string="POWER SW.: SAVE" align="1"><color red="0.81" green="0.8" blue="0.79" /></text>
	</element>


	
	<element name="button" defstate="0">
	<image file="../buttons/down_sel11.png" state="1"/>
	
	</element>
	
	<element name="piece_2m" defstate="0">
		<image file="../pieces/chess2/wp.png" state="1"/>
		<image file="../pieces/chess2/wn.png" state="2"/>
		<image file="../pieces/chess2/wb.png" state="3"/>
		<image file="../pieces/chess2/wr.png" state="4"/>
		<image file="../pieces/chess2/wq.png" state="5"/>
		<image file="../pieces/chess2/wk.png" state="6"/>

