<?xml version="1.0"?>
<!--
license:cc0
-->
<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

<element name="novag">
		<image file="pocket2.png" />
	</element>

<element name="fondo">
		<image file="../varios/fondo4.png" />
	</element>




<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>
	


	<element name="but" defstate="0">
    
    <image file="down1_sel.png" state="1"/>
	</element>

<element name="but1" defstate="1">
    
    <image file="down2_sel.png" state="1"/>
	</element>
	





<!-- digits -->

	<group name="digits">
		<bounds x="0" y="0" width="45" height="15" />
		<element name="digit3" ref="digit"><bounds x="0"  y="0" width="10" height="15" /></element>
		<element name="digit2" ref="digit"><bounds x="10" y="0" width="10" height="15" /></element>
		<element name="digit1" ref="digit"><bounds x="28" y="0" width="10" height="15" /></element>
		<element name="digit0" ref="digit"><bounds x="38" y="0" width="10" height="15" /></element>
	</group>

<!-- build screen -->

	<view name="artwork by luis">
<bounds left="-10" right="1073" top="-10" bottom="1308" />

<element ref="fondo">
			<bounds x="-10" y="-10" width="1088" height="1318" />
		</element>


<element ref="novag">
			<bounds x="0" y="0" width="1068" height="1288" />
		</element>

<group ref="digits"><bounds x="384" y="153" width="265" height="49" /></group>

		
		
		

	<!-- button panel -->

		

		<element ref="but" inputtag="IN.0" inputmask="0x01"><bounds x="177" y="1000" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x02"><bounds x="269" y="1000" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x04"><bounds x="359" y="1000" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but" inputtag="IN.0" inputmask="0x08"><bounds x="450" y="1000" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but" inputtag="IN.1" inputmask="0x01"><bounds x="539" y="1000" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but1" inputtag="IN.1" inputmask="0x02"><bounds x="629" y="1000" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but1" inputtag="IN.1" inputmask="0x04"><bounds x="719" y="1000" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but1" inputtag="IN.1" inputmask="0x08"><bounds x="810" y="1000" width="76" height="54" /><color alpha="0.60" /></element>

		<element ref="but" inputtag="IN.2" inputmask="0x01"><bounds x="169" y="1106" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but" inputtag="IN.2" inputmask="0x02"><bounds x="261" y="1106" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but" inputtag="IN.2" inputmask="0x04"><bounds x="353" y="1106" width="76" height="54" /><color alpha="0.60" /></element>
		<element ref="but" inputtag="IN.3" inputmask="0x04"><bounds x="445" y="1106" width="76" height="55" /><color alpha="0.60" /></element>
		<element ref="but1" inputtag="IN.2" inputmask="0x08"><bounds x="539" y="1106" width="76" height="55" /><color alpha="0.60" /></element>
		<element ref="but1" inputtag="IN.3" inputmask="0x01"><bounds x="633" y="1106" width="76" height="55" /><color alpha="0.60" /></element>
		<element ref="but1" inputtag="IN.3" inputmask="0x02"><bounds x="769" y="1106" width="79" height="55" /><color alpha="0.60" /></element>

	</view>
	
	
	
</mamelayout>
