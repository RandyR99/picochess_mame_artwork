		<element name="ledo">
		<rect><color red="0.1" green="0.1" blue="0.1" /></rect>
	</element>
	<element name="ledr" defstate="0">
		<rect state="0"><color red="0" green="0" blue="0" /></rect>
		<rect state="1"><color red="1" green="0" blue="0" /></rect>
	</element>
	<element name="ledg" defstate="0">
		<rect state="0"><color red="0" green="0" blue="0" /></rect>
		<rect state="1"><color red="0" green="1" blue="0" /></rect>
	</element>
	
	<element name="but" defstate="0">
	<image file="../botones/button.png" state="0"/>
	<image file="../botones/button_sel.png" state="1"/>
	</element>
	
<element name="lcd_bg"><rect><color red="0.5412" green="0.57255" blue="0.5804" /></rect></element>
