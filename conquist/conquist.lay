		<element name="count_ui0" ref="text_uiu3a"><bounds x="0" y="71" width="4" height="2" /></element>
		<element name="count_ui1" ref="text_uiu3c"><bounds x="6" y="71" width="4" height="2" /></element>
		<element ref="text_uiu3b"><bounds x="4" y="71" width="2" height="2" /></element>
	</group>







		
		<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />
		
		
		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

<param name="z" start="-5" increment="10" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0.3"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10.1" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20.2" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece"><bounds x="-2.2"  y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="7.6" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="17.6" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="27.7" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="37.7" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="47.7" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="57.8" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="67.8" y="~z~" width="14.5" height="14.5" /></element>
		</repeat>
	</group>


<group name="sb_board_2m">
		<bounds x="-0.5" y="-0.5" width="81" height="81" />

		
	

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-0.4" increment="10.1" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="-0.70"  y="~y~" width="10" height="10" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="9.80" y="~y~" width="10" height="10" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="19.90" y="~y~" width="10" height="10" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30" y="~y~" width="10" height="10" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40.2" y="~y~" width="10" height="10" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50.2" y="~y~" width="10" height="10" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60.2" y="~y~" width="10" height="10" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70.3" y="~y~" width="10" height="10" /></element>
		</repeat>
	</group>

