<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->
        <element name="chessmaster">
		<image file="chessmstdm.png" />
	</element>

      
	 <element name="background">
		<image file="../misc/background4.png" />
	</element>

<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

	<element name="piece" defstate="0">
	
		<image file="../pieces/pmephisto5/wp.png" state="1"/>
		<image file="../pieces/pmephisto5/wkn.png" state="2"/>
        <image file="../pieces/pmephisto5/wb.png" state="3"/>
		<image file="../pieces/pmephisto5/wr.png" state="4"/>
		<image file="../pieces/pmephisto5/wq.png" state="5"/>
		<image file="../pieces/pmephisto5/wk.png" state="6"/>
		<image file="../pieces/pmephisto5/bp.png" state="7"/>
		<image file="../pieces/pmephisto5/bkn.png" state="8"/>
		<image file="../pieces/pmephisto5/bb.png" state="9"/>
		<image file="../pieces/pmephisto5/br.png" state="10"/>
		<image file="../pieces/pmephisto5/bq.png" state="11"/>
		<image file="../pieces/pmephisto5/bk.png" state="12"/>
		<image file="../pieces/pmephisto5/wp_sel.png" state="13"/>
		<image file="../pieces/pmephisto5/wkn_sel.png" state="14"/>
		<image file="../pieces/pmephisto5/wb_sel.png" state="15"/>
		<image file="../pieces/pmephisto5/wr_sel.png" state="16"/>
		<image file="../pieces/pmephisto5/wq_sel.png" state="17"/>
		<image file="../pieces/pmephisto5/wk_sel.png" state="18"/>
		<image file="../pieces/pmephisto5/bp_sel.png" state="19"/>
		<image file="../pieces/pmephisto5/bkn_sel.png" state="20"/>
		<image file="../pieces/pmephisto5/bb_sel.png" state="21"/>
		<image file="../pieces/pmephisto5/br_sel.png" state="22"/>
		<image file="../pieces/pmephisto5/bq_sel.png" state="23"/>
		<image file="../pieces/pmephisto5/bk_sel.png" state="24"/>
	</element>

<element name="piece_2m" defstate="0">
	     <image file="../pieces/chess2/wp.png" state="1"/>
		<image file="../pieces/chess2/wn.png" state="2"/>
		<image file="../pieces/chess2/wb.png" state="3"/>
		<image file="../pieces/chess2/wr.png" state="4"/>
		<image file="../pieces/chess2/wq.png" state="5"/>
		<image file="../pieces/chess2/wk.png" state="6"/>

		<image file="../pieces/chess2/bp.png" state="7"/>
		<image file="../pieces/chess2/bn.png" state="8"/>
		<image file="../pieces/chess2/bb.png" state="9"/>
		<image file="../pieces/chess2/br.png" state="10"/>
		<image file="../pieces/chess2/bq.png" state="11"/>
		<image file="../pieces/chess2/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../pieces/chess2/wp.png" state="13"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wn.png" state="14"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wb.png" state="15"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wr.png" state="16"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wq.png" state="17"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wk.png" state="18"><color alpha="0.5" /></image>

		<image file="../pieces/chess2/bp.png" state="19"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bn.png" state="20"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bb.png" state="21"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/br.png" state="22"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bq.png" state="23"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bk.png" state="24"><color alpha="0.5" /></image>
	</element> 
	  
	  


	  	<element name="ledr" defstate="0">
	<image file="../leds/red_sel.png" state="1"/>
	</element>

	  	<element name="ledr1" defstate="0">
	<image file="../leds/red_sel.png" state="1"/>
	</element>

	  	<element name="ledg" defstate="0">
	<image file="../leds/green1_sel.png" state="1"/>
	
</element>
	
	  	<element name="ledy" defstate="0">
	<image file="../leds/yellow_sel.png" state="1"/>
	
</element>	
	  
	  
	  	<element name="button" defstate="0">
	
      <image file="../buttons/down_sel1.png" state="1"/>
	</element>
	  
	  <element name="cblack"><rect><color red="0.16" green="0.48" blue="0.32" /></rect></element>
	<element name="cwhite"><rect><color red="0.81" green="0.8" blue="0.79" /></rect></element>	
	  
	  
	<element name="hlbb" defstate="0">
	</element>


<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />




			<!-- leds -->
	<repeat count="8">
			<param name="y" start="7.3" increment="10.03" />
			<param name="i2" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="0.3" increment="9.95" />
				<param name="i1" start="0" increment="1" />
				<element name="~i1~.~i2~" ref="ledr"><bounds x="~x~" y="~y~" width="2.9" height="2.9" /></element>
			</repeat>
		</repeat>



<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

<param name="z" start="-7.2" increment="10" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

		    <element name="piece_a~i~" ref="piece"><bounds x="-3"  y="~z~" width="16.5" height="16.5" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="7" y="~z~"  width="16.5" height="16.5" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="17" y="~z~" width="16.5" height="16.5" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="27" y="~z~" width="16.5" height="16.5" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="37" y="~z~" width="16.5" height="16.5" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="47" y="~z~" width="16.5" height="16.5" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="57" y="~z~" width="16.5" height="16.5" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="67" y="~z~" width="16.5" height="16.5" /></element>
		</repeat>
	</group>

<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

			<!-- leds -->
	<repeat count="8">
			<param name="y" start="7.3" increment="10.03" />
			<param name="i2" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="0.3" increment="9.95" />
				<param name="i1" start="0" increment="1" />
				<element name="~i1~.~i2~" ref="ledr"><bounds x="~x~" y="~y~" width="2.9" height="2.9" /></element>
			</repeat>
		</repeat>
		

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="0"  y="~y~" width="9" height="9" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10" y="~y~" width="9" height="9" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20" y="~y~" width="9" height="9" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30" y="~y~" width="9" height="9" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40.2" y="~y~" width="9" height="9" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50.2" y="~y~" width="9" height="9" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60.2" y="~y~" width="9" height="9" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70.3" y="~y~" width="9" height="9" /></element>
		</repeat>
	</group>


<!-- sb ui -->

<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>


	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>


	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui"><bounds x="0" y="0" width="10" height="80" />
		

		<!-- board -->
		

		<element ref="hlub" inputtag="board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- spawn -->
		

		<element name="piece_ui1" ref="piece_2m"><bounds x="1.4" y="23" width="3.8" height="3.8" /></element>
		<element name="piece_ui2" ref="piece_2m"><bounds x="1.4" y="27" width="3.8" height="3.8" /></element>
		<element name="piece_ui3" ref="piece_2m"><bounds x="1.4" y="31" width="3.8" height="3.8" /></element>
		<element name="piece_ui4" ref="piece_2m"><bounds x="4.6" y="23" width="3.8" height="3.8" /></element>
		<element name="piece_ui5" ref="piece_2m"><bounds x="4.6" y="27" width="3.8" height="3.8" /></element>
		<element name="piece_ui6" ref="piece_2m"><bounds x="4.6" y="31" width="3.8" height="3.8" /></element>
		<element name="piece_ui7" ref="piece_2m"><bounds x="1.4" y="36" width="3.8" height="3.8" /></element>
		<element name="piece_ui8" ref="piece_2m"><bounds x="1.4" y="40" width="3.8" height="3.8" /></element>
		<element name="piece_ui9" ref="piece_2m"><bounds x="1.4" y="43.7" width="3.8" height="3.8" /></element>
		<element name="piece_ui10" ref="piece_2m"><bounds x="4.6" y="36" width="3.8" height="3.8" /></element>
		<element name="piece_ui11" ref="piece_2m"><bounds x="4.6" y="40" width="3.8" height="3.8" /></element>
		<element name="piece_ui12" ref="piece_2m"><bounds x="4.6" y="43.7" width="3.8" height="3.8" /></element>

		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0001"><bounds x="1" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0002"><bounds x="1" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0004"><bounds x="1" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0008"><bounds x="5" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0010"><bounds x="5" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0020"><bounds x="5" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0040"><bounds x="1" y="36" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0080"><bounds x="1" y="40" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0100"><bounds x="1" y="44" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0200"><bounds x="5" y="36" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0400"><bounds x="5" y="40" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:SPAWN" inputmask="0x0800"><bounds x="5" y="44" width="4" height="4" /><color alpha="0.25" /></element>

		<!-- HAND: -->
		
		<element name="piece_ui0" ref="piece_2m"><bounds x="2" y="52.8" width="6" height="6" /></element>

		<element ref="hlub" inputtag="board:UI" inputmask="0x08"><bounds x="1.8" y="59.2" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- undo -->

		<element ref="hlub" inputtag="board:UI" inputmask="0x10"><bounds x="1.3" y="67.65" width="2" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x20"><bounds x="3.1" y="67.65" width="1.7" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x40"><bounds x="5.2" y="67.65" width="1.7" height="2" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x80"><bounds x="6.9" y="67.65" width="2" height="2" /><color alpha="0.25" /></element>

		<element name="count_ui0" ref="text_uiu3a"><bounds x="0" y="71" width="4" height="2" /></element>
		<element name="count_ui1" ref="text_uiu3c"><bounds x="6" y="71" width="4" height="2" /></element>
		<element ref="text_uiu3b"><bounds x="4" y="71" width="2" height="2" /></element>
	</group>  

	<element name="digit" defstate="0">
		<led16segsc>
			<color red="0.4" green="1.0" blue="0.0" />
		</led16segsc>
	</element>


	<element name="black_rect">
		<rect>
			<color red="0.0" green="0.0" blue="0.0" />
		</rect>
	</element>

<group name="display">
		
	 
		<element name="digit3" ref="digit"> <bounds x="102" y="4.5" width="5.66" height="8.5" /></element>
		<element name="digit2" ref="digit"> <bounds x="108" y="4.5" width="5.66" height="8.5" /></element>
		<element name="digit1" ref="digit"> <bounds x="114" y="4.5" width="5.66" height="8.5" /></element>
		<element name="digit0" ref="digit"> <bounds x="120" y="4.5" width="5.66" height="8.5" /></element> 
</group>	 

	 
