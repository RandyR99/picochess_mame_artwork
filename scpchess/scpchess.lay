		<image file="../pieces/pnovag_plastic/br_sel.png" state="22"/>
		<image file="../pieces/pnovag_plastic/bq_sel.png" state="23"/>
		<image file="../pieces/pnovag_plastic/bk_sel.png" state="24"/>
