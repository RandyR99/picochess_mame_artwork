	<group name="sb_board_m_porta">
		<bounds x="0" y="0" width="80" height="80" />
		<repeat count="8">
			<param name="y" start="-6.2" increment="10.15" />
			<param name="i" start="8" increment="-1" />
			<param name="z" start="0" increment="10" />
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01">
				<bounds x="0" y="~z~" width="10" height="10" />
				<color alpha="0.04" />
			</element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02">
				<bounds x="10" y="~z~" width="10" height="10" />
				<color alpha="0.04" />
			</element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04">
				<bounds x="20" y="~z~" width="10" height="10" />
				<color alpha="0.04" />
			</element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08">
				<bounds x="30" y="~z~" width="10" height="10" />
				<color alpha="0.04" />
			</element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10">
				<bounds x="40" y="~z~" width="10" height="10" />
				<color alpha="0.04" />
			</element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20">
				<bounds x="50" y="~z~" width="10" height="10" />
				<color alpha="0.04" />
			</element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40">
				<bounds x="60" y="~z~" width="10" height="10" />
				<color alpha="0.04" />
			</element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80">
				<bounds x="70" y="~z~" width="10" height="10" />
				<color alpha="0.04" />
			</element>
			<element name="piece_a~i~" ref="piece_m">
				<bounds x="-3.4" y="~y~" width="16" height="16" />
			</element>
			<element name="piece_b~i~" ref="piece_m">
				<bounds x="6.4" y="~y~" width="16" height="16" />
			</element>
			<element name="piece_c~i~" ref="piece_m">
				<bounds x="16.4" y="~y~" width="16" height="16" />
			</element>
			<element name="piece_d~i~" ref="piece_m">
				<bounds x="26.5" y="~y~" width="16" height="16" />
			</element>
			<element name="piece_e~i~" ref="piece_m">
				<bounds x="36.4" y="~y~" width="16" height="16" />
			</element>
			<element name="piece_f~i~" ref="piece_m">
				<bounds x="46.4" y="~y~" width="16" height="16" />
			</element>
			<element name="piece_g~i~" ref="piece_m">
				<bounds x="56.4" y="~y~" width="16" height="16" />
			</element>
			<element name="piece_h~i~" ref="piece_m">
				<bounds x="66.4" y="~y~" width="16" height="16" />
			</element>
		</repeat>
	</group>

