		<image file="sw_1.png" state="1" />
		<image file="sw_0.png" state="0" />
	</element>
	<element name="but_porta" defstate="0">
		<image file="../buttons/but2a_sel.png" state="1" />
		<image file="../buttons/but2a.png" state="0" />
	</element>
