<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->

	<element name="fex68k">
		<image file="../fexceld/fexceld.png" />
	</element>
	
	<element name="background">
		<image file="../misc/background4.png" />
	</element>
	
	<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>
	
	
<element name="piece" defstate="0">
		<image file="../pieces/pmephisto2/wp.png" state="1"/>
		<image file="../pieces/pmephisto2/wkn.png" state="2"/>
		<image file="../pieces/pmephisto2/wb.png" state="3"/>
		<image file="../pieces/pmephisto2/wr.png" state="4"/>
		<image file="../pieces/pmephisto2/wq.png" state="5"/>
		<image file="../pieces/pmephisto2/wk.png" state="6"/>
		<image file="../pieces/pmephisto2/bp.png" state="7"/>
		<image file="../pieces/pmephisto2/bkn.png" state="8"/>
		<image file="../pieces/pmephisto2/bb.png" state="9"/>
		<image file="../pieces/pmephisto2/br.png" state="10"/>
		<image file="../pieces/pmephisto2/bq.png" state="11"/>
		<image file="../pieces/pmephisto2/bk.png" state="12"/>
		<image file="../pieces/pmephisto2/wp_sel.png" state="13"/>
		<image file="../pieces/pmephisto2/wkn_sel.png" state="14"/>
		<image file="../pieces/pmephisto2/wb_sel.png" state="15"/>
		<image file="../pieces/pmephisto2/wr_sel.png" state="16"/>
		<image file="../pieces/pmephisto2/wq_sel.png" state="17"/>
		<image file="../pieces/pmephisto2/wk_sel.png" state="18"/>
		<image file="../pieces/pmephisto2/bp_sel.png" state="19"/>
		<image file="../pieces/pmephisto2/bkn_sel.png" state="20"/>
		<image file="../pieces/pmephisto2/bb_sel.png" state="21"/>
		<image file="../pieces/pmephisto2/br_sel.png" state="22"/>
		<image file="../pieces/pmephisto2/bq_sel.png" state="23"/>
		<image file="../pieces/pmephisto2/bk_sel.png" state="24"/>
	</element>

<element name="piece_2m" defstate="0">
	     <image file="../pieces/chess2/wp.png" state="1"/>
		<image file="../pieces/chess2/wn.png" state="2"/>
		<image file="../pieces/chess2/wb.png" state="3"/>
		<image file="../pieces/chess2/wr.png" state="4"/>
		<image file="../pieces/chess2/wq.png" state="5"/>
		<image file="../pieces/chess2/wk.png" state="6"/>

		<image file="../pieces/chess2/bp.png" state="7"/>
		<image file="../pieces/chess2/bn.png" state="8"/>
		<image file="../pieces/chess2/bb.png" state="9"/>
		<image file="../pieces/chess2/br.png" state="10"/>
		<image file="../pieces/chess2/bq.png" state="11"/>
		<image file="../pieces/chess2/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../pieces/chess2/wp.png" state="13"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wn.png" state="14"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wb.png" state="15"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wr.png" state="16"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wq.png" state="17"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wk.png" state="18"><color alpha="0.5" /></image>

		<image file="../pieces/chess2/bp.png" state="19"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bn.png" state="20"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bb.png" state="21"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/br.png" state="22"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bq.png" state="23"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bk.png" state="24"><color alpha="0.5" /></image>
	</element>


      <element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="digit_led" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.2" green="0.01" blue="0.015" /></disk>
	</element>

		<element name="led" defstate="0">
	<image file="../leds/red2a_sel.png" state="1"/>
	<image file="../leds/red2a.png" state="0"/>
	</element>




	<element name="newgame" defstate="0">
	<image file="../fexceld/newgame.png" state="0"/>
    <image file="../fexceld/newgame_sel.png" state="1"/>
	</element>

	<element name="verify" defstate="0">
	<image file="../fexceld/verify.png" state="0"/>
    <image file="../fexceld/verify_sel.png" state="1"/>
	</element>

	<element name="options" defstate="0">
	<image file="../fexceld/options.png" state="0"/>
    <image file="../fexceld/options_sel.png" state="1"/>
	</element>

	<element name="level" defstate="0">
	<image file="../fexceld/level.png" state="0"/>
    <image file="../fexceld/level_sel.png" state="1"/>
	</element>

	<element name="hint" defstate="0">
	<image file="../fexceld/hint.png" state="0"/>
    <image file="../fexceld/hint_sel.png" state="1"/>
	</element>

	<element name="move" defstate="0">
	<image file="../fexceld/move.png" state="0"/>
    <image file="../fexceld/move_sel.png" state="1"/>
	</element>

	<element name="clear" defstate="0">
	<image file="../fexceld/clear.png" state="0"/>
    <image file="../fexceld/clear_sel.png" state="1"/>
	</element>

	<element name="takeback" defstate="0">
	<image file="../fexceld/takeback.png" state="0"/>
    <image file="../fexceld/takeback_sel.png" state="1"/>
	</element>

	<element name="hl" defstate="0">
<!--
		<text string=" ">
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="1.0" green="1.0" blue="1.0" />
		</disk>
-->
	</element>
	<element name="hlb" defstate="0">
		<text string=" ">
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="0.0" green="0.0" blue="0.0" />
		</text>
		<rect state="1">
			<bounds x="0.0" y="0.0" width="1.0" height="1.0" />
			<color red="1.0" green="1.0" blue="1.0" />
		</rect>
	</element>

<element name="hlbb" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk>
	</element>


<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />

	

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-5" increment="10" />
			<param name="i" start="8" increment="-1" />
<param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece"><bounds x="-2" y="~y~" width="14" height="14" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="7.8"  y="~y~" width="14" height="14" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="18" y="~y~" width="14" height="14" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="28.1" y="~y~" width="14" height="14" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="38.2" y="~y~" width="14" height="14" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="48.2" y="~y~" width="14" height="14" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="58.2" y="~y~" width="14" height="14" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="68.2" y="~y~" width="14" height="14" /></element>
		</repeat>
	</group>
	
	<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

	

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-0.50" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="0"  y="~y~" width="9.5" height="9.5" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10" y="~y~" width="9.5" height="9.5" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20" y="~y~" width="9.5" height="9.5" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30" y="~y~" width="9.5" height="9.5" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40.1" y="~y~" width="9.5" height="9.5" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50.2" y="~y~" width="9.5" height="9.5" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60.3" y="~y~" width="9.5" height="9.5" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70.4" y="~y~" width="9.5" height="9.5" /></element>
		</repeat>
	</group>

<!-- sb ui -->

<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>


	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>


	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui"><bounds x="0" y="0" width="10" height="80" />
		

		<!-- board -->
		

		<element ref="hlub" inputtag="board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>

		<!-- spawn -->
		

		<element name="piece_ui1" ref="piece_2m"><bounds x="1.4" y="23"    width="3.7" height="3.8" /></element>
		<element name="piece_ui2" ref="piece_2m"><bounds x="1.4" y="27"    width="3.7" height="3.8" /></element>
