<?xml version="1.0"?>
<mamelayout version="2">

<!-- note: no chesspieces simulation here, h+g mephisto/mephisto ii didn't have a built-in chessboard -->

<!-- define elements -->

	<element name="mephisto">
		<image file="m1c.png" />
	</element>

<!-- foto: mythbuster -->

<!-- display -->

	<element name="lcd_bg"><rect><color red="0.54" green="0.57" blue="0.58" /></rect></element>

	<element name="digit" defstate="0">
		<led7seg><color red="0.2" green="0.16" blue="0.16" /></led7seg>
	</element>
	<element name="ldot" defstate="0">
		<rect state="1"><color red="0.2" green="0.16" blue="0.16" /></rect>
		<rect state="0"><color red="0.49412" green="0.51765" blue="0.51765" /></rect>
	</element>


<element name="hlb" defstate="0">
		<rect state="1"><color red="1" green="1" blue="1" /></rect>
	</element>



<group name="display">
		<bounds x="31" y="90.3" width="22.5" height="7.4" />

		<element name="digit3" ref="digit"><bounds x="32" y="91" width="4" height="6" /></element>
		<element name="digit2" ref="digit"><bounds x="37.5" y="91" width="4" height="6" /></element>
		<element name="digit1" ref="digit"><bounds x="43" y="91" width="4" height="6" /></element>
		<element name="digit0" ref="digit"><bounds x="48.5" y="91" width="4" height="6" /></element>

		
	</group>


<view name="artwork by luis">

<element ref="mephisto">
			<bounds x="0" y="0" width="1091" height="692" />
		</element>

<group ref="display"><bounds x="140" y="233" width="281" height="120" /></group>



<element ref="hlb" inputtag="IN.0" inputmask="0x01"><bounds x="612"  y="233" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="IN.2" inputmask="0x01"><bounds x="708"  y="233" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="IN.1" inputmask="0x04"><bounds x="802" y="233" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="IN.3" inputmask="0x04"><bounds x="892" y="233" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="RESET" inputmask="0x01"><bounds x="892" y="135" width="62" height="65" /><color alpha="0.08" /></element>

		<element ref="hlb" inputtag="IN.0" inputmask="0x02"><bounds x="612"  y="331" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="IN.0" inputmask="0x08"><bounds x="708"  y="331" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="IN.1" inputmask="0x02"><bounds x="802" y="331" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="IN.1" inputmask="0x01"><bounds x="892" y="329" width="62" height="65" /><color alpha="0.08" /></element>

		<element ref="hlb" inputtag="IN.1" inputmask="0x08"><bounds x="612"  y="430" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="IN.2" inputmask="0x02"><bounds x="708"  y="430" width="62" height="65" /><color alpha="0.08" /></element>
		<element ref="hlb" inputtag="IN.2" inputmask="0x08"><bounds x="802" y="428" width="62" height="65" /><color alpha="0.08" /></element>
