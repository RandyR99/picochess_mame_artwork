	</element>

	<group name="display">
		<screen index="0" blend="alpha"><bounds x="0" y="0" width="100" height="114.65" /></screen>
		<element ref="nothing" blend="add" inputtag="IN.7" inputmask="0x00" inputraw="1"><bounds x="0" y="0" width="100" height="114.65" /></element>
		<element ref="lcd_bg" blend="multiply" inputtag="IN.7" inputmask="0x02" inputraw="1"><bounds x="0" y="0" width="100" height="114.65" /></element>
		<element ref="lcd_cb" blend="multiply"><bounds x="0" y="0" width="100" height="95.9" /></element>
	</group>

	<group name="displayc">
		<bounds x="19.9" y="8" width="111.6" height="127.65" />

		<element ref="white"><bounds x="19.9" y="19.9" width="101.1" height="115.75" /></element>
		<group ref="display"><bounds x="20" y="20" width="100" height="114.65" /></group>
		<element ref="white"><bounds x="20" y="124.5" width="100.5" height="2" /></element>
		<element ref="white"><bounds x="19.9" y="19.9" width="1" height="115.75" /></element>
		<element ref="white"><bounds x="19.9" y="19" width="101.1" height="1" /></element>
	</group>

	<!-- same, with the coordinate labels: for the large display outside the picture -->
	<group name="displayc_labels">
		<bounds x="19.9" y="8" width="111.6" height="127.65" />

		<element ref="white"><bounds x="19.9" y="19.9" width="101.1" height="115.75" /></element>
		<group ref="display"><bounds x="20" y="20" width="100" height="114.65" /></group>
		<element ref="white"><bounds x="20" y="124.5" width="100.5" height="2" /></element>
		<element ref="white"><bounds x="19.9" y="19.9" width="1" height="115.75" /></element>
		<element ref="white"><bounds x="19.9" y="19" width="101.1" height="1" /></element>

		<repeat count="8">
			<param name="x" start="22.25" increment="11.98" />
			<param name="i" start="8" increment="-1" />
			<element ref="text_cl~i~"><bounds x="~x~" y="8" width="11.98" height="4.5" /></element>
		</repeat>
		<repeat count="8">
			<param name="x" start="22.25" increment="11.98" />
			<param name="i" start="1" increment="1" />
			<element ref="text_cl~i~"><bounds x="~x~" y="12" width="11.98" height="6" /></element>
		</repeat>
		<repeat count="8">
			<param name="y" start="25.44" increment="11.38" />
			<param name="i" start="8" increment="-1" />
			<element ref="text_cn~i~"><bounds x="122" y="~y~" width="5" height="6" /></element>
		</repeat>
		<repeat count="8">
			<param name="y" start="26.19" increment="11.38" />
			<param name="i" start="1" increment="1" />
			<element ref="text_cn~i~"><bounds x="126.5" y="~y~" width="5" height="4.5" /></element>
		</repeat>
	</group>


