<mamelayout version="2">

<!-- define elements -->

<element name="scisys">
		<image file="mark5l.png" />
	</element>

<element name="background">
		<image file="../misc/background4_black.png" />
	</element>

	<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>
	<element name="black"><rect><color red="0.21" green="0.2" blue="0.2" /></rect></element>
	<element name="blackd"><disk><color red="0.21" green="0.2" blue="0.2" /></disk></element>
	<element name="white"><rect><color red="0.85" green="0.78" blue="0.58" /></rect></element>
	<element name="whited"><disk><color red="0.81" green="0.8" blue="0.79" /></disk></element>

	<element name="nothing" defstate="0"><text string=" "/></element>


<!-- buttons -->

	<element name="hl" defstate="0">
		<rect state="0"><color red="0" green="0" blue="0" /></rect>
		<rect state="1"><color red="0.11" green="0.11" blue="0.11" /></rect>
	</element>
	<element name="hlc" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="80" height="80" />
			<color red="0.11" green="0.11" blue="0.11" />
		</disk>
	</element>

<element name="lcd" defstate="0">
	<image file="lcd_1.png" state="1"/>
	<image file="lcd_0.png" state="0"/>
</element>

<element name="sound" defstate="0">
	<image file="sound_1.png" state="1"/>
	<image file="sound_0.png" state="0"/>
</element>



	

	


<!-- display -->

	<element name="text_cl1"><text string="a"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_cl2"><text string="b"><color red="0.81" green="0.8" blue="0.79" /></text></element>
