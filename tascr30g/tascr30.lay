	<element name="cblack"><rect><color red="0.56" green="0.33" blue="0.12" /></rect></element>
	<element name="cwhite"><rect><color red="0.84" green="0.75" blue="0.50" /></rect></element>
	<element name="board_border"><rect><color red="0.00" green="0.00" blue="0.00" /></rect></element>

	<element name="hlbb" defstate="0">
<!--	
	<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk> -->
	</element>

	<group name="sb_board">
		<bounds x="0" y="0" width="82" height="82" />
		<element ref="board_border"><bounds x="0.7" y="0.7" width="0"  height="0" /></element>
		<element ref="board_border"><bounds x="81"  y="0.7" width="0"  height="0" /></element>
		<element ref="board_border"><bounds x="0.7" y="0.7" width="0" height="0"  /></element>
		<element ref="board_border"><bounds x="0.7" y="81"  width="0" height="0"  /></element>

	

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />
            <param name="z" start="-4" increment="10" />
				
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x01"><bounds x="1"  y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x02"><bounds x="11" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x04"><bounds x="21" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x08"><bounds x="31" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x10"><bounds x="41" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x20"><bounds x="51" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x40"><bounds x="61" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x80"><bounds x="71" y="~y~" width="10" height="10" /></element>

			<element name="piece_a~i~" ref="piece"><bounds x="-1.7" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="8.3" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="18.3" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="28.3" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="38.3" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="48.3" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="58.3" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="68.3" y="~z~" width="14.5" height="14.5" /></element>
		</repeat>





		<!-- 81 leds from 64 outputs -->
		
		
			<repeat count="9">
			<param name="x" start="0.5" increment="10" />
			<repeat count="9">
				<param name="y" start="0.5" increment="10" />
				<element ref="ledo"><bounds x="~x~" y="~y~" width="1" height="1" /></element>
			</repeat>
		</repeat>

		<repeat count="8">
			<param name="x" start="80.5" increment="-10" />
			<param name="i" start="0" increment="1" />
			<repeat count="8">
				<param name="y" start="0.5" increment="10" />
				<param name="j" start="0" increment="1" />
				<element name="sb30_led_~j~.~i~" ref="ledr"><bounds x="~x~" y="~y~" width="1" height="1" /></element>
			</repeat>
			<repeat count="8">
				<param name="y" start="10.5" increment="10" />
				<param name="j" start="0" increment="1" />
				<element name="sb30_led_~j~.~i~" ref="ledr"><bounds x="~x~" y="~y~" width="1" height="1" /></element>
			</repeat>
		</repeat>

		<repeat count="8">
			<param name="x" start="70.5" increment="-10" />
			<param name="i" start="0" increment="1" />
			<repeat count="8">
				<param name="y" start="0.5" increment="10" />
				<param name="j" start="0" increment="1" />
				<element name="sb30_led_~j~.~i~" ref="ledr"><bounds x="~x~" y="~y~" width="1" height="1" /></element>
			</repeat>
			<repeat count="8">
				<param name="y" start="10.5" increment="10" />
				<param name="j" start="0" increment="1" />
				<element name="sb30_led_~j~.~i~" ref="ledr"><bounds x="~x~" y="~y~" width="1" height="1" /></element>
			</repeat>
		</repeat>
	</group>

