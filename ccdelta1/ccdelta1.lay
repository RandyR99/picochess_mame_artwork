<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

<element name="novag">
		<image file="delta1c.png" />
	</element>



	

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	


<element name="RESET" defstate="0">
	  <image file="RESET_0.png" state="0"/>
      <image file="RESET_1.png" state="1"/>
	</element>

	<element name="but1" defstate="0">
    <image file="down_sel1.png" state="1"/>
	</element>

<element name="but2" defstate="0">
    <image file="down_sel2.png" state="1"/>
	</element>

<element name="but3" defstate="0">
    <image file="down_sel3.png" state="1"/>
	</element>

	<element name="led" defstate="1">
	<image file="../leds/red_sel.png" state="0"/>
	<image file="../leds/red.png" state="1"/>
	</element>




<group name="display">


		<element ref="led"><bounds x="4.5" y="13.5" width="2.5" height="2.5" /></element> <!-- power led, always on -->

		<element name="digit3" ref="digit"><bounds x="10" y="5.5" width="7" height="10.5" /></element>
		<element name="digit2" ref="digit"><bounds x="17" y="5.5" width="7" height="10.5" /></element>
		<element name="digit1" ref="digit"><bounds x="24" y="5.5" width="7" height="10.5" /></element>
		<element name="digit0" ref="digit"><bounds x="31" y="5.5" width="7" height="10.5" /></element>

</group>

<!-- build screen -->

	<view name="artwork by luis">
<bounds left="0" right="1280" top="0" bottom="667" />




<element ref="novag">
			<bounds x="0" y="0" width="1280" height="667" />
		</element>

<group ref="display"><bounds x="260" y="205" width="232" height="55" /></group>


		

		

		
		
