<mamelayout version="2">



<!-- define elements -->

<element name="board">
		<image file="pchess.jpg" />
	</element>



<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>


	<element name="black"><rect><color red="0.12" green="0.12" blue="0.12" /></rect></element>
	<element name="black2"><rect><color red="0.16" green="0.16" blue="0.16" /></rect></element>
	<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>
	<element name="red"><rect><color red="0.8" green="0.2" blue="0.25" /></rect></element>

	

	<element name="hl" defstate="0">
		<text string=" "/>
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>


<element name="ledr" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	    <image file="../leds/red4.png" state="0"/>
</element>

<element name="ledg" defstate="0">
	<image file="../leds/green_sel.png" state="1"/>
	<image file="../leds/green.png" state="0"/>
	</element>

	<element name="but" defstate="0">
    <image file="../buttons/but2a.png" state="0"/>
    <image file="../buttons/but2a_sel.png" state="1"/>
	</element>

	
<element name="piece_2m" defstate="0">
		<image file="../pieces/chess2/wp.png" state="1"/>
		<image file="../pieces/chess2/wn.png" state="2"/>
		<image file="../pieces/chess2/wb.png" state="3"/>
