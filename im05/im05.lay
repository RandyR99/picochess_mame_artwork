<?xml version="1.0"?>
<!--
license:cc0
-->
<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

	<element name="im01">
		<image file="elektronika.jpg" />
	</element>

    <element name="im01_eng">
		<image file="elektronika_eng.jpg" />
	</element>

	<element name="digit" defstate="0">
		<led7seg><color red="0.15" green="1.0" blue="0.05" /></led7seg>
	</element>

	<element name="led" defstate="0">
		<disk state="1"><color red="0.15" green="1.0" blue="0.05" /></disk>
		<disk state="0"><color red="0.015" green="0.1" blue="0.005" /></disk>
	</element>

<element name="hlb" defstate="0">
		<image file="../buttons/down1_sel.png" state="1"/>
	</element>

<group name="display">
		
		<element name="digit4" ref="digit"><bounds x="-0.9" y="11" width="4" height="6" /></element>
		<element name="digit3" ref="digit"><bounds x="3.8" y="11" width="4" height="6" /></element>
		<element name="digit1" ref="digit"><bounds x="9.7" y="11" width="4" height="6" /></element>
		<element name="digit0" ref="digit"><bounds x="14.4" y="11" width="4" height="6" /></element>

		<element name="2.0" ref="led"><bounds x="8.6" y="12.0" width="0.6" height="0.6" /></element>
		<element name="2.3" ref="led"><bounds x="8.4" y="15.5" width="0.6" height="0.6" /></element>
</group>

<!-- build screen -->

	<view name="artwork by luis (english) ">

<element ref="im01_eng">
			<bounds x="0" y="0" width="1200" height="874" />
		</element>

<group ref="display"><bounds x="942" y="80" width="126" height="60" /></group>

         <element ref="hlb" inputtag="IN.3" inputmask="0x01"><bounds x="955"  y="243" width="40" height="32" /></element> <!-- h8 -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x02"><bounds x="956"  y="313" width="40" height="32" /></element> <!-- g7 -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x04"><bounds x="956"  y="384" width="40" height="32" /></element>  <!-- f6 -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x08"><bounds x="956"  y="454" width="40" height="32" /></element>  <!-- e5 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x01"><bounds x="957"  y="525" width="40" height="32" /></element> <!-- d4 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x02"><bounds x="958"  y="596" width="40" height="32" /></element> <!-- c3 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x04"><bounds x="958"  y="666" width="40" height="32" /></element>  <!-- b2 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x08"><bounds x="958"  y="736" width="40" height="32" /></element>  <!-- a1 -->
                                             
		<element ref="hlb" inputtag="IN.4" inputmask="0x01"><bounds x="1014"  y="243" width="42" height="32" /></element>  <!-- фиг (prefix key) --> 
		<element ref="hlb" inputtag="IN.4" inputmask="0x02"><bounds x="1016"  y="313" width="41" height="32" /></element>  <!-- и (show analyzed move) -->
		<element ref="hlb" inputtag="IN.4" inputmask="0x04"><bounds x="1016"  y="384" width="41" height="32" /></element>   <!-- white -->
		<element ref="hlb" inputtag="IN.4" inputmask="0x08"><bounds x="1016"  y="453" width="41" height="32" /></element>   <!-- рз (position mode) -->
        <element ref="hlb" inputtag="IN.1" inputmask="0x01"><bounds x="1017"  y="525" width="41" height="32" /></element>  <!-- n (show moves) -->
		<element ref="hlb" inputtag="IN.1" inputmask="0x02"><bounds x="1017"  y="596" width="41" height="32" /></element>  <!-- вар (enter variant) -->
		<element ref="hlb" inputtag="IN.1" inputmask="0x04"><bounds x="1017"  y="666" width="41" height="32" /></element>   <!-- ? (verify position) --> 
		<element ref="hlb" inputtag="IN.1" inputmask="0x08"><bounds x="1017"  y="736" width="41" height="32" /></element>   <!-- show depth -->
                                             
        <element ref="hlb" inputtag="IN.5" inputmask="0x01"><bounds x="1075"  y="243" width="40" height="32" /></element>  <!-- нп (RESET board) --> 
		<element ref="hlb" inputtag="IN.5" inputmask="0x02"><bounds x="1076"  y="313" width="40" height="32" /></element>  <!-- сд (CLEAR board) -->
		<element ref="hlb" inputtag="IN.5" inputmask="0x04"><bounds x="1076"  y="384" width="40" height="32" /></element>   <!-- black -->
		<element ref="hlb" inputtag="IN.5" inputmask="0x08"><bounds x="1076"  y="454" width="40" height="32" /></element>   <!-- set level -->
        <element ref="hlb" inputtag="IN.2" inputmask="0x01"><bounds x="1077"  y="525" width="40" height="32" /></element>  <!-- take back -->
		<element ref="hlb" inputtag="IN.2" inputmask="0x02"><bounds x="1077"  y="596" width="40" height="32" /></element>  <!-- пх (move) -->
		<element ref="hlb" inputtag="IN.2" inputmask="0x04"><bounds x="1078"  y="666" width="40" height="32" /></element>   <!-- cи (CLEAR entry) --> 
		<element ref="hlb" inputtag="IN.2" inputmask="0x08"><bounds x="1078"  y="736" width="40" height="32" /></element>   <!-- enter -->

	</view>


<view name="artwork by luis">

<element ref="im01">
			<bounds x="0" y="0" width="1200" height="874" />
		</element>

<group ref="display"><bounds x="942" y="80" width="126" height="60" /></group>

        <element ref="hlb" inputtag="IN.3" inputmask="0x01"><bounds x="955"  y="243" width="40" height="32" /></element> <!-- h8 -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x02"><bounds x="956"  y="313" width="40" height="32" /></element> <!-- g7 -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x04"><bounds x="956"  y="384" width="40" height="32" /></element>  <!-- f6 -->
		<element ref="hlb" inputtag="IN.3" inputmask="0x08"><bounds x="956"  y="454" width="40" height="32" /></element>  <!-- e5 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x01"><bounds x="957"  y="525" width="40" height="32" /></element> <!-- d4 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x02"><bounds x="958"  y="596" width="40" height="32" /></element> <!-- c3 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x04"><bounds x="958"  y="666" width="40" height="32" /></element>  <!-- b2 -->
		<element ref="hlb" inputtag="IN.0" inputmask="0x08"><bounds x="958"  y="736" width="40" height="32" /></element>  <!-- a1 -->
                                             
		<element ref="hlb" inputtag="IN.4" inputmask="0x01"><bounds x="1014"  y="243" width="42" height="32" /></element>  <!-- фиг (prefix key) --> 
		<element ref="hlb" inputtag="IN.4" inputmask="0x02"><bounds x="1016"  y="313" width="41" height="32" /></element>  <!-- и (show analyzed move) -->
		<element ref="hlb" inputtag="IN.4" inputmask="0x04"><bounds x="1016"  y="384" width="41" height="32" /></element>   <!-- white -->
		<element ref="hlb" inputtag="IN.4" inputmask="0x08"><bounds x="1016"  y="453" width="41" height="32" /></element>   <!-- рз (position mode) -->
        <element ref="hlb" inputtag="IN.1" inputmask="0x01"><bounds x="1017"  y="525" width="41" height="32" /></element>  <!-- n (show moves) -->
		<element ref="hlb" inputtag="IN.1" inputmask="0x02"><bounds x="1017"  y="596" width="41" height="32" /></element>  <!-- вар (enter variant) -->
		<element ref="hlb" inputtag="IN.1" inputmask="0x04"><bounds x="1017"  y="666" width="41" height="32" /></element>   <!-- ? (verify position) --> 
		<element ref="hlb" inputtag="IN.1" inputmask="0x08"><bounds x="1017"  y="736" width="41" height="32" /></element>   <!-- show depth -->
                                             
        <element ref="hlb" inputtag="IN.5" inputmask="0x01"><bounds x="1075"  y="243" width="40" height="32" /></element>  <!-- нп (RESET board) --> 
		<element ref="hlb" inputtag="IN.5" inputmask="0x02"><bounds x="1076"  y="313" width="40" height="32" /></element>  <!-- сд (CLEAR board) -->
		<element ref="hlb" inputtag="IN.5" inputmask="0x04"><bounds x="1076"  y="384" width="40" height="32" /></element>   <!-- black -->
		<element ref="hlb" inputtag="IN.5" inputmask="0x08"><bounds x="1076"  y="454" width="40" height="32" /></element>   <!-- set level -->
        <element ref="hlb" inputtag="IN.2" inputmask="0x01"><bounds x="1077"  y="525" width="40" height="32" /></element>  <!-- take back -->
		<element ref="hlb" inputtag="IN.2" inputmask="0x02"><bounds x="1077"  y="596" width="40" height="32" /></element>  <!-- пх (move) -->
		<element ref="hlb" inputtag="IN.2" inputmask="0x04"><bounds x="1078"  y="666" width="40" height="32" /></element>   <!-- cи (CLEAR entry) --> 
		<element ref="hlb" inputtag="IN.2" inputmask="0x08"><bounds x="1078"  y="736" width="40" height="32" /></element>   <!-- enter -->

	</view>
	

</mamelayout>