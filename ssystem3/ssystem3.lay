	<element name="lcd_bg" defstate="1">
		<rect state="1"><color red="0.55" green="0.52" blue="0.44" /></rect>
		<rect state="0"><color red="0.52" green="0.49" blue="0.41" /></rect>
	</element>

	<element name="hl" defstate="0">
		<text string=" "/>
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="nothing" defstate="0">
		<text string=" "/>
	</element>






