<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->


<element name="arb" >
		<image file="../arb/arb.png" />
	</element>

<element name="background_grey">
		<image file="../misc/background4.png" />
	</element>

<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>

<element name="sargon_3.5_logo" >
		<image file="sargon_3.5.png" />
	</element>	
		

	<element name="black"><rect><color red="0.17" green="0.15" blue="0.15" /></rect></element>
	<element name="white"><rect><color red="0.81" green="0.8" blue="0.79" /></rect></element>
	

	<element name="led" defstate="0">
	<image file="../leds/red_0.png" state="0"/>
	<image file="../leds/red_1a.png" state="1"/>
	</element>



<element name="led2" defstate="0">
	<image file="../leds/red_0.png" state="0"/>
	<image file="../leds/red_1a.png" state="1"/>
	</element>


		<element name="led2y" defstate="0">
    <image file="../leds/yellow_0.png" state="0"/>
	<image file="../leds/yellow_1.png" state="1"/>
	</element>




	<element name="led2g" defstate="0">
	<image file="../leds/green_0.png" state="0"/>
	<image file="../leds/green_1.png" state="1"/>
	</element>


	<element name="bt" defstate="0">
   <image file="../buttons/button_0a.png" state="0"/>
   <image file="../buttons/button4_sel.png" state="1"/>
	</element>

<element name="pawn" >
		<image file="../arb/pawn.png" />
	</element>

<element name="rook" >
		<image file="../arb/rook.png" />
	</element>

<element name="knight" >
		<image file="../arb/knight.png" />
	</element>

<element name="bishop" >
		<image file="../arb/bishop.png" />
	</element>

<element name="queen" >
		<image file="../arb/queen.png" />
	</element>

<element name="king" >
		<image file="../arb/king.png" />
	</element>



	


<!-- sb board -->

	<element name="cblack"><rect><color red="0.5" green="0.37" blue="0.3" /></rect></element>
	<element name="cwhite"><rect><color red="0.81" green="0.8" blue="0.79" /></rect></element>

	<element name="hlbb" defstate="0">

<!--
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk> -->
	</element>

<element name="piece" defstate="0">
		<image file="../pieces/pmephisto5/wp.png" state="1"/>
		<image file="../pieces/pmephisto5/wkn.png" state="2"/>
		<image file="../pieces/pmephisto5/wb.png" state="3"/>
		<image file="../pieces/pmephisto5/wr.png" state="4"/>
		<image file="../pieces/pmephisto5/wq.png" state="5"/>
		<image file="../pieces/pmephisto5/wk.png" state="6"/>
		<image file="../pieces/pmephisto5/bp.png" state="7"/>
		<image file="../pieces/pmephisto5/bkn.png" state="8"/>
		<image file="../pieces/pmephisto5/bb.png" state="9"/>
		<image file="../pieces/pmephisto5/br.png" state="10"/>
		<image file="../pieces/pmephisto5/bq.png" state="11"/>
		<image file="../pieces/pmephisto5/bk.png" state="12"/>
		<image file="../pieces/pmephisto5/wp_sel.png" state="15"/>
		<image file="../pieces/pmephisto5/wkn_sel.png" state="16"/>
		<image file="../pieces/pmephisto5/wb_sel.png" state="17"/>
		<image file="../pieces/pmephisto5/wr_sel.png" state="18"/>
		<image file="../pieces/pmephisto5/wq_sel.png" state="19"/>
		<image file="../pieces/pmephisto5/wk_sel.png" state="20"/>
		<image file="../pieces/pmephisto5/bp_sel.png" state="21"/>
		<image file="../pieces/pmephisto5/bkn_sel.png" state="22"/>
		<image file="../pieces/pmephisto5/bb_sel.png" state="23"/>
		<image file="../pieces/pmephisto5/br_sel.png" state="24"/>
		<image file="../pieces/pmephisto5/bq_sel.png" state="25"/>
		<image file="../pieces/pmephisto5/bk_sel.png" state="26"/>
	</element>

<element name="piece_2m" defstate="0">
	     <image file="../pieces/chess2/wp.png" state="1"/>
		<image file="../pieces/chess2/wn.png" state="2"/>
		<image file="../pieces/chess2/wb.png" state="3"/>
		<image file="../pieces/chess2/wr.png" state="4"/>
		<image file="../pieces/chess2/wq.png" state="5"/>
		<image file="../pieces/chess2/wk.png" state="6"/>

		<image file="../pieces/chess2/bp.png" state="7"/>
		<image file="../pieces/chess2/bn.png" state="8"/>
		<image file="../pieces/chess2/bb.png" state="9"/>
		<image file="../pieces/chess2/br.png" state="10"/>
		<image file="../pieces/chess2/bq.png" state="11"/>
		<image file="../pieces/chess2/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../pieces/chess2/wp.png" state="15"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wn.png" state="16"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wb.png" state="17"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wr.png" state="18"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wq.png" state="19"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/wk.png" state="20"><color alpha="0.5" /></image>

		<image file="../pieces/chess2/bp.png" state="21"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bn.png" state="22"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bb.png" state="23"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/br.png" state="24"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bq.png" state="25"><color alpha="0.5" /></image>
		<image file="../pieces/chess2/bk.png" state="26"><color alpha="0.5" /></image>
	</element>

	<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />

		

		<!-- leds -->
		<repeat count="8">
			<param name="y" start="8.5" increment="10" />
			<param name="i2" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="8.5" increment="10" />
				<param name="i1" start="0" increment="1" />
				<element name="~i1~.~i2~" ref="led"><bounds x="~x~" y="~y~" width="1.15" height="1.15" /></element>
			</repeat>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="-5.8" increment="10" />

<param name="z" start="0" increment="10" />

			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~z~" width="10" height="10" /><color alpha="0.1" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~z~" width="10" height="10" /><color alpha="0.1" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~z~" width="10" height="10" /><color alpha="0.1" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~z~" width="10" height="10" /><color alpha="0.1" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~z~" width="10" height="10" /><color alpha="0.1" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~z~" width="10" height="10" /><color alpha="0.1" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~z~" width="10" height="10" /><color alpha="0.1" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~z~" width="10" height="10" /><color alpha="0.1" /></element>




			<element name="piece_a~i~" ref="piece"><bounds x="-2.3" y="~y~" width="15" height="15" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="7.7" y="~y~"  width="15" height="15" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="17.7" y="~y~" width="15" height="15" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="27.7" y="~y~" width="15" height="15" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="37.7" y="~y~" width="15" height="15" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="47.7" y="~y~" width="15" height="15" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="57.7" y="~y~" width="15" height="15" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="67.7" y="~y~" width="15" height="15" /></element>
		</repeat>
	</group>
	
	<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />

		

		<repeat count="8">
			<param name="y" start="8.5" increment="10" />
			<param name="i2" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="8.5" increment="10" />
				<param name="i1" start="0" increment="1" />
				<element name="~i1~.~i2~" ref="led"><bounds x="~x~" y="~y~" width="1.15" height="1.15" /></element>
			</repeat>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="0"  y="~y~" width="9.9" height="9.9" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10" y="~y~" width="9.9" height="9.9" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20" y="~y~" width="9.9" height="9.9" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30" y="~y~" width="9.9" height="9.9" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40" y="~y~" width="9.9" height="9.9" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50" y="~y~" width="9.9" height="9.9" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60" y="~y~" width="9.9" height="9.9" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70" y="~y~" width="9.9" height="9.9" /></element>
		</repeat>
	</group>


<!-- sb ui -->

<element name="blackb"><rect><color red="0" green="0" blue="0" /></rect></element>


	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uit1"><text string="S.BOARD"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uit2"><text string="INTERFACE"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib1"><text string="BOARD:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib2">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="RESET"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uib3">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="CLEAR"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uis1"><text string="SPAWN"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih1"><text string="HAND::"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih2">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="REMOVE"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu1"><text string="UNDO:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu2a">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &lt;&lt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2b">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &lt;  "><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2c">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string="   &gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2d">
		<rect><color red="0.81" green="0.8" blue="0.79" /></rect>
		<text string=" &gt;&gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui"><bounds x="0" y="0" width="10" height="80" />
		

		<!-- board -->
		

		<element ref="hlub" inputtag="board:UI" inputmask="0x200"><bounds x="1.8" y="11.7" width="6.3" height="3" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="board:UI" inputmask="0x100"><bounds x="1.8" y="15.3" width="6.3" height="3" /><color alpha="0.25" /></element>

