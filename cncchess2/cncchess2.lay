<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

<element name="conic">
		<image file="cncchess3.png" />
	</element>

<element name="background">
		<image file="../misc/background4.png" />
	</element>   
	
<element name="sbui_png">
		<image file="../misc/clipboard09b.png" />
	</element>
	
	
	<element name="sw" defstate="2">
	<image file="sw.png" state="1"/>
	<image file="sn.png" state="2"/>
	</element>
	
	<element name="sw1" defstate="2">
	<image file="sw.png" state="1"/>
	<image file="sw.png" state="2"/>
	</element>
	
	<element name="sw2" defstate="2">
	<image file="sw.png" state="1"/>
	<image file="sw.png" state="2"/>
	</element>
	
	<element name="switch" defstate="2">
		<image file="sw2.png" state="1"/>
	<image file="sw1.png" state="2"/>
	</element>
	
	
	
	<element name="but_dw" defstate="0">
		<disk state="0"><color red="0.74" green="0.73" blue="0.72" /></disk>
		<disk state="1"><color red="0.59" green="0.58" blue="0.58" /></disk>
	</element>
	
<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>
<element name="led" defstate="0">
		<image file="../leds/red4_sel.png" state="1"/>
	<image file="../leds/red4.png" state="0"/>
</element>

<element name="led1" defstate="0">
		<image file="../leds/red4_sel.png" state="0"/>
	</element>

	<element name="ledg" defstate="1">
		<image file="../leds/green_0.png" state="0"/>
		<image file="../leds/green_1.png" state="1"/>
	</element>



<element name="hlbb" defstate="0">
	</element>




