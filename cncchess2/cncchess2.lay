<!-- build screen -->
<view name="artwork by luis">
<bounds left="-110" right="814" top="0" bottom="1024" />
	
		
	<element ref="background">
			<bounds x="-110" y="0" width="925" height="1024" />
		</element>
	
	<element ref="conic">
			<bounds left="0" right="814" top="0" bottom="1024" />
