		<image file="../piezas/chess2/bq.png" state="11"/>
		<image file="../piezas/chess2/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../piezas/chess2/wp.png" state="13"><color alpha="0.5" /></image>
		<image file="../piezas/chess2/wn.png" state="14"><color alpha="0.5" /></image>
