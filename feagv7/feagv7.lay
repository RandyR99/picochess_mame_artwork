<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="digit_l" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	<element name="digit_led_l" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.1" green="0.01" blue="0.015" /></disk>
	</element>

	<element name="led" defstate="0">
	<image file="../leds/red_1a.png" state="1"/>
	<image file="../leds/red_0.png" state="0"/>
	</element>

<element name="led2" defstate="0">
		<disk state="1"><color red="1.0" green="0.1" blue="0.15" /></disk>
		<disk state="0"><color red="0.1" green="0.01" blue="0.015" /></disk>
	</element>

	<element name="led2_l" defstate="0">
	<image file="../leds/red_0.png" state="0"/>
	<image file="../leds/red_1a.png" state="1"/>

	</element>
	<element name="led2g_l" defstate="0">
	<image file="../leds/green_0.png" state="0"/>
	<image file="../leds/green_1.png" state="1"/>
	</element>

	<element name="led2y_l" defstate="0">
	<image file="../leds/yellow_0.png" state="0"/>
	<image file="../leds/yellow_1.png" state="1"/>
	</element>

	<element name="led3_l" defstate="0">
	<image file="../leds/green_0.png" state="0"/>
	<image file="../leds/green_1.png" state="1"/>
	</element>

	<element name="bt_l" defstate="0">
	<image file="../buttons/button_0.png" state="0"/>
    <image file="../buttons/button_1.png" state="1"/>
	</element>

	<element name="hl_l" defstate="0">
	</element>


<element name="hlbb" defstate="0">
	</element>


<group name="sb_board">
		<bounds x="0" y="0" width="80" height="80" />
		
		
		<!-- leds -->
	<repeat count="8">
			<param name="y" start="8.3" increment="10" />
			<param name="i1" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="8.3" increment="10" />
				<param name="i2" start="8" increment="1" />
				<element name="~i1~.~i2~" ref="led"><bounds x="~x~" y="~y~" width="1.25" height="1.25" /></element>
			</repeat>
		</repeat>
		
		
		
		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

<param name="z" start="-5" increment="10" />
<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece"><bounds x="-2.5"  y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="7.5" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="17.5" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="27.5" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="37.5" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="47.5" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="57.5" y="~z~" width="14.5" height="14.5" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="67.5" y="~z~" width="14.5" height="14.5" /></element>
		</repeat>
	</group>


<group name="sb_board_2m">
		<bounds x="0" y="0" width="80" height="80" />
<!-- leds -->
	<repeat count="8">
			<param name="y" start="8.3" increment="10" />
			<param name="i1" start="7" increment="-1" />

			<repeat count="8">
				<param name="x" start="8.3" increment="10" />
				<param name="i2" start="8" increment="1" />
				<element name="~i1~.~i2~" ref="led"><bounds x="~x~" y="~y~" width="1.25" height="1.25" /></element>
			</repeat>
		</repeat>

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />

			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x01"><bounds x="0"  y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x02"><bounds x="10" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x04"><bounds x="20" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x08"><bounds x="30" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x10"><bounds x="40" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x20"><bounds x="50" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x40"><bounds x="60" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>
			<element ref="hlbb" inputtag="board:RANK.~i~" inputmask="0x80"><bounds x="70" y="~y~" width="10" height="10" /><color alpha="0.04" /></element>

			<element name="piece_a~i~" ref="piece_2m"><bounds x="0.5"  y="~y~" width="9" height="9" /></element>
			<element name="piece_b~i~" ref="piece_2m"><bounds x="10.5" y="~y~" width="9" height="9" /></element>
			<element name="piece_c~i~" ref="piece_2m"><bounds x="20.5" y="~y~" width="9" height="9" /></element>
			<element name="piece_d~i~" ref="piece_2m"><bounds x="30.5" y="~y~" width="9" height="9" /></element>
			<element name="piece_e~i~" ref="piece_2m"><bounds x="40.5" y="~y~" width="9" height="9" /></element>
			<element name="piece_f~i~" ref="piece_2m"><bounds x="50.5" y="~y~" width="9" height="9" /></element>
			<element name="piece_g~i~" ref="piece_2m"><bounds x="60.5" y="~y~" width="9" height="9" /></element>
			<element name="piece_h~i~" ref="piece_2m"><bounds x="70.5" y="~y~" width="9" height="9" /></element>
		</repeat>
	</group>




	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>

	<element name="text_uiu3a" defstate="0">
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui">
