<?xml version="1.0"?>
<!--
license:cc0
-->
<mamelayout version="2">

<!-- note: no chesspieces simulation here -->

<!-- define elements -->

<element name="scisys">
		<image file="mk4f1.png" />
	</element>

<!-- foto: blitzchess -->

	

	<element name="digit" defstate="0">
		<led7seg><color red="1.0" green="0.1" blue="0.15" /></led7seg>
	</element>

	
<element name="lcd_bg" defstate="1">
		<rect state="1"><color red="0.58" green="0.61" blue="0.62" /></rect>
		<rect state="0"><color red="0.40" green="0.42" blue="0.43" /></rect>
	</element>

	<element name="nothing" defstate="0">
		<text string=" "/>
	</element>

<element name="switch" defstate="0">
	  <image file="switch_1c.png" state="0"/>
      <image file="switch_0c.png" state="1"/>
	</element>

	<element name="but" defstate="0">
		
		<rect state="1"><color red="0.0" green="0.0" blue="0.0" /></rect>
	</element>

<element name="but2" defstate="0">
    <image file="down_sel2.png" state="1"/>
	</element>

<element name="but3" defstate="0">
    <image file="down_sel3.png" state="1"/>
	</element>

	<element name="led" defstate="1">
	<image file="../leds/red_sel.png" state="0"/>
	<image file="../leds/red.png" state="1"/>
	</element>




<group name="display">


		<screen index="0" blend="alpha"><bounds x="10" y="4" width="15.8" height="6" /></screen>
		<element ref="nothing" blend="add" inputtag="IN.4" inputmask="0x00" inputraw="1"><bounds x="9" y="3" width="18" height="8" /></element>
		<element ref="lcd_bg" blend="multiply" inputtag="IN.4" inputmask="0x02" inputraw="1"><bounds x="9" y="3" width="18" height="8" /></element>

</group>

<!-- build screen -->

	<view name="artwork by luis">
<bounds left="0" right="1194" top="0" bottom="886" />




<element ref="scisys">
			<bounds x="0" y="0" width="1194" height="886" />
		</element>

<group ref="display"><bounds x="117" y="239" width="192" height="78" /></group>


		

		

		
		
<element ref="but" inputtag="IN.0" inputmask="0x04"><bounds x="357" y="232" width="76" height="90" /><color alpha="0.22" /></element>

<element ref="but" inputtag="IN.1" inputmask="0x04"><bounds x="134" y="501" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.1" inputmask="0x02"><bounds x="215" y="501" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.2" inputmask="0x02"><bounds x="297" y="501" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.3" inputmask="0x02"><bounds x="380" y="501" width="52" height="51" /><color alpha="0.22" /></element>

<element ref="but" inputtag="IN.2" inputmask="0x08"><bounds x="134" y="626" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.3" inputmask="0x08"><bounds x="215" y="626" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.3" inputmask="0x04"><bounds x="297" y="626" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.2" inputmask="0x04"><bounds x="380" y="626" width="52" height="51" /><color alpha="0.22" /></element>

<element ref="switch" inputtag="IN.4" inputmask="0x02"><bounds x="109" y="724" width="78" height="77" /></element>
<element ref="switch" inputtag="IN.4" inputmask="0x01"><bounds x="191" y="724" width="78" height="77" /></element>
<element ref="switch" inputtag="IN.3" inputmask="0x01"><bounds x="273" y="724" width="78" height="77" /></element>

<!-- right side -->
<element ref="but" inputtag="IN.0" inputmask="0x02"><bounds x="544" y="501" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.0" inputmask="0x08"><bounds x="625" y="501" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.1" inputmask="0x08"><bounds x="544" y="626" width="52" height="51" /><color alpha="0.22" /></element>
<element ref="but" inputtag="IN.2" inputmask="0x01"><bounds x="625" y="626" width="52" height="51" /><color alpha="0.22" /></element>




	</view>
</mamelayout>
