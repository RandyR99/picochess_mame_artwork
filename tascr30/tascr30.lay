		<image file="../pieces/chess/bb.png" state="43"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bb.png" state="44"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wb.png" state="45"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wb.png" state="46"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bn.png" state="47"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bn.png" state="48"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wp.png" state="49"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wp.png" state="50"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wp.png" state="51"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wp.png" state="52"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wp.png" state="53"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wp.png" state="54"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wp.png" state="55"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wp.png" state="56"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bp.png" state="57"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bp.png" state="58"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bp.png" state="59"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bp.png" state="60"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bp.png" state="61"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bp.png" state="62"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bp.png" state="63"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bp.png" state="64"><color alpha="0.5" /></image>
	</element>

	<element name="tasc_system" defstate="0">
                <text string="tasc chesssystem r30" state="1"><color red="1" green="1" blue="1" /></text>
                <text string="tasc chesssystem r40" state="2"><color red="1" green="1" blue="1" /></text>
	</element>
	<element name="tasc_module" defstate="0">
                <text string="gideon 2.1" state="1">   <color red="1" green="1" blue="1" /></text>
                <text string="the king 2.20" state="2"><color red="1" green="1" blue="1" /></text>
                <text string="the king 2.23" state="3"><color red="1" green="1" blue="1" /></text>
                <text string="the king 2.50" state="4"><color red="1" green="1" blue="1" /></text>
	</element>

<!-- sb board -->

	<element name="cwhite"><rect><color red="0.84" green="0.75" blue="0.50" /></rect></element>

	<element name="hlbb" defstate="0"></element>

	<group name="sb_board">
		<bounds x="0" y="0" width="82" height="82" />

		<!-- sensors, pieces -->
		<repeat count="8">
			<param name="y" start="0" increment="10" />
			<param name="i" start="8" increment="-1" />
                        <param name="z" start="0" increment="10" />

			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x01"><bounds x="1"  y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x02"><bounds x="11" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x04"><bounds x="21" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x08"><bounds x="31" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x10"><bounds x="41" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x20"><bounds x="51" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x40"><bounds x="61" y="~y~" width="10" height="10" /></element>
			<element ref="hlbb" inputtag="smartboard:board:RANK.~i~" inputmask="0x80"><bounds x="71" y="~y~" width="10" height="10" /></element>

			<element name="piece_a~i~" ref="piece"><bounds x="0"  y="~z~" width="10" height="10" /></element>
			<element name="piece_b~i~" ref="piece"><bounds x="10" y="~z~" width="10" height="10" /></element>
			<element name="piece_c~i~" ref="piece"><bounds x="20" y="~z~" width="10" height="10" /></element>
			<element name="piece_d~i~" ref="piece"><bounds x="30" y="~z~" width="10" height="10" /></element>
			<element name="piece_e~i~" ref="piece"><bounds x="40" y="~z~" width="10" height="10" /></element>
			<element name="piece_f~i~" ref="piece"><bounds x="50" y="~z~" width="10" height="10" /></element>
			<element name="piece_g~i~" ref="piece"><bounds x="60" y="~z~" width="10" height="10" /></element>
			<element name="piece_h~i~" ref="piece"><bounds x="70" y="~z~" width="10" height="10" /></element>
		</repeat>

		<!-- leds -->
		<repeat count="9">
			<param name="x" start="79.9" increment="-10" />
			<param name="i" start="0" increment="1" />

			<element name="led_0~i~" ref="ledr"><bounds x="~x~"    y="0"    width="0.9" height="0.9" /></element>
			<element name="led_1~i~" ref="ledr"><bounds x="~x~"    y="10"   width="0.9" height="0.9" /></element>
			<element name="led_2~i~" ref="ledr"><bounds x="~x~"    y="20"   width="0.9" height="0.9" /></element>
			<element name="led_3~i~" ref="ledr"><bounds x="~x~"    y="30"   width="0.9" height="0.9" /></element>
			<element name="led_4~i~" ref="ledr"><bounds x="~x~"    y="40"   width="0.9" height="0.9" /></element>
			<element name="led_5~i~" ref="ledr"><bounds x="~x~"    y="50"   width="0.9" height="0.9" /></element>
			<element name="led_6~i~" ref="ledr"><bounds x="~x~"    y="60"   width="0.9" height="0.9" /></element>
			<element name="led_7~i~" ref="ledr"><bounds x="~x~"    y="70"   width="0.9" height="0.9" /></element>
			<element name="led_8~i~" ref="ledr"><bounds x="~x~"    y="80.1"   width="0.9" height="0.9" /></element>
		</repeat>
	</group>

<!-- sb ui -->

	<element name="piece_ui" defstate="0">
		<image file="../pieces/chess/wp.png" state="1"/>
		<image file="../pieces/chess/wn.png" state="2"/>
		<image file="../pieces/chess/wb.png" state="3"/>
		<image file="../pieces/chess/wr.png" state="4"/>
		<image file="../pieces/chess/wq.png" state="5"/>
		<image file="../pieces/chess/wk.png" state="6"/>

		<image file="../pieces/chess/bp.png" state="7"/>
		<image file="../pieces/chess/bn.png" state="8"/>
		<image file="../pieces/chess/bb.png" state="9"/>
		<image file="../pieces/chess/br.png" state="10"/>
		<image file="../pieces/chess/bq.png" state="11"/>
		<image file="../pieces/chess/bk.png" state="12"/>

		<!-- selected pieces -->
		<image file="../pieces/chess/wp.png" state="13"></image>
		<image file="../pieces/chess/wn.png" state="14"></image>
		<image file="../pieces/chess/wb.png" state="15"></image>
		<image file="../pieces/chess/wr.png" state="16"></image>
		<image file="../pieces/chess/wq.png" state="17"></image>
		<image file="../pieces/chess/wk.png" state="18"></image>

		<image file="../pieces/chess/bp.png" state="19"></image>
		<image file="../pieces/chess/bn.png" state="20"></image>
		<image file="../pieces/chess/bb.png" state="21"></image>
		<image file="../pieces/chess/br.png" state="22"></image>
		<image file="../pieces/chess/bq.png" state="23"></image>
		<image file="../pieces/chess/bk.png" state="24"></image>
	</element>

	<element name="hlub" defstate="0">
		<rect state="1"><color red="0" green="0" blue="0" /></rect>
	</element>
	<element name="text_uit1"> <rect><color red="0.46" green="0.33" blue="0.12" /></rect> <text string="S.BOARD"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uit2"> <rect><color red="0.46" green="0.33" blue="0.12" /></rect> <text string="INTERFACE"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib1"> <rect><color red="0.46" green="0.33" blue="0.12" /></rect> <text string="BOARD:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uib2">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="RESET"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uib3">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="CLEAR"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uis1"> <rect><color red="0.46" green="0.33" blue="0.12" /></rect><text string="SPAWN"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih1"> <rect><color red="0.46" green="0.33" blue="0.12" /></rect><text string="HAND::"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uih2">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="REMOVE"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu1"> <rect><color red="0.46" green="0.33" blue="0.12" /></rect><text string="UNDO:"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu2a">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &lt;&lt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2b">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &lt;  "><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2c">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string="   &gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu2d">
		<rect><color red="0.84" green="0.75" blue="0.50" /></rect>
		<text string=" &gt;&gt;"><color red="0.01" green="0.01" blue="0.01" /></text>
	</element>
	<element name="text_uiu3a" defstate="0">
		 <rect><color red="0.46" green="0.33" blue="0.12" /></rect>
		<simplecounter maxstate="999" digits="1" align="2">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>
	<element name="text_uiu3b"> <rect><color red="0.46" green="0.33" blue="0.12" /></rect><text string="/"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_uiu3c" defstate="0">
		 <rect><color red="0.46" green="0.33" blue="0.12" /></rect>
		<simplecounter maxstate="999" digits="1" align="1">
			<color red="0.81" green="0.8" blue="0.79" />
		</simplecounter>
	</element>

	<group name="sb_ui">
		<bounds x="0" y="0" width="10" height="80" />
		<element ref="cwhite"><bounds x="0" y="0" width="10" height="1" /></element>
		<element ref="cwhite"><bounds x="0" y="7" width="10" height="1" /></element>
		<element ref="cwhite"><bounds x="0" y="79" width="10" height="1" /></element>
		<element ref="text_uit1"><bounds x="0" y="2" width="10" height="2" /></element>
		<element ref="text_uit2"><bounds x="0" y="4" width="10" height="2" /></element>

		<!-- board -->
		<element ref="text_uib1"><bounds x="0" y="9" width="10" height="2" /></element>
		<element ref="cwhite"><bounds x="1" y="11.5" width="8" height="2.5" /></element>
		<element ref="cwhite"><bounds x="1" y="15" width="8" height="2.5" /></element>

		<element ref="text_uib2"><bounds x="1.5" y="11.75" width="7" height="2" /></element>
		<element ref="text_uib3"><bounds x="1.5" y="15.25" width="7" height="2" /></element>

		<element ref="hlub" inputtag="smartboard:board:UI" inputmask="0x200"><bounds x="1" y="11.5" width="8" height="2.5" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:UI" inputmask="0x100"><bounds x="1" y="15" width="8" height="2.5" /><color alpha="0.25" /></element>

		<!-- spawn -->
		<element ref="text_uis1"><bounds x="0" y="20.5" width="10" height="2" /></element>
		<element ref="cwhite"><bounds x="1" y="23" width="8" height="12" /></element>
		<element ref="cwhite"><bounds x="1" y="36" width="8" height="12" /></element>

		<element name="piece_ui1" ref="piece_ui"><bounds x="1" y="23" width="4" height="4" /></element>
		<element name="piece_ui2" ref="piece_ui"><bounds x="1" y="27" width="4" height="4" /></element>
		<element name="piece_ui3" ref="piece_ui"><bounds x="1" y="31" width="4" height="4" /></element>
		<element name="piece_ui4" ref="piece_ui"><bounds x="5" y="23" width="4" height="4" /></element>
		<element name="piece_ui5" ref="piece_ui"><bounds x="5" y="27" width="4" height="4" /></element>
		<element name="piece_ui6" ref="piece_ui"><bounds x="5" y="31" width="4" height="4" /></element>
		<element name="piece_ui7" ref="piece_ui"><bounds x="1" y="36" width="4" height="4" /></element>
		<element name="piece_ui8" ref="piece_ui"><bounds x="1" y="40" width="4" height="4" /></element>
		<element name="piece_ui9" ref="piece_ui"><bounds x="1" y="44" width="4" height="4" /></element>
		<element name="piece_ui10" ref="piece_ui"><bounds x="5" y="36" width="4" height="4" /></element>
		<element name="piece_ui11" ref="piece_ui"><bounds x="5" y="40" width="4" height="4" /></element>
		<element name="piece_ui12" ref="piece_ui"><bounds x="5" y="44" width="4" height="4" /></element>

		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0001"><bounds x="1" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0002"><bounds x="1" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0004"><bounds x="1" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0008"><bounds x="5" y="23" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0010"><bounds x="5" y="27" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0020"><bounds x="5" y="31" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0040"><bounds x="1" y="36" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0080"><bounds x="1" y="40" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0100"><bounds x="1" y="44" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0200"><bounds x="5" y="36" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0400"><bounds x="5" y="40" width="4" height="4" /><color alpha="0.25" /></element>
		<element ref="hlub" inputtag="smartboard:board:SPAWN" inputmask="0x0800"><bounds x="5" y="44" width="4" height="4" /><color alpha="0.25" /></element>

		<!-- HAND: -->
		<element ref="text_uih1"><bounds x="0" y="51" width="10" height="2" /></element>
		<element ref="cwhite"><bounds x="1" y="53.5" width="8" height="6" /></element>
		<element name="piece_ui0" ref="piece"><bounds x="2" y="53.5" width="6" height="6" /></element>

		<element ref="cwhite"><bounds x="1" y="60.5" width="8" height="2.5" /></element>
		<element ref="text_uih2"><bounds x="1.5" y="60.75" width="7" height="2" /></element>
		<element ref="hlub" inputtag="smartboard:board:UI" inputmask="0x08"><bounds x="1" y="60.5" width="8" height="2.5" /><color alpha="0.25" /></element>

		<!-- undo -->
		<element ref="text_uiu1"><bounds x="0" y="66" width="10" height="2" /></element>
		<element ref="cwhite"><bounds x="1" y="68.5" width="1.7" height="6" /></element>
		<element ref="cwhite"><bounds x="3.1" y="68.5" width="1.7" height="6" /></element>
		<element ref="cwhite"><bounds x="5.2" y="68.5" width="1.7" height="6" /></element>
		<element ref="cwhite"><bounds x="7.3" y="68.5" width="1.7" height="6" /></element>
		<element ref="text_uiu2a"><bounds x="1" y="69.5" width="1.7" height="4" /></element>
		<element ref="text_uiu2b"><bounds x="3.1" y="69.5" width="1.7" height="4" /></element>
