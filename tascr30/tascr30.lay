<?xml version="1.0"?>
<mamelayout version="2">

        <element name="table">
		<image file="table.png" />
	</element>
        <element name="board">
		<image file="board.png" />
	</element>
        <element name="module">
		<image file="module.png" />
	</element>

        <element name="ledr" defstate="0">
                <image file="red_0.png" state="0"/>
                <image file="red_1.png" state="1"/>
        </element>
        <element name="ledg" defstate="0">
                <image file="green_0.png" state="0"/>
                <image file="green_1.png" state="1"/>
	</element>

	<element name="hlb" defstate="0">
                <rect state="0"> <color red="0.1" green="0.1" blue="0.1" /> </rect>
		<rect state="1"> <color red="0.4" green="0.4" blue="0.4" /> </rect> 
	</element>
	<element name="hlbr">
		<disk state="0"> <color red="0.56" green="0.33" blue="0.12" /> </disk>
		<disk state="1"> <color red="0.76" green="0.53" blue="0.32" /> </disk>
	</element>

	<element name="piece" defstate="0">
		<image file="../pieces/chess/wn.png" state="1"/>
		<image file="../pieces/chess/wn.png" state="2"/>
		<image file="../pieces/chess/bk.png" state="3"/>
		<image file="../pieces/chess/wk.png" state="4"/>
		<image file="../pieces/chess/bq.png" state="5"/>
		<image file="../pieces/chess/wq.png" state="6"/>
		<image file="../pieces/chess/br.png" state="7"/>
		<image file="../pieces/chess/br.png" state="8"/>
		<image file="../pieces/chess/wr.png" state="9"/>
		<image file="../pieces/chess/wr.png" state="10"/>
		<image file="../pieces/chess/bb.png" state="11"/>
		<image file="../pieces/chess/bb.png" state="12"/>
		<image file="../pieces/chess/wb.png" state="13"/>
		<image file="../pieces/chess/wb.png" state="14"/>
		<image file="../pieces/chess/bn.png" state="15"/>
		<image file="../pieces/chess/bn.png" state="16"/>
		<image file="../pieces/chess/wp.png" state="17"/>
		<image file="../pieces/chess/wp.png" state="18"/>
		<image file="../pieces/chess/wp.png" state="19"/>
		<image file="../pieces/chess/wp.png" state="20"/>
		<image file="../pieces/chess/wp.png" state="21"/>
		<image file="../pieces/chess/wp.png" state="22"/>
		<image file="../pieces/chess/wp.png" state="23"/>
		<image file="../pieces/chess/wp.png" state="24"/>
		<image file="../pieces/chess/bp.png" state="25"/>
		<image file="../pieces/chess/bp.png" state="26"/>
		<image file="../pieces/chess/bp.png" state="27"/>
		<image file="../pieces/chess/bp.png" state="28"/>
		<image file="../pieces/chess/bp.png" state="29"/>
		<image file="../pieces/chess/bp.png" state="30"/>
		<image file="../pieces/chess/bp.png" state="31"/>
		<image file="../pieces/chess/bp.png" state="32"/>

		<!-- selected pieces -->
		<image file="../pieces/chess/wn.png" state="33"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wn.png" state="34"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bk.png" state="35"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wk.png" state="36"><color alpha="0.5" /></image>
		<image file="../pieces/chess/bq.png" state="37"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wq.png" state="38"><color alpha="0.5" /></image>
		<image file="../pieces/chess/br.png" state="39"><color alpha="0.5" /></image>
		<image file="../pieces/chess/br.png" state="40"><color alpha="0.5" /></image>
		<image file="../pieces/chess/wr.png" state="41"><color alpha="0.5" /></image>
