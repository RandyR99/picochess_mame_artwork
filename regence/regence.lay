		<element ref="text_uiu3b"><bounds x="4" y="71" width="2" height="2" /></element>
	</group>



<!-- build screen -->


<view name="artwork by luis">
<bounds left="-200" right="1700" top="-15" bottom="1700" />

<element ref="fondo">
			<bounds x="-200" y="-15" width="1900" height="1785" />
		</element>


<element ref="regence">
			<bounds x="0" y="0" width="1678" height="1678" />
		</element>

		<group ref="sb_board"><bounds x="211" y="213" width="1257" height="1257" /></group>

          <element ref="sbui_png">
			<bounds x="-190" y="130" width="180" height="1446" /></element>
			
		<group ref="sb_ui"><bounds x="-190" y="130" width="180" height="1446" /></group>

	<!-- chessboard coords -->


	<!-- right side -->

		<element ref="bt" inputtag="IN.0" inputmask="0x01"><bounds x="1504" y="754" width="30" height="30" /></element> <!-- roi -->
		<element ref="bt" inputtag="IN.0" inputmask="0x02"><bounds x="1504" y="805" width="30" height="30" /></element>
		<element ref="bt" inputtag="IN.0" inputmask="0x04"><bounds x="1504" y="856" width="30" height="30" /></element>
		<element ref="bt" inputtag="IN.0" inputmask="0x08"><bounds x="1504" y="907" width="30" height="30" /></element>
