<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->

	<element name="backg"><rect><color red="0.4" green="0.4" blue="0.4" /></rect></element>

	<element name="but_d" defstate="0">
		<disk state="0"><color red="1" green="1" blue="1" /></disk>
		<disk state="1"><color red="0.7" green="0.7" blue="0.7" /></disk>
	</element>

	<element name="but_r" defstate="0">
		<rect state="0"><color red="1" green="1" blue="1" /></rect>
		<rect state="1"><color red="0.7" green="0.7" blue="0.7" /></rect>
	</element>

	<element name="arrow">
		<rect><color red="0.4" green="0.4" blue="0.4" /></rect>
		<text string="Δ"><color red="1" green="1" blue="1" /></text>
	</element>

	<element name="text_1"><rect><color red="0.4" green="0.4" blue="0.4" /></rect><text string="SELECT"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_2"><rect><color red="0.4" green="0.4" blue="0.4" /></rect><text string="START"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_3"><rect><color red="0.4" green="0.4" blue="0.4" /></rect><text string="B / Return"><color red="0.81" green="0.8" blue="0.79" /></text></element>
	<element name="text_4"><rect><color red="0.4" green="0.4" blue="0.4" /></rect><text string="A / Confirm"><color red="0.81" green="0.8" blue="0.79" /></text></element>

<!-- display -->

	<element name="lcd_bg1"><rect><color red="0.4" green="1.0" blue="0.75" /></rect></element>
	<element name="lcd_bg2"><rect><color red="0.58" green="0.61" blue="0.62" /></rect></element>

	<group name="display">
		<bounds x="0" y="0" width="100" height="110" />
		<element ref="lcd_bg1"><bounds x="0" y="" width="100" height="100" /></element>

		<screen index="0" blend="multiply"><bounds x="0" y="0" width="100" height="100" /></screen>
		<element ref="lcd_bg2" blend="multiply"><bounds x="0" y="0" width="100" height="100" /></element>
	</group>

<!-- build screen -->

	<view name="External Layout">
		<bounds left="-1" right="101" top="-1" bottom="151" />
		<group ref="display"><bounds x="0" y="0" width="100" height="110" /></group>
		<element ref="backg"><bounds x="0" y="101" width="100" height="49" /></element>

		<!-- button panel -->
		<element ref="arrow"><bounds x="21.5" y="113" width="5" height="3.5" /></element>
		<element ref="arrow"><bounds x="18" y="116.5" width="3.5" height="5" /><orientation rotate="270" /></element>
		<element ref="arrow"><bounds x="26.5" y="116.5" width="3.5" height="5" /><orientation rotate="90" /></element>
		<element ref="arrow"><bounds x="21.5" y="121.5" width="5" height="3.5" /><orientation rotate="180" /></element>

		<element ref="text_3"><bounds x="58.5" y="111" width="12" height="3" /></element>
		<element ref="text_4"><bounds x="78.5" y="111" width="12" height="3" /></element>

		<element ref="text_1"><bounds x="36" y="136" width="10" height="3" /></element>
		<element ref="text_2"><bounds x="56" y="136" width="10" height="3" /></element>

		<element ref="but_d" inputtag="BUTTONS" inputmask="0x10"><bounds x="20" y="105" width="8" height="8" /><color alpha="0.7" /></element>
		<element ref="but_d" inputtag="BUTTONS" inputmask="0x80"><bounds x="10" y="115" width="8" height="8" /><color alpha="0.7" /></element>
		<element ref="but_d" inputtag="BUTTONS" inputmask="0x20"><bounds x="30" y="115" width="8" height="8" /><color alpha="0.7" /></element>
		<element ref="but_d" inputtag="BUTTONS" inputmask="0x40"><bounds x="20" y="125" width="8" height="8" /><color alpha="0.7" /></element>

		<element ref="but_d" inputtag="BUTTONS" inputmask="0x08"><bounds x="60" y="115" width="9" height="9" /><color alpha="0.7" /></element>
		<element ref="but_d" inputtag="BUTTONS" inputmask="0x04"><bounds x="80" y="115" width="9" height="9" /><color alpha="0.7" /></element>

		<element ref="but_r" inputtag="BUTTONS" inputmask="0x01"><bounds x="36" y="140" width="10" height="2.5" /><color alpha="0.7" /></element>
		<element ref="but_r" inputtag="BUTTONS" inputmask="0x02"><bounds x="56" y="140" width="10" height="2.5" /><color alpha="0.7" /></element>
	</view>

</mamelayout>
