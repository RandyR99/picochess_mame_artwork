<mamelayout version="2">

<!-- define elements -->


<element name="cxg">
		<image file="executive3.png" />
	</element>

	<element name="white"><rect><color red="1" green="1" blue="1" /></rect></element>
	<element name="black"><rect><color red="0.17" green="0.16" blue="0.16" /></rect></element>
	<element name="black2"><rect><color red="0.32" green="0.3" blue="0.3" /></rect></element>

	<element name="butr" defstate="0">
		<rect state="1"><color red="0.6" green="0.21" blue="0.18" /></rect>
	
	</element>
	<element name="butb" defstate="0">
		<rect state="1"><color red="0.25" green="0.24" blue="0.24" /></rect>
		
	</element>

	<element name="hlc" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0.90" green="0.90" blue="0.90" />
		</disk>
	</element>

	

