<?xml version="1.0"?>
<mamelayout version="2">

<!-- define elements -->

	<element name="novag">
		<image file="emerald.png" />
	</element>



<element name="sbui_png">
		<image file="../varios/clipboard09b.png" />
	</element>



	


	<element name="ledr_h" defstate="0">
	<image file="../leds/bled_sel.png" state="1"/>
	<image file="../leds/bled.png" state="0"/>
	</element>

<element name="ledr_v" defstate="0">
	<image file="../leds/bled_v_sel.png" state="1"/>
	<image file="../leds/bled_v.png" state="0"/>
	</element>

	<element name="hl" defstate="0">
	</element>

<element name="but1" defstate="0">
    
    <image file="../botones/down_sel11.png" state="1"/>
	</element>	

<element name="lcdm"><rect><color red="0.647" green="0.671" blue="0.514" /></rect></element>

<!-- sb board -->

	

	<element name="hlbb" defstate="0">
		<text string=" "><bounds x="0" y="0" width="1" height="1" /></text>
		<disk state="1">
			<bounds x="0.12" y="0.12" width="0.76" height="0.76" />
			<color red="0" green="0" blue="0" />
		</disk>
	</element>

<element name="piece" defstate="0">
    <image file="../piezas/pnovag_plastico/wp.png" state="1"/>
    <image file="../piezas/pnovag_plastico/wkn.png" state="2"/>
    <image file="../piezas/pnovag_plastico/wb.png" state="3"/>
    <image file="../piezas/pnovag_plastico/wr.png" state="4"/>
